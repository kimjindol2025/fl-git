(load "./front-fix.fl")
(defn fl-fix-verify-inputs [plan]
  (doseq [input (get plan "inputs")]
    (if (not (= (fl-fix-sha (get input "file")) (get input "sha256")))
      (throw "E_FIX_STALE: source changed during planning") nil))
  (doseq [row (get plan "results")]
    (let [ast (json_parse (file_read (get row "ast")))]
      (if (not (= (fl-fix-sha (get row "stage")) (get row "afterSha256")))
        (throw "E_FIX_STALE: staged source changed after planning") nil)
      (if (not (and (= (str-trim (file_read (str (get row "ast") ".exit"))) "0")
                    (= (get ast "schema") "freelang.ast.v1") (= (get ast "status") "ok")))
        (do (fl_stderr_write (str (json_stringify
              (assoc ast "schema" "fl-fix/1" "parserSchema" (get ast "schema") "status" "error" "file" (get row "file")
                "diagnostics" (map (fn [diagnostic] (assoc diagnostic "file" (get row "file"))) (or (get ast "diagnostics") [])))) "\n"))
            (process-exit 1)) nil)))
  plan)
(defn fl-fix-project-path [project file]
  (if (str-starts-with file (str project "/"))
    (str-slice file (+ (length project) 1) (length file))
    (throw "E_FIX_PATH: input is outside the selected project")))
(defn fl-fix-request [run]
  (let [plan (json_parse (file_read (str run "/verified-plan.json"))) project (get plan "project")]
    (if (not (and (= (get plan "schema") "fl-fix/1") (= (get plan "validation") "NATIVE_PARSE_ONLY")
                  (= (get plan "safe") true) (= (length (get plan "blockers")) 0)))
      (throw "E_FIX_REVIEW: this plan requires manual review before source application") nil)
    (fl-fix-verify-inputs plan)
    (print "fl-file-request/1\x00")
    (doseq [input (get plan "inputs")]
      (print (str "I\x00" (fl-fix-project-path project (get input "file")) "\x00" (get input "sha256") "\x00")))
    (doseq [file (fl-fix-select-values (fn [file] (not (= file ""))) (str-split (file_read (str run "/inputs.nul")) "\x00"))]
      (print (str "L\x00" (fl-fix-project-path project file) "\x00")))
    (doseq [row (get plan "results")]
      (if (not (and (= (get row "sourceFile") (str project "/" (get row "file")))
                    (= (get row "destinationFile") (str project "/" (get row "destination")))
                    (str-starts-with (get row "stage") (str run "/"))))
        (throw "E_FIX_PATH: inconsistent source plan") nil)
      (print (str "W\x00" (get row "file") "\x00" (get row "destination") "\x00"
        (str-slice (get row "stage") (+ (length run) 1) (length (get row "stage"))) "\x00"
        (get row "beforeSha256") "\x00" (get row "afterSha256") "\x00")))
    (print "E\x00")))
(defn fl-fix-finish [run]
  (let [plan (json_parse (file_read (str run "/verified-plan.json")))
        result (json_parse (file_read (str run "/transaction-result.json"))) status (get result "status")
        committed (or (= status "applied") (= status "applied-cleanup-incomplete"))
        uncertain (or (= status "rollback-incomplete")
                      (and (= (get result "intent") "recover") (= status "rejected")))
        valid (and (= (get result "schema") "fl-file-transaction/1")
               (or committed uncertain (= status "rolled-back") (= status "rejected")))
        applied (if committed (get result "files") (if uncertain nil 0))]
    (if (not valid) (throw "E_FIX_RECOVERY: invalid file transaction result; retain artifacts") nil)
    (if (and committed (not (= (get result "files") (length (get plan "results")))))
      (throw "E_FIX_RECOVERY: transaction and source plan disagree; retain artifacts") nil)
    (println (json_stringify (assoc (fl-fix-report plan)
      "dry" false "intent" (get result "intent") "status" status
      "filesChanged" applied "filesApplied" applied "artifactsRetained" true
      "application" (if committed "COMMITTED" (if uncertain "RECOVERY_REQUIRED" (if (= status "rolled-back") "ROLLED_BACK" "REJECTED")))
      "transaction" result)))
    (if (not (= (get result "ok") true)) (process-exit 1) nil)))
(try
  (let [args (cli-args) mode (get args 0)]
    (cond
      [(and (= mode "--plan") (= (length args) 5))
       (let [run (get args 4) plan (fl-fix-plan (get args 1) (get args 2) (str-split (file_read (get args 3)) "\x00") run)]
         (if (not (file_write (str run "/plan.json") (json_stringify plan))) (throw "E_FIX_STAGE: plan write failed") nil)
         (doseq [row (get plan "results")]
           (print (str (get row "stage") "\x00" (get row "ast") "\x00" (get row "sourceFile") "\x00" (get row "destinationFile") "\x00"))))]
      [(and (= mode "--finalize") (or (= (length args) 2) (= (length args) 3)))
       (let [run (get args 1) plan (json_parse (file_read (str run "/plan.json")))
             facts (if (= (length args) 3) (fl-fix-select-values (fn [value] (not (= value ""))) (str-split (file_read (get args 2)) "\x00")) [])
             blockers (reduce (fn [all fact]
               (push all {"code" "filesystem-review"
                 "file" (if (str-starts-with fact (str (get plan "project") "/"))
                          (str-slice fact (+ (length (get plan "project")) 1) (length fact)) fact) "line" 0 "column" 0
                 "message" "A source link, excluded directory or occupied helper destination requires review"})) (get plan "blockers") facts)
             plan (assoc plan "blockers" blockers "safe" (= (length blockers) 0))]
         (fl-fix-verify-inputs plan)
         (let [verified (assoc plan "validation" "NATIVE_PARSE_ONLY")]
           (if (not (file_write (str run "/verified-plan.json") (json_stringify verified)))
             (throw "E_FIX_STAGE: verified plan write failed") nil)
           (println (json_stringify (fl-fix-report verified)))))]
      [(and (= mode "--request") (= (length args) 2)) (fl-fix-request (get args 1))]
      [(and (= mode "--finish") (= (length args) 2)) (fl-fix-finish (get args 1))]
      [true (do (fl_stderr_write "Usage: fl-front-fix --plan <web> <project> <inputs.nul> <private-run> | --finalize <private-run> [facts.nul] | --request <private-run> | --finish <private-run>\n")
                (process-exit 2))]))
  (catch [error]
    (fl_stderr_write (str (json_stringify {"schema" "fl-fix/1" "status" "error" "message" (error-message error)}) "\n"))
    (process-exit 1)))
