; fl-check — AI 전용 페이지 파일 구조 검사기
; 구현 언어: FreeLang. 출력은 JSON 한 줄 진단이며, 종료 표식은 launcher가 처리한다.

(defn text-has? [text needle]
  (> (str-count (str text) (str needle)) 0))

(defn clean-token [value]
  (let [s (str-trim (str value))]
    (str-replace-in (str-replace-in (str-replace-in (str-replace-in (str-replace-in s "[" "") "]" "") "{" "") "}" "") ":" "")))

(defn property-value [line]
  (let [parts (regex_split (str line) "=")]
    (if (> (length parts) 1)
      (str-trim (get parts 1))
      "")))

(defn list-values [value]
  (filter
    (fn [item] (> (length (clean-token item)) 0))
    (map clean-token (regex_split (str value) "[\\[\\],{} ]+"))))

(defn contains-name? [items name]
  (> (length (filter (fn [item] (= (str item) (str name))) (or items []))) 0))

(defn block-name [line]
  (let [parts (filter (fn [item] (> (length item) 0)) (regex_split (str-trim line) " +"))]
    (if (> (length parts) 1)
      (clean-token (get parts 1))
      "")))

(defn new-block [kind name file line]
  {"kind" kind "name" name "file" file "line" line "path" ""
   "params" [] "fields" [] "input_fields" [] "submit" "" "layout" ""
   "design" "" "title" "" "description" "" "protected" "" "price_source" "" "source_count" 1})

(defn route-path [block]
  (str-trim (str (get block "path"))))

(defn admin-path? [path]
  (let [clean (str-replace-in path "\"" "")]
    (or (= clean "/admin")
        (str-starts-with clean "/admin/")
        (= clean "/api/admin")
        (str-starts-with clean "/api/admin/"))))

(defn route-key [path]
  (str path))

(defn add-error [errors file line code what fix]
  (reset! errors
    (concat @errors
      [{"file" file "line" line "code" code "what" what "fix" fix}])))

(defn add-warning [warnings file line code what fix]
  (reset! warnings
    (concat @warnings
      [{"file" file "line" line "code" code "what" what "fix" fix}])))

(defn parse-file [file blocks lines errors]
  (let [source (file_read file)
        source-lines (regex_split source "\n")
        current (atom nil)
        line-no (atom 0)]
    (let [visited
      (map
      (fn [raw]
        (let [n (+ (deref line-no) 1)
              line (str-trim raw)
              kind (cond
                     (regex_match line "^PAGE") "PAGE"
                     (regex_match line "^API") "API"
                     (regex_match line "^COMPONENT") "COMPONENT"
                     (regex_match line "^FORM") "FORM"
                     (regex_match line "^LAYOUT") "LAYOUT"
                     (regex_match line "^DESIGN") "DESIGN"
                     (regex_match line "^BUTTON") "BUTTON"
                     (regex_match line "^ROUTE") "ROUTE"
                     true "")]
          (reset! line-no n)
          (if (> (length kind) 0)
            (do
              (if (not (= @current nil)) (reset! blocks (concat @blocks [@current])))
              (reset! current (new-block kind (block-name line) file n)))
            (if (not (= @current nil))
              (do
                (reset! lines (concat @lines [{"file" file "line_no" n "text" line "block" @current}]))
                (cond
                  (text-has? line "path") (reset! current (assoc @current "path" (property-value line)))
                  (text-has? line "params") (reset! current (assoc @current "params" (list-values (property-value line))))
                  (text-has? line "input") (reset! current (assoc @current "input_fields" (list-values (property-value line))))
                  (text-has? line "fields") (reset! current (assoc @current "fields" (list-values (property-value line))))
                  (text-has? line "layout") (reset! current (assoc @current "layout" (clean-token (property-value line))))
                  (text-has? line "design") (reset! current (assoc @current "design" (clean-token (property-value line))))
                  (text-has? line "title") (reset! current (assoc @current "title" (str-trim (property-value line))))
                  (text-has? line "description") (reset! current (assoc @current "description" (str-trim (property-value line))))
                  (text-has? line "protected") (reset! current (assoc @current "protected" (clean-token (property-value line))))
                  (text-has? line "price_source") (reset! current (assoc @current "price_source" (clean-token (property-value line))))
                  (or (text-has? line "submit") (text-has? line "action")) (reset! current (assoc @current "submit" (clean-token (property-value line))))
                  (text-has? line "sends") (reset! current (assoc @current "params" (list-values (property-value line))))
                  true nil))))))
      source-lines)]
      (length visited))
    (if (not (= @current nil)) (reset! blocks (concat @blocks [@current])))))

(defn api-exists? [blocks name]
  (> (length (filter (fn [block] (and (= (get block "kind") "API") (= (get block "name") name))) @blocks)) 0))

(defn layout-exists? [blocks name]
  (> (length (filter (fn [block] (and (= (get block "kind") "LAYOUT") (= (get block "name") name))) @blocks)) 0))

(defn design-exists? [blocks name]
  (> (length (filter (fn [block] (and (= (get block "kind") "DESIGN") (= (get block "name") name))) @blocks)) 0))

(defn page-or-route-exists? [blocks name]
  (> (length (filter (fn [block]
                       (and (or (= (get block "kind") "PAGE") (= (get block "kind") "ROUTE"))
                            (= (get block "name") name))) @blocks)) 0))

(defn api-for-field [blocks value]
  (first
    (filter
      (fn [block]
        (and (= (get block "kind") "API")
             (text-has? value (str (get block "name") "."))))
      @blocks)))

(defn fields-match? [sent received]
  (and (= (length sent) (length received))
       (= (length (filter (fn [item] (contains-name? received item)) sent)) (length sent))))

(defn rule-name [token]
  (first (regex_split (clean-token token) "[=:]")))

(defn known-rule? [token]
  (contains-name? ["required" "min-length" "max-length" "phone" "numeric" "email"] (rule-name token)))

(defn validate-lines [blocks lines errors]
  (let [visited
    (map
    (fn [item]
      (let [line (get item "text")
            block (get item "block")
            file (get item "file")
            n (or (get item "line_no") (get (get item "block") "line"))]
        (cond
          (text-has? line "links")
            (let [name (first (list-values (property-value line)))]
              (if (and (not (= name nil)) (not (page-or-route-exists? blocks name)))
                (add-error errors file (get block "line") "E_LINK_NOT_FOUND"
                  (str "주소 대상 " name "이 등록되지 않았습니다.")
                  "PAGE 또는 ROUTE를 등록하고 links 대상을 고치세요.")))
          (or (text-has? line "load") (text-has? line "call") (text-has? line "submit"))
            (let [name (clean-token (property-value line))]
              (if (and (> (length name) 0) (not (api-exists? blocks name)))
                (add-error errors file n "E_API_NOT_FOUND"
                  (str "API " name "이 등록되지 않았습니다.")
                  "API 블록을 등록하거나 호출 이름을 고치세요.")))
          (text-has? line "read")
            (if (text-has? line "?")
              (add-error errors file n "E_NULLABLE_FIELD"
                "비어 있을 수 있는 값을 검사 없이 사용했습니다."
                "필수 필드로 선언하거나 fallback/default를 추가하세요."))
          (text-has? line "response-field")
            (let [value (clean-token (property-value line))
                  api (api-for-field blocks value)
                  field-parts (regex_split value "\\.")
                  field (if (> (length field-parts) 0) (get field-parts (- (length field-parts) 1)) "")]
              (if (and (not (= api nil)) (not (contains-name? (get api "fields") field)))
                (add-error errors file n "E_RESPONSE_MISMATCH"
                  (str "API 응답에 " field " 필드가 없습니다.")
                  "API fields 또는 response-field를 같은 계약으로 맞추세요.")))
          (regex_match line "^rule ")
            (let [tokens (list-values (property-value line))
                  bad (filter (fn [token] (not (known-rule? token))) tokens)]
              (if (> (length bad) 0)
                (add-error errors file n "E_UNKNOWN_INPUT_RULE"
                  (str "알 수 없는 입력 규칙 " (first bad) "을 사용했습니다.")
                  "required, min-length, max-length, phone, numeric, email 중 하나를 사용하세요.")))
          true nil)))
    @lines)]
    (length visited)))

(defn validate-blocks [blocks lines errors warnings]
  (let [checked
    (map
    (fn [block]
      (let [kind (get block "kind")
            name (get block "name")
            file (get block "file")
            line (get block "line")
            path (route-path block)
            params (get block "params")]
        (cond
          (and (= kind "FORM") (= (get block "submit") ""))
            (add-error errors file line "E_FORM_CONTRACT"
              "FORM에 submit API가 없습니다."
              "FORM의 submit을 등록된 API 이름으로 지정하세요.")
          (and (= kind "FORM") (api-exists? blocks (get block "submit")))
            (let [api (first (filter (fn [item]
                                       (and (= (get item "kind") "API")
                                            (= (get item "name") (get block "submit")))) @blocks))]
              (if (not (fields-match? (get block "fields") (get api "input_fields")))
                (add-error errors file line "E_FORM_INPUT_MISMATCH"
                  "FORM 필드와 API input 계약이 다릅니다."
                  "FORM fields와 API input을 같은 이름으로 맞추세요.")))
          (and (or (= kind "PAGE") (= kind "ROUTE"))
               (not (= (get block "layout") ""))
               (not (layout-exists? blocks (get block "layout"))))
            (add-error errors file line "E_LAYOUT_NOT_FOUND"
              (str "LAYOUT " (get block "layout") "이 등록되지 않았습니다.")
              "등록된 LAYOUT 이름을 사용하세요.")
          (and (= kind "LAYOUT") (not (= (get block "design") ""))
               (not (design-exists? blocks (get block "design"))))
            (add-error errors file line "E_DESIGN_TOKEN_NOT_FOUND"
              (str "디자인 값 " (get block "design") "이 선언되지 않았습니다.")
              "DESIGN 블록을 선언하거나 정확한 이름을 사용하세요.")
          (and (= kind "API") (admin-path? path)
               (not (= (get block "protected") "true")))
            (add-error errors file line "E_ADMIN_ROUTE_UNPROTECTED"
              "관리자 API에 보호 표시가 없습니다."
              "protected = true를 추가하세요.")
          (and (= kind "API") (= (str-replace-in path "\"" "") "/api/order")
               (or (contains-name? (get block "input_fields") "price")
                   (not (= (get block "price_source") "products"))))
            (add-error errors file line "E_PRICE_FROM_CLIENT"
              "주문 API 가격 기준이 상품 저장소로 선언되지 않았거나 입력에 가격이 포함되어 있습니다."
              "상품 ID와 수량만 받고 price_source = products로 선언하세요.")
          (and (or (= kind "PAGE") (= kind "ROUTE")) (admin-path? path)
               (not (= (get block "protected") "true")))
            (add-error errors file line "E_ADMIN_ROUTE_UNPROTECTED"
              "관리자 경로에 보호 표시가 없습니다."
              "protected = true를 추가하세요.")
          (and (or (= kind "PAGE") (= kind "ROUTE")) (text-has? path "["))
            (let [raw (if (text-has? path "[id]") "id" (if (text-has? path "[slug]") "slug" ""))]
              (if (and (> (length raw) 0) (not (contains-name? params raw)))
                (add-error errors file line "E_PARAM_MISMATCH"
                  (str "주소 변수 " raw "과 params 선언이 다릅니다.")
                  "path의 [변수]와 params 이름을 같게 선언하세요.")))
          (and (or (= kind "PAGE") (= kind "ROUTE"))
               (= (get block "title") ""))
            (add-warning warnings file line "W_META_MISSING"
              "검색용 title이 선언되지 않았습니다."
              "페이지에 title을 추가하세요.")
          (and (or (= kind "PAGE") (= kind "ROUTE"))
               (= (get block "description") ""))
            (add-warning warnings file line "W_META_MISSING"
              "검색용 description이 선언되지 않았습니다."
              "페이지에 description을 추가하세요.")
          (and (= kind "BUTTON") (not (api-exists? blocks (get block "submit"))))
            (add-error errors file line "E_BUTTON_API_NOT_FOUND"
              (str "BUTTON이 호출하는 API " (get block "submit") "이 등록되지 않았습니다.")
              "등록된 API 이름을 action에 지정하세요.")
          (and (= kind "BUTTON") (api-exists? blocks (get block "submit")))
            (let [api (first (filter (fn [item]
                                       (and (= (get item "kind") "API")
                                            (= (get item "name") (get block "submit")))) @blocks))]
              (if (not (fields-match? (get block "params") (get api "input_fields")))
                (add-error errors file line "E_BUTTON_INPUT_MISMATCH"
                  "BUTTON이 보내는 값과 API input 계약이 다릅니다."
                  "sends와 API input 필드를 같은 이름으로 맞추세요.")))
          (and (or (= kind "PAGE") (= kind "ROUTE")) (text-has? path "["))
            (let [raw (if (text-has? path "[id]") "id" (if (text-has? path "[slug]") "slug" ""))]
              (if (and (not (= raw nil)) (not (contains-name? params raw)))
                (add-error errors file line "E_PARAM_MISMATCH"
                  (str "주소 변수 " raw "과 params 선언이 다릅니다.")
                  "path의 [변수]와 params 이름을 같게 선언하세요.")))
          true nil)))
    @blocks)]
    (length checked))
  (let [checked
    (map
      (fn [left]
        (let [path (route-path left)
              kind (get left "kind")
              occurrences (if (> (length path) 0)
                           (str-count (file_read (get left "file")) path)
                           0)]
          (if (and (> (length path) 0)
                   (or (= kind "PAGE") (= kind "ROUTE"))
                   (> occurrences 1))
            (add-error errors (get left "file") (get left "line") "E_DUPLICATE_ROUTE"
              (str "주소 " path "가 중복 등록되었습니다.")
              "주소를 하나만 남기거나 다른 path를 사용하세요."))))
      @blocks)]
    (length checked))
  (let [checked
    (map
    (fn [component]
      (let [name (get component "name")
            used (> (length (filter (fn [item]
                                      (or (text-has? (get item "text") (str "uses = [" name))
                                          (text-has? (get item "text") (str "render = " name))))
                                    @lines)) 0)]
        (if (not used)
          (add-error errors (get component "file") (get component "line") "E_UNUSED_COMPONENT"
            (str "COMPONENT " name "이 어떤 페이지에서도 사용되지 않았습니다.")
            "PAGE의 uses 또는 render에 이 컴포넌트를 연결하세요."))))
    (filter (fn [block] (= (get block "kind") "COMPONENT")) @blocks))]
    (length checked)))

(let [target (or (shell_env "FL_CHECK_TARGET") "pages")
      files (if (file_is_file target)
              (let [site-path (str-replace target "/products/[id].flp" "/site.flp")]
                (if (file_exists site-path)
                  [target site-path]
                  [target]))
              (let [top (map (fn [name] (str target "/" name))
                             (filter (fn [name] (and (regex_match name "\\.flp$") (file_is_file (str target "/" name))))
                                     (dir_list target)))
                    detail (if (file_exists (str target "/products/[id].flp")) [(str target "/products/[id].flp")] [])
                    admin-products (if (file_exists (str target "/admin/products.flp")) [(str target "/admin/products.flp")] [])
                    admin-orders (if (file_exists (str target "/admin/orders.flp")) [(str target "/admin/orders.flp")] [])]
                (concat (concat (concat (concat top detail) admin-products) admin-orders))))
      blocks (atom [])
      lines (atom [])
      errors (atom [])
      warnings (atom [])]
  (map (fn [file] (parse-file file blocks lines errors)) files)
  (validate-lines blocks lines errors)
  (validate-blocks blocks lines errors warnings)
  (map (fn [warning] (println (json_stringify warning))) @warnings)
  (map (fn [error] (println (json_stringify error))) @errors)
  (println (str "FL_CHECK_EXIT=" (if (> (length @errors) 0) "1" "0"))))
