; flp-compile — .flp 계약을 FreeLang 실행 라우트로 직접 컴파일한다.
; HTML 문자열을 JS/TS로 만들지 않는다. 이 파일이 유일한 컴파일러 구현이다.

(defn has? [text needle]
  (not (= (str-index-of (str text) (str needle)) -1)))

(defn field-value [line key]
  (if (= key "name")
    (let [parts (regex_split line "name=\"")]
      (if (> (length parts) 1)
        (first (regex_split (get parts 1) "\""))
        ""))
    (let [tokens (regex_split (str-trim line) " +")
          token (first (filter (fn [item] (regex_match item (str "^" key "="))) tokens))]
      (str-replace-in
        (str-replace-in
          (str-replace-in (str token) (str key "=") "") "\"" "")
        "'" ""))))

(defn product-record [line]
  {"id" (field-value line "id")
   "name" (field-value line "name")
   "price" (field-value line "price")
   "description" (field-value line "description")
   "photo" (field-value line "photo")})

(defn product-lines [source]
  (filter (fn [line] (regex_match (str-trim line) "^PRODUCT"))
          (regex_split source "\n")))

(defn product-card [product]
  (str "<article class=\"product-card\"><img src=\"" (fl-product-photo product)
       "\" alt=\"" (fl-product-html-escape (get product "name"))
       " 상품 사진\" style=\"width:100%;aspect-ratio:8/5;object-fit:cover;border-radius:10px\"><h2><a href=\"/products/"
       (fl-product-html-escape (get product "id")) "\">" (fl-product-html-escape (get product "name"))
       "</a></h2><p>" (fl-product-html-escape (get product "price")) "원</p><p>"
       (fl-product-html-escape (get product "description")) "</p></article>"))

(defn generated-list-source [products]
  (str "; generated from .flp — do not edit\n"
       "(defn fl-render-product-card [product]\n  (str \"<article class='product-card'><img src='\" (fl-product-photo product) \"' alt='\" (fl-product-html-escape (get product \"name\")) \" 상품 사진' style='width:100%;aspect-ratio:8/5;object-fit:cover;border-radius:10px'><h2><a href='/products/\" (fl-product-html-escape (get product \"id\")) \"'>\" (fl-product-html-escape (get product \"name\")) \"</a></h2><p>\" (fl-product-html-escape (get product \"price\")) \"원</p><p>\" (fl-product-html-escape (get product \"description\")) \"</p></article>\"))\n"
       "(defn render [req]\n  (server_html (fl-layout \"상품 목록\" \"프리랭 상점의 상품 목록과 온라인 주문 상품을 확인하세요.\" (str \"<h1>상품 목록</h1>\" (str-join (map fl-render-product-card (fl-products-load)) \"\")))))\n"))

(defn generated-detail-source []
  (str "; generated from .flp — do not edit\n"
       "(defn render [req]\n  (let [id (server_req_param req \"id\")\n        product (fl-cart-product id)]\n    (if (= product nil)\n      (server_status 404 {\"error\" \"상품을 찾을 수 없습니다.\"})\n      (server_html (str \"<!doctype html><html lang='ko'><head><meta charset='utf-8'><title>\" (get product \"name\") \"</title><style>body{font-family:system-ui;max-width:720px;margin:40px auto;padding:0 20px}.product{border:1px solid #ddd;border-radius:12px;padding:24px}</style></head><body><main class='product'><p><a href='/products'>상품 목록</a> · <a href='/cart'>장바구니</a></p><h1>\" (get product \"name\") \"</h1><p>상품 번호: \" id \"</p><strong>\" (get product \"price\") \"원</strong><div id='cart-island-slot' data-product-id='\" id \"'>\" \"ISLAND_PLACEHOLDER_0\" \"</div>\" \"ISLAND_SCRIPTS\" \"</main></body></html>\")))))\n"
       "(island CartButton []\n  (let [count (atom 0)\n        add (fn []\n              (let [slot (.getElementById document \"cart-island-slot\")\n                    id (.getAttribute slot \"data-product-id\")]\n                (fetch-post! \"/api/cart/add\" {\"id\" id \"quantity\" 1}\n                  (fn [res]\n                    (let [data (get res \"data\")]\n                      (reset! count (get data \"count\")))))))]\n    (h \"section\" {}\n      (h \"p\" {} (str \"장바구니 개수: \" @count))\n      (h \"button\" {\"id\" \"cart-add\" :on-click add} \"담기\"))))\n"))

(defn generated-detail-source-v2 []
  (str "; generated from .flp — do not edit\n"
       "(defn render [req]\n  (let [id (server_req_param req \"id\")\n        product (fl-cart-product id)]\n    (if (= product nil)\n      (server_status 404 {\"error\" \"상품을 찾을 수 없습니다.\"})\n      (server_html (fl-layout (fl-product-html-escape (get product \"name\")) \"상품 상세 정보와 온라인 주문 안내를 확인하세요.\" (str \"<div class='product'><img src='\" (fl-product-photo product) \"' alt='\" (fl-product-html-escape (get product \"name\")) \" 상품 사진' style='width:100%;max-width:800px;aspect-ratio:8/5;object-fit:cover;border-radius:10px'><p>상품 번호: \" (fl-product-html-escape id) \"</p><h1>\" (fl-product-html-escape (get product \"name\")) \"</h1><p>\" (fl-product-html-escape (get product \"description\")) \"</p><strong>\" (fl-product-html-escape (get product \"price\")) \"원</strong><div id='cart-island-slot' data-product-id='\" (fl-product-html-escape id) \"'>\" \"ISLAND_PLACEHOLDER_0\" \"</div>\" \"ISLAND_SCRIPTS\" \"</div>\"))))))\n"
       "(island CartButton []\n  (let [count (atom 0)\n        add (fn []\n              (let [slot (.getElementById document \"cart-island-slot\")\n                    id (.getAttribute slot \"data-product-id\")]\n                (fetch-post! \"/api/cart/add\" {\"id\" id \"quantity\" 1}\n                  (fn [res]\n                    (let [data (get res \"data\")]\n                      (reset! count (get data \"count\")))))))]\n    (h \"section\" {}\n      (h \"p\" {} (str \"장바구니 개수: \" @count))\n      (h \"button\" {\"id\" \"cart-add\" :on-click add} \"담기\"))))\n"))

(defn generated-cart-source []
  (str "; generated from .flp — do not edit\n"
       "(defn render [req]\n  (server_html (fl-layout \"장바구니\" \"담은 상품과 온라인 주문 합계를 확인하세요.\" (str \"<h1>장바구니</h1>\" \"ISLAND_PLACEHOLDER_0\" \"\" \"ISLAND_SCRIPTS\"))))\n"
       "(island CartPage []\n  (let [items (atom [])\n        total (atom 0)\n        loaded (atom false)\n        load (fn []\n               (if (= @loaded false)\n                 (do (reset! loaded true)\n                     (fetch! \"/api/cart\"\n                       (fn [res]\n                         (reset! items (or (get res \"items\") []))\n                         (reset! total (or (get res \"total\") 0)))))\n                 nil))]\n    (load)\n    (h \"section\" {}\n      (h \"div\" {\"id\" \"cart-items\"}\n        (if (= (length @items) 0)\n          (h \"p\" {} \"장바구니가 비어 있습니다.\")\n          (map (fn [item] (h \"article\" {\"class\" \"cart-row\"}\n                              (str (get item \"name\") \" · \" (get item \"quantity\") \"개 · \" (get item \"line_total\") \"원\"))) @items)))\n      (h \"h2\" {} (str \"합계: \" @total \"원\")))))\n"))

(defn generated-checkout-source []
  (str "; generated from .flp — do not edit\n"
       "(defn render [req]\n  (let [cart (fl-cart-summary)]\n    (if (= (length (get cart \"items\")) 0)\n      (server_redirect \"/cart\")\n      (server_html (fl-layout \"주문서\" \"장바구니 상품을 확인하고 온라인 주문 정보를 입력하세요.\" (str \"<div class='order'><h1>주문서</h1><p>주문 금액: \" (get cart \"total\") \"원</p>\" \"ISLAND_PLACEHOLDER_0\" \"\" \"ISLAND_SCRIPTS\" \"</div>\")))))\n"
       "(island OrderForm []\n  (let [items (atom [])\n        loaded (atom false)\n        submit-error (atom \"\")\n        load (fn []\n               (if (= @loaded false)\n                 (do\n                   (reset! loaded true)\n                   (fetch! \"/api/cart\" (fn [res] (reset! items (map (fn [item] {\"id\" (get item \"id\") \"quantity\" (get item \"quantity\")}) (or (get res \"items\") []))))))\n                 nil))\n        recipient-error (atom \"\")\n        phone-error (atom \"\")\n        address-error (atom \"\")\n        note-error (atom \"\")\n        submit (fn []\n                 (let [recipient (.-value (.getElementById document \"recipient\"))\n                       phone (.-value (.getElementById document \"phone\"))\n                       address (.-value (.getElementById document \"address\"))\n                       note (.-value (.getElementById document \"note\"))]\n                   (do\n                     (reset! recipient-error (if (= recipient \"\") \"받는 사람은 필수입니다.\" (if (or (< (length recipient) 2) (> (length recipient) 50)) \"받는 사람은 2~50자여야 합니다.\" \"\")))\n                     (reset! phone-error (if (or (= phone \"\") (not (.test (RegExp \"^01[0-9]-?[0-9]{3,4}-?[0-9]{4}$\") phone))) \"전화번호 형식이 아닙니다.\" \"\"))\n                     (reset! address-error (if (= address \"\") \"주소는 필수입니다.\" (if (or (< (length address) 5) (> (length address) 200)) \"주소는 5~200자여야 합니다.\" \"\")))\n                     (reset! note-error (if (> (length note) 200) \"요청사항은 200자 이하입니다.\" \"\"))\n                     (if (and (= @recipient-error \"\") (= @phone-error \"\") (= @address-error \"\") (= @note-error \"\"))\n                       (fetch-result! \"POST\" \"/api/order\" {\"items\" @items \"recipient\" recipient \"phone\" phone \"address\" address \"note\" note}\n                         (fn [result]\n                           (let [data (get result \"data\")\n                                 errors (get data \"errors\")\n                                 first-error (first errors)]\n                             (if (= (get result \"ok\") true)\n                               (.assign (.-location window) (str \"/order/done?order_id=\" (get data \"order_id\")))\n                               (reset! submit-error (or (get first-error \"message\") (get data \"error\") \"주문을 처리하지 못했습니다.\"))))))\n                       nil)))))]\n    (load)\n    (h \"section\" {}\n      (h \"label\" {} \"받는 사람\")\n      (h \"input\" {\"id\" \"recipient\" \"placeholder\" \"테스트 주문자\"})\n      (if (= @recipient-error \"\") \"\" (h \"p\" {\"class\" \"error\"} @recipient-error))\n      (h \"label\" {} \"전화번호\")\n      (h \"input\" {\"id\" \"phone\" \"placeholder\" \"010-0000-0000\"})\n      (if (= @phone-error \"\") \"\" (h \"p\" {\"class\" \"error\"} @phone-error))\n      (h \"label\" {} \"주소\")\n      (h \"input\" {\"id\" \"address\" \"placeholder\" \"테스트 주소 1\"})\n      (if (= @address-error \"\") \"\" (h \"p\" {\"class\" \"error\"} @address-error))\n      (h \"label\" {} \"요청사항\")\n      (h \"textarea\" {\"id\" \"note\" \"placeholder\" \"요청사항\"})\n      (if (= @note-error \"\") \"\" (h \"p\" {\"class\" \"error\"} @note-error))\n      (if (= @submit-error \"\") \"\" (h \"p\" {\"class\" \"error\" \"id\" \"order-submit-error\" \"role\" \"status\"} @submit-error))\n      (h \"button\" {\"id\" \"order-submit\" :on-click submit} \"주문하기\"))))\n"))

(let [source-dir (or (env-get "FLP_SOURCE_DIR") "web/pages")
      list-file (str source-dir "/products.flp")
      detail-file (str source-dir "/products/[id].flp")
      cart-file (str source-dir "/cart.flp")
      checkout-file (str source-dir "/checkout.flp")
      admin-file (str source-dir "/admin/products.flp")
      list-output (str source-dir "/products.flx")
      detail-output (str source-dir "/products/[id].flx")
      cart-output (str source-dir "/cart.flx")
      checkout-output (str source-dir "/checkout.flx")
      output (or (env-get "FLP_OUTPUT") (str source-dir "/_flp-generated.flx"))]
  (if (and (file_exists list-file) (file_exists detail-file) (file_exists cart-file) (file_exists checkout-file))
    (let [list-source (file_read list-file)
          detail-source (file_read detail-file)
          cart-source (file_read cart-file)
          checkout-source (file_read checkout-file)
          admin-source (file_read admin-file)
          products (map product-record (product-lines list-source))]
      (if (and (= (length products) 3)
               (has? list-source "PAGE ProductListPage")
               (has? detail-source "PAGE ProductDetailPage")
               (has? detail-source "path = \"/products/[id]\"")
               (has? cart-source "PAGE CartPage")
               (has? checkout-source "PAGE CheckoutPage")
               (has? checkout-source "FORM OrderForm")
               (has? admin-source "PAGE AdminProductsPage")
               (has? admin-source "path = \"/admin/products\"")
               (has? admin-source "protected = true")
               (has? admin-source "path = \"/api/admin/product\"")
               (has? admin-source "path = \"/api/admin/product/:id\""))
                 (if (and (file_write list-output (generated-list-source products))
                 (file_write detail-output
                             (str-replace-in (generated-detail-source-v2)
                                             "__PRODUCT_ID__" ""))
                 (file_write cart-output (generated-cart-source))
                 (file_write checkout-output
                             (str-replace-in
                               (str-replace-in
                                 (str-replace-in (generated-checkout-source)
                                                 "nil)))))]"
                                                 "nil))))]")
                                 "주문하기\"))))"
                                 "주문하기\")))))")
                               "(and (= @recipient-error \"\") (= @phone-error \"\") (= @address-error \"\") (= @note-error \"\"))"
                               "(and (>= (length recipient) 2) (<= (length recipient) 50) (.test (RegExp \"^01[0-9]-?[0-9]{3,4}-?[0-9]{4}$\") phone) (>= (length address) 5) (<= (length address) 200) (<= (length note) 200))"))
                 true)
          (do (file_delete output)
          (println "FLP_COMPILE_EXIT=0")
          )
          (println "FLP_COMPILE_EXIT=1"))
        (do (file_delete output) (println "FLP_COMPILE_EXIT=1"))))
    (do (file_delete output) (println "FLP_COMPILE_EXIT=1"))))
