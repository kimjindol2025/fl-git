#!/usr/bin/env bash
# Literal process/file boundary. DSL, DOM, options and result policy are FreeLang.
set -Eeuo pipefail
native_memory_limit="$(ulimit -v)"
if [[ "$native_memory_limit" == unlimited ]] || [[ "$native_memory_limit" -gt 2097152 ]]; then ulimit -v 2097152; fi
ulimit -c 0
blocked() { printf 'FL_ISLAND_HEADLESS=BLOCKED\nCAUSE=%s\n' "$1" >&2; exit 2; }
COMPILER="${FREELANG_NATIVE_COMPILER:-}"
TOOL="${FREELANG_NATIVE_HEADLESS_TOOL:-}"
ENGINE="${FREELANG_NATIVE_JS_ENGINE:-}"
MOZJS="${FREELANG_NATIVE_MOZJS_LIBRARY:-}"
GJS="${FREELANG_NATIVE_GJS_LIBRARY:-}"
SUPPORT="${FREELANG_NATIVE_HEADLESS_SUPPORT:-}"
[[ -x "$COMPILER" && -x "$TOOL" && -x "$ENGINE" ]] || blocked 'Select the matching Native compiler, headless tool and JavaScript engine.'
[[ -f "$MOZJS" && -f "$GJS" && -f "$SUPPORT" ]] || blocked 'Select the matching engine pair and FreeLang headless runtime.'
SOURCE=""
for argument in "$@"; do
  if [[ "$argument" != --* ]]; then SOURCE="$argument"; break; fi
done
[[ -n "$SOURCE" && -f "$SOURCE" ]] || blocked 'Usage: fl-island-run-native file.flx [--island=Name] [--click=selector] [--dispatch=key:value] [--store=JSON]'
IFS= read -r -d '' SOURCE < <(realpath -e -z -- "$SOURCE") || blocked 'Cannot resolve the selected source file.'
ARTIFACTS="${FREELANG_NATIVE_HEADLESS_ARTIFACTS:-${TMPDIR:-/tmp}}"
[[ -d "$ARTIFACTS" ]] || blocked 'The diagnostic output directory must exist.'
RUN="$(mktemp -d -- "$ARTIFACTS/fl-headless.XXXXXX")"
child=''
forward() {
  local signal="$1" status="$2"
  trap '' INT TERM
  if [[ -n "$child" ]]; then kill -s "$signal" "$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true; fi
  exit "$status"
}
trap 'forward INT 130' INT
trap 'forward TERM 143' TERM
run_child() {
  "$@" & child=$!
  local status=0
  wait "$child" || status=$?
  child=''
  return "$status"
}
failed() {
  local status="$1"
  for diagnostic in "$RUN"/*.stderr "$RUN"/lower.stdout "$RUN"/parse.stdout; do
    if [[ -s "$diagnostic" ]]; then cat -- "$diagnostic" >&2; fi
  done
  if [[ "$step" == PARSE && -s "$RUN/ast.json" ]]; then cat -- "$RUN/ast.json" >&2; fi
  printf 'FL_ISLAND_HEADLESS=FAIL\n' >&2
  exit "$status"
}
step=OPTIONS
run_child timeout --foreground 3s "$TOOL" options "$RUN/options.json" "$@" >"$RUN/options.stdout" 2>"$RUN/options.stderr" || failed "$?"
step=EXTRACT
run_child timeout --foreground 3s "$TOOL" extract "$SOURCE" "$RUN/islands.fl" >"$RUN/extract.stdout" 2>"$RUN/extract.stderr" || failed "$?"
step=PARSE
run_child timeout --foreground 15s "$COMPILER" --parse-json "$RUN/islands.fl" >"$RUN/ast.json" 2>"$RUN/parse.stderr" || failed "$?"
step=LOWER
run_child timeout --foreground 3s "$TOOL" emit "$RUN/ast.json" "$SUPPORT" "$SOURCE" "$RUN/runtime.fl" >"$RUN/lower.stdout" 2>"$RUN/lower.stderr" || failed "$?"
printf '(front-native-island-headless-main)\n' >"$RUN/program.fl"
step=GENERATE
run_child timeout --foreground 15s "$COMPILER" --browser-runtime-js "$RUN/runtime.fl" "$RUN/program.fl" "$RUN/program.js" >"$RUN/generate.stdout" 2>"$RUN/generate.stderr" || failed "$?"
step=ENGINE
run_child timeout --foreground 3s "$ENGINE" "$MOZJS" "$GJS" "$RUN/program.js" -- "$(cat -- "$RUN/options.json")" >"$RUN/result.json" 2>"$RUN/engine.stderr" || failed "$?"
cat -- "$RUN/result.json"
run_child timeout --foreground 3s "$TOOL" status "$RUN/result.json"
