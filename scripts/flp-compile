#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
SOURCE_DIR="${1:-$ROOT/web/pages}"

"$ROOT/scripts/fl-check" "$SOURCE_DIR"
"$ROOT/scripts/fl-check" "$SOURCE_DIR/products/[id].flp"
exec "$ROOT/scripts/flp-compile-native" "$SOURCE_DIR"
