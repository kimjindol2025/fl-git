#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-$ROOT/web/pages}"
NATIVE_TOOL="${FREELANG_NATIVE_FLCHECK:-}"

if [[ -z "$NATIVE_TOOL" || ! -f "$NATIVE_TOOL" || ! -x "$NATIVE_TOOL" ]]; then
  echo "FL_CHECK_NATIVE=BLOCKED" >&2
  echo "CAUSE=Set FREELANG_NATIVE_FLCHECK to the verified Native fl-check executable." >&2
  exit 2
fi

status=0
output="$(FL_CHECK_ROOT="$ROOT" FL_CHECK_TARGET="$TARGET" "$NATIVE_TOOL")" || status=$?
if [[ "$status" -eq 0 ]]; then
  marker_count=0
  marker=""
  invalid_marker=0
  while IFS= read -r line; do
    [[ "$line" == FL_CHECK_EXIT=* ]] || continue
    marker_count=$((marker_count + 1))
    if [[ "$line" =~ ^FL_CHECK_EXIT=[01]$ ]]; then
      marker="${line#FL_CHECK_EXIT=}"
    else
      invalid_marker=1
    fi
  done <<< "$output"
  if [[ "$marker_count" -ne 1 || "$invalid_marker" -ne 0 ]]; then
    echo "FL_CHECK_NATIVE=BLOCKED" >&2
    echo "CAUSE=Native fl-check must return exactly one FL_CHECK_EXIT=0/1 marker." >&2
    exit 2
  fi
  status="$marker"
fi
printf '%s\n' "$output" | grep -v '^FL_CHECK_EXIT=' || true
exit "$status"
