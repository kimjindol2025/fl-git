#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
SOURCE_DIR="${1:-$ROOT/web/pages}"
NATIVE_TOOL="${FREELANG_NATIVE_FLP_TOOL:-}"

if [[ -z "$NATIVE_TOOL" || ! -x "$NATIVE_TOOL" ]]; then
  echo "FLP_NATIVE_COMPILE=BLOCKED"
  echo "CAUSE=Set FREELANG_NATIVE_FLP_TOOL to the verified Native flp-compile executable." >&2
  exit 2
fi
if [[ ! -d "$SOURCE_DIR" ]]; then
  echo "FLP_NATIVE_COMPILE=BLOCKED"
  echo "CAUSE=Source directory does not exist." >&2
  exit 2
fi
SOURCE_DIR="$(cd -- "$SOURCE_DIR" && pwd -P)"
output="$(FLP_SOURCE_DIR="$SOURCE_DIR" FLP_OUTPUT="$SOURCE_DIR/_flp-generated.flx" "$NATIVE_TOOL")"
status=0
if printf '%s\n' "$output" | grep -q '^FLP_COMPILE_EXIT=1$'; then status=1; fi
printf '%s\n' "$output" | grep -v '^FLP_COMPILE_EXIT=' || true
if [[ "$status" -eq 0 ]]; then echo "FLP_NATIVE_COMPILE=PASS"; else echo "FLP_NATIVE_COMPILE=FAIL"; fi
exit "$status"
