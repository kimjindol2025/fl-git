; FE-9 주문 파일 저장소. data/orders.json은 로컬 런타임 자료이며 커밋하지 않는다.
(defn fl-orders-path []
  (str (or (env-get "FL_GIT_REPO") ".") "/data/orders.json"))

(defn fl-orders-load []
  (let [pending (fl-shop-pending)]
    (if (not (= pending nil)) (get pending "orders")
      (if (not (file_exists (fl-orders-path))) []
        (let [parsed (json_parse (file_read (fl-orders-path)))]
          (if (not (fl-shop-orders-valid parsed)) (throw "SHOP_ORDERS_INVALID") parsed))))))

(defn fl-orders-save [orders]
  (if (not (fl-shop-orders-valid orders)) (throw "SHOP_ORDERS_SAVE_INVALID"))
  (fl-shop-write-json (fl-orders-path) orders))

(defn fl-orders-find [id]
  (let [orders (fl-orders-load)]
    (if (= orders nil)
      nil
      (first (filter (fn [order] (= (str (get order "order_id")) (str id))) orders)))))

(defn fl-orders-list-view [orders]
  (map (fn [order]
         {"order_id" (get order "order_id")
          "created_at" (get order "created_at")
          "recipient" (get order "recipient")
          "total" (get order "total")
          "status" (get order "status")})
       orders))
