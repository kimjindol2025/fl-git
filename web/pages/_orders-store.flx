; FE-9 주문 파일 저장소. data/orders.json은 로컬 런타임 자료이며 커밋하지 않는다.
(defn fl-orders-path []
  (str (or (shell_env "FL_GIT_REPO") ".") "/data/orders.json"))

(defn fl-orders-load []
  (let [path (fl-orders-path)]
    (if (not (file_exists path))
      []
      (let [raw (file_read path)]
        (if (or (= raw nil) (= (str-trim raw) ""))
          []
          (json_parse raw))))))

(defn fl-orders-save [orders]
  (file_write (fl-orders-path) (json_stringify orders)))

(defn fl-orders-find [id]
  (let [orders (fl-orders-load)]
    (if (= orders nil)
      nil
      (first (filter (fn [order] (= (str (get order "order_id")) (str id))) orders)))))

(defn fl-orders-list-view [orders]
  (map (fn [order]
         {"order_id" (get order "order_id")
          "created_at" (get order "created_at")
          "recipient" (get order "recipient")
          "total" (get order "total")
          "status" (get order "status")})
       orders))
