; FE-5 장바구니 API — 프로세스 메모리만 사용한다.
(define fl-cart-state (atom {}))

(defn fl-cart-product [id]
  (fl-products-find id))

(defn fl-cart-quantity [id]
  (or (get @fl-cart-state (str id)) 0))

(defn fl-cart-row [product]
  (let [id (get product "id")
        quantity (fl-cart-quantity id)]
    (assoc product "quantity" quantity
           "line_total" (* (get product "price") quantity))))

(defn fl-cart-summary []
  (let [rows (filter (fn [row] (> (get row "quantity") 0))
                     (map fl-cart-row (fl-products-load)))
        total (reduce (fn [sum row] (+ sum (get row "line_total"))) 0 rows)
        count (reduce (fn [sum row] (+ sum (get row "quantity"))) 0 rows)]
    {"items" rows "count" count "total" total}))

(defn fl-cart-get [req]
  (server_json (fl-cart-summary)))

(defn fl-cart-add [req]
  (let [body (server_req_json req)
        id (get body "id")
        quantity (get body "quantity")
        product (fl-cart-product id)
        numeric (and (number? quantity) (integer? quantity) (> quantity 0))]
    (cond
      (= product nil) (server_status 404 {"error" "상품을 찾을 수 없습니다."})
      (not numeric) (server_status 400 {"error" "quantity는 1 이상의 숫자여야 합니다."})
      true (do
        (reset! fl-cart-state
                (assoc @fl-cart-state (str id) (+ (fl-cart-quantity id) quantity)))
        (server_json (fl-cart-summary))))))

(server-get "/api/cart" "fl-cart-get")
(server-post "/api/cart/add" "fl-cart-add")
