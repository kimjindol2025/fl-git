PAGE CartPage {
  path = "/cart"
  layout = StoreLayout
  title = "장바구니"
  description = "담은 상품과 주문 합계"
  load = Cart.get
  render = CartScreen
}

API Cart.get {
  method = GET
  path = "/api/cart"
  response = CartResult
  fields = [items count total]
}

COMPONENT CartScreen {
  uses = [CartRow]
  render = CartView
}

COMPONENT CartRow {
  props = { id: ID, name: String, quantity: Int, line_total: Money }
  render = CartRowView
}
