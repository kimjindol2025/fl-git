; FE-6 주문 API — FORM OrderForm의 규칙을 서버에서도 적용한다.
(define fl-order-state (atom {}))

(defn fl-order-text [body key]
  (str-trim (str (or (get body key) ""))))

(defn fl-order-errors [body]
  (let [recipient (fl-order-text body "recipient")
        phone (fl-order-text body "phone")
        address (fl-order-text body "address")
        note (fl-order-text body "note")]
    (concat
      (concat
        (if (= recipient "") [{"field" "recipient" "message" "받는 사람은 필수입니다."}]
          (if (or (< (length recipient) 2) (> (length recipient) 50))
            [{"field" "recipient" "message" "받는 사람은 2~50자여야 합니다."}] []))
        (if (= phone "") [{"field" "phone" "message" "전화번호는 필수입니다."}]
          (if (not (regex_match phone "^01[0-9]-?[0-9]{3,4}-?[0-9]{4}$"))
            [{"field" "phone" "message" "전화번호 형식이 아닙니다."}] [])))
      (concat
        (if (= address "") [{"field" "address" "message" "주소는 필수입니다."}]
          (if (or (< (length address) 5) (> (length address) 200))
            [{"field" "address" "message" "주소는 5~200자여야 합니다."}] []))
        (if (> (length note) 200)
          [{"field" "note" "message" "요청사항은 200자 이하입니다."}] [])))))

(defn fl-order-create [req]
  (let [body (server_req_json req)
        errors (fl-order-errors body)
        cart (fl-cart-summary)]
    (cond
      (= (length (get cart "items")) 0)
        (server_status 400 {"errors" [{"field" "cart" "message" "장바구니가 비어 있습니다."}]})
      (> (length errors) 0)
        (server_status 400 {"errors" errors})
      true (let [order-id (str (now_ms))
                 order {"order_id" order-id
                        "recipient" (fl-order-text body "recipient")
                        "phone" (fl-order-text body "phone")
                        "address" (fl-order-text body "address")
                        "note" (fl-order-text body "note")
                        "items" (get cart "items")
                        "total" (get cart "total")}]
             (reset! fl-order-state (assoc @fl-order-state order-id order))
             (server_json {"order_id" order-id "total" (get cart "total")})))))

(defn fl-order-get [req]
  (let [id (server_req_param req "id")
        order (get @fl-order-state (str id))]
    (if (= order nil)
      (server_status 404 {"error" "주문을 찾을 수 없습니다."})
      (server_html (str "<!doctype html><html lang='ko'><head><meta charset='utf-8'><title>주문 완료</title><style>body{font-family:system-ui;max-width:720px;margin:40px auto;padding:0 20px}.done{border:1px solid #ddd;border-radius:12px;padding:24px}</style></head><body><main class='done'><p><a href='/products'>상품 목록</a></p><h1>주문이 완료되었습니다</h1><p>주문번호: " (get order "order_id") "</p><p>받는 사람: " (get order "recipient") "</p><strong>결제 예정 금액: " (get order "total") "원</strong></main></body></html>")))))

(defn fl-order-get-v2 [req]
  (let [id (server_req_param req "id")
        order (get @fl-order-state (str id))]
    (if (= order nil)
      (server_status 404 {"error" "주문을 찾을 수 없습니다."})
      (server_html (fl-layout "주문 완료" "주문이 정상적으로 접수되었습니다." (str "<div class='done'><h1>주문이 완료되었습니다</h1><p>주문번호: " (get order "order_id") "</p><p>받는 사람: " (get order "recipient") "</p><strong>결제 예정 금액: " (get order "total") "원</strong></div>"))))))

(server-post "/api/order" "fl-order-create")
(server-get "/order/:id" "fl-order-get-v2")
