; FE-9 주문 처리. 클라이언트는 상품 ID와 수량만 보낸다.
(defn fl-order-text [body key]
  (str-trim (str (or (get body key) "")))
)

(defn fl-order-errors [body]
  (let [recipient (fl-order-text body "recipient")
        phone (fl-order-text body "phone")
        address (fl-order-text body "address")
        note (fl-order-text body "note")]
    (concat
      (concat
        (if (= recipient "") [{"field" "recipient" "message" "받는 사람은 필수입니다."}]
          (if (or (< (length recipient) 2) (> (length recipient) 50))
            [{"field" "recipient" "message" "받는 사람은 2~50자여야 합니다."}] []))
        (if (= phone "") [{"field" "phone" "message" "전화번호는 필수입니다."}]
          (if (not (regex_match phone "^01[0-9]-?[0-9]{3,4}-?[0-9]{4}$"))
            [{"field" "phone" "message" "전화번호 형식이 아닙니다."}] [])))
      (concat
        (if (= address "") [{"field" "address" "message" "주소는 필수입니다."}]
          (if (or (< (length address) 5) (> (length address) 200))
            [{"field" "address" "message" "주소는 5~200자여야 합니다."}] []))
        (if (> (length note) 200)
          [{"field" "note" "message" "요청사항은 200자 이하입니다."}] [])))))

(defn fl-order-prepare-items [raw-items products]
  (reduce
    (fn [state raw]
      (let [id (str-trim (str (or (get raw "id") "")))
            quantity (get raw "quantity")
            product (first (filter (fn [item] (= (str (get item "id")) id)) products))
            prior (get state "items")
            seen (> (length (filter (fn [item] (= (str (get item "id")) id)) prior)) 0)
            error (cond
                    (= id "") {"field" "items" "message" "상품 ID가 필요합니다."}
                    (= product nil) {"field" "items" "message" "없는 상품이 포함되어 있습니다."}
                    (or (not (number? quantity)) (not (integer? quantity)) (<= quantity 0))
                      {"field" "items" "message" "수량은 1 이상의 정수여야 합니다."}
                    seen {"field" "items" "message" "같은 상품은 한 항목으로 보내야 합니다."}
                    (> quantity (get product "stock")) {"field" "items" "message" "재고보다 많은 수량입니다."}
                    true nil)]
        (if (= error nil)
          (assoc state
            "items" (concat prior
              [{"id" id
                "name" (get product "name")
                "quantity" quantity
                "unit_price" (get product "price")
                "line_total" (* quantity (get product "price"))}]))
          (assoc state "errors" (concat (get state "errors") [error])))))
    {"items" [] "errors" []}
    raw-items))

(defn fl-order-reduce-stock [products items]
  (map
    (fn [product]
      (let [line (first (filter (fn [item] (= (str (get item "id")) (str (get product "id")))) items))]
        (if (= line nil)
          product
          (assoc product "stock" (- (get product "stock") (get line "quantity"))))))
    products))

(defn fl-order-total [items]
  (reduce (fn [sum item] (+ sum (get item "line_total"))) 0 items))

(defn fl-order-create [req]
  (let [body (server_req_json req)
        raw-items (or (get body "items") [])
        products (fl-products-load)
        orders (fl-orders-load)
        prepared (fl-order-prepare-items raw-items products)
        items (get prepared "items")
        errors (concat (fl-order-errors body)
                 (if (= (length raw-items) 0)
                   [{"field" "items" "message" "주문 상품이 필요합니다."}]
                   (get prepared "errors")))
        order-id (str "ORD-" (now_ms) "-" (length (or orders [])))
        total (fl-order-total items)
        order {"order_id" order-id
               "created_at" (now_iso)
               "recipient" (fl-order-text body "recipient")
               "phone" (fl-order-text body "phone")
               "address" (fl-order-text body "address")
               "note" (fl-order-text body "note")
               "items" items
               "total" total
               "status" "접수"}
        next-products (fl-order-reduce-stock products items)]
    (if (= orders nil)
      (server_status 500 {"error" "주문 자료를 읽지 못했습니다."})
      (if (> (length errors) 0)
      (server_status 400 {"errors" errors})
      (if (not (fl-products-save next-products))
        (server_status 500 {"error" "재고를 저장하지 못했습니다."})
        (if (fl-orders-save (concat orders [order]))
          (do
            (reset! fl-cart-state {})
            (server_json {"order_id" order-id "total" total}))
          (do
            (fl-products-save products)
            (fl-orders-save orders)
            (server_status 500 {"error" "주문을 저장하지 못했습니다."}))))))))

(defn fl-order-done [req]
  (let [id (server_req_query req "order_id")
        order (fl-orders-find id)]
    (if (= order nil)
      (server_status 404 {"error" "주문을 찾을 수 없습니다."})
      (server_html
        (fl-layout "주문 완료" "주문이 정상적으로 접수되었습니다."
          (str "<section class='done'><h1>주문이 완료되었습니다</h1><p>주문번호: "
               (fl-product-html-escape (get order "order_id"))
               "</p><strong>주문 금액: " (get order "total") "원</strong></section>"))))))

(defn fl-order-get [req]
  (let [id (server_req_param req "id")
        order (fl-orders-find id)]
    (if (= order nil)
      (server_status 404 {"error" "주문을 찾을 수 없습니다."})
      (server_redirect (str "/order/done?order_id=" id)))))

(defn fl-admin-orders-list [req]
  (let [orders (fl-orders-load)]
    (cond
      (not (fl-admin-authorized req)) (server_status 401 {"error" "관리자 인증이 필요합니다."})
      (= orders nil) (server_status 500 {"error" "주문 자료를 읽지 못했습니다."})
      true (server_json {"orders" (fl-orders-list-view orders)}))))

(defn fl-order-next-status [status]
  (cond
    (= status "접수") "준비중"
    (= status "준비중") "발송"
    (= status "발송") "완료"
    true nil))

(defn fl-admin-order-update [req]
  (let [body (server_req_json req)
        id (server_req_param req "id")
        status (get body "status")
        orders (fl-orders-load)
        order (if (= orders nil) nil (first (filter (fn [item] (= (str (get item "order_id")) (str id))) orders)))]
    (cond
      (not (fl-admin-authorized req))
        (server_status 401 {"error" "관리자 인증이 필요합니다."})
      (= orders nil)
        (server_status 500 {"error" "주문 자료를 읽지 못했습니다."})
      (= order nil)
        (server_status 404 {"error" "주문을 찾을 수 없습니다."})
      (not (= status (fl-order-next-status (get order "status"))))
        (server_status 400 {"error" "주문 상태는 다음 단계로만 변경할 수 있습니다."})
      true
        (let [updated (assoc order "status" status)
              next-orders (map (fn [item]
                                 (if (= (str (get item "order_id")) (str id)) updated item)) orders)]
          (if (fl-orders-save next-orders)
            (server_json {"order_id" id "status" status})
            (server_status 500 {"error" "주문 상태를 저장하지 못했습니다."}))))))

(server-post "/api/order" "fl-order-create")
(server-get "/order/done" "fl-order-done")
(server-get "/api/admin/orders" "fl-admin-orders-list")
(server-put "/api/admin/order/:id" "fl-admin-order-update")
(server-get "/order/:id" "fl-order-get")
