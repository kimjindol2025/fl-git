; pages/_auth.flx — 쿠키 세션 인증 헬퍼
; 데모 계정: admin / admin123

(define COOKIE_NAME "fl_session")
(define DEMO_USER "admin")
(define DEMO_PASS "admin123")

; 쿠키에서 세션 ID 읽기
(defn auth-session-id [req]
  (server-req-cookie req COOKIE_NAME))

; 세션 유효성 검사 → username 또는 nil
(defn auth-check [req]
  (let [sid (auth-session-id req)]
    (if sid
      (let [rows (db-query DB "SELECT username FROM sessions WHERE id = ?" [sid])]
        (if (> (length rows) 0)
          (get (first rows) "username")
          nil))
      nil)))

; 로그인 → 세션 생성 + 쿠키 문자열 반환 (실패 시 nil)
(defn auth-login [username password]
  (if (and (= username DEMO_USER) (= password DEMO_PASS))
    (let [sid (uuid)]
      (db-exec DB "INSERT INTO sessions (id, username) VALUES (?, ?)" [sid username])
      (server-set-cookie COOKIE_NAME sid {:max_age 86400 :secure false}))
    nil))

; 로그아웃 → 세션 삭제 + 만료 쿠키 문자열 반환
(defn auth-logout [req]
  (let [sid (auth-session-id req)]
    (if sid
      (db-exec DB "DELETE FROM sessions WHERE id = ?" [sid])
      nil)
    (server-set-cookie COOKIE_NAME "" {:max_age 0 :secure false})))

; 인증 필요 라우트 가드 — 미인증 시 /login redirect
(defn auth-required [req handler]
  (let [user (auth-check req)]
    (if user
      (handler user)
      (server-redirect "/login"))))
