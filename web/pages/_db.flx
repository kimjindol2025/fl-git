; pages/_db.flx — SQLite DB 연결 헬퍼
; DB 설정 — data/app.db
(define DB {:type "sqlite" :path "data/app.db"})

; 마이그레이션 — 서버 시작 시 자동 실행
(defn db-migrate []
  (db-exec DB "CREATE TABLE IF NOT EXISTS sessions (
    id TEXT PRIMARY KEY,
    username TEXT NOT NULL,
    created_at TEXT DEFAULT (datetime('now'))
  )")
  (db-exec DB "CREATE TABLE IF NOT EXISTS stats (
    id INTEGER PRIMARY KEY,
    users INTEGER DEFAULT 0,
    revenue INTEGER DEFAULT 0,
    orders INTEGER DEFAULT 0,
    updated_at TEXT DEFAULT (datetime('now'))
  )")
  (db-exec DB "CREATE TABLE IF NOT EXISTS monthly_stats (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    label TEXT NOT NULL,
    value INTEGER NOT NULL,
    created_at TEXT DEFAULT (datetime('now'))
  )")
  ; 초기 데이터 없으면 삽입
  (let [existing (db-query DB "SELECT id FROM stats LIMIT 1" [])]
    (if (= (length existing) 0)
      (do
        (db-exec DB "INSERT INTO stats (id, users, revenue, orders) VALUES (1, 1247, 23450000, 892)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('1월', 1200)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('2월', 1800)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('3월', 2100)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('4월', 1700)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('5월', 2400)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('6월', 2800)" []))
      nil)))

; DB에서 대시보드 통계 조회
(defn db-fetch-stats []
  (let [rows    (db-query DB "SELECT * FROM stats WHERE id = 1" [])
        monthly (db-query DB "SELECT label, value FROM monthly_stats ORDER BY id" [])
        weekly  [{:label "월" :value 320}
                 {:label "화" :value 410}
                 {:label "수" :value 290}
                 {:label "목" :value 500}
                 {:label "금" :value 460}
                 {:label "토" :value 230}
                 {:label "일" :value 180}]]
    (if (= (length rows) 0)
      {:users 0 :revenue 0 :orders 0 :monthly [] :weekly weekly}
      (let [row (first rows)]
        {:users   (get row "users")
         :revenue (get row "revenue")
         :orders  (get row "orders")
          ; SQLite string key → keyword key 변환 (chart-bar 호환)
         :monthly (map (fn [r] {:label (get r "label") :value (get r "value")}) monthly)
         :weekly  weekly}))))

; 마이그레이션 즉시 실행
(db-migrate)
