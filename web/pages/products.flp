PAGE ProductListPage {
  path = "/products"
  load = Products.list
  render = ProductListScreen
  links = [ProductDetailPage]
}

API Products.list {
  method = GET
  path = "/api/products"
  response = ProductListResult
  fields = [id name price]
}

ROUTE ProductDetailPage {
  path = "/products/[id]"
  params = { id: ID }
}

COMPONENT ProductCard {
  props = { id: ID, name: String, price: Money }
  render = ProductCardView
}

COMPONENT ProductListScreen {
  uses = [ProductCard]
  render = ProductListView
}

DATA ProductCatalog {
  PRODUCT id=1 name="AI 노트" price="19000"
  PRODUCT id=2 name="FreeLang 키트" price="29000"
  PRODUCT id=3 name="Codex 플래너" price="39000"
}
