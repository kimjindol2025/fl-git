; AdminOrdersPage contract: admin/orders.flp
(defn render [req]
  (fl-admin-run req (fn []
    (server_html
    (fl-layout req "관리자 주문 관리" "관리자 주문 조회와 처리 상태 변경"
      (str "<form id=\"admin-session-logout\" method=\"post\" action=\"/api/admin/logout\"><button>관리자 로그아웃</button></form><style>.order-grid{display:grid;gap:12px}.order-row{display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr auto;gap:12px;align-items:center}.order-row span{overflow-wrap:anywhere}.order-error{color:#b42318}@media(max-width:700px){.order-row{grid-template-columns:1fr 1fr}.order-row button{grid-column:1/-1}}</style><h1>주문 관리</h1><p>주문 상태를 접수부터 다음 단계로 처리합니다.</p><div id='admin-orders-root'>"
           "ISLAND_PLACEHOLDER_0" "</div>" "ISLAND_SCRIPTS"))))))
