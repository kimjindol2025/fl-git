PAGE ProductDetailPage {
  path = "/products/[id]"
  layout = StoreLayout
  title = "상품 상세"
  description = "프리랭 상점 상품 상세"
  params = { id: ID }
  load = Products.detail
  render = ProductDetailScreen
}

API Products.detail {
  method = GET
  path = "/api/products/:id"
  response = ProductDetailResult
  fields = [id name price]
}

API Cart.add {
  method = POST
  path = "/api/cart/add"
  input = [id quantity]
  response = CartResult
  fields = [count total]
}

BUTTON AddToCartButton {
  action = Cart.add
  sends = [id quantity]
  success = [cart-count cart-total]
}

COMPONENT ProductDetailScreen {
  props = { id: ID, name: String, price: Money }
  render = ProductDetailView
}
