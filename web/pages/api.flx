; fl-git 웹 API — 선택된 Git 저장소에서만 명령을 실행한다.

(define fl-git-repo (atom (or (fl-env-get "FL_GIT_REPO") "/home/kim/kim/projects/fl-git")))
(define fl-git-roots (or (fl-env-get "FL_GIT_ROOTS") "/home/kim/kim/projects"))

(defn api-shell-quote [value]
  (str "'" (str-replace-in (str value) "'" "'\\''") "'"))

(defn api-run-at [repo command]
  (shell_capture (str "cd " (api-shell-quote repo) " && " command)))

(defn api-run [command]
  (api-run-at (deref fl-git-repo) command))

(defn api-out [result]
  (str-trim (or (get result "stdout") "")))

(defn api-code [result]
  (or (get result "code") -1))

(defn api-resolve-directory [path]
  (let [candidate (str-trim (str path))]
    (if (= candidate "")
      ""
      (let [result (api-run-at candidate "pwd -P")]
        (if (= (api-code result) 0) (api-out result) "")))))

(defn api-command [command]
  (let [result (api-run command)]
    {"stdout" (or (get result "stdout") "")
     "stderr" (or (get result "stderr") "")
     "code" (api-code result)}))

(defn api-status-files []
  (let [result (api-run "git status --short --untracked-files=all | sed -E 's/^(.{2}) (.*)$/\\1\\t\\2/'")
        rows (filter (fn [row] (> (length (str-trim row)) 0)) (regex_split (api-out result) "\\n"))]
    (map (fn [row]
           (let [parts (regex_split row "\\t")
                 status (or (get parts 0) "")
                 path (or (get parts 1) "")
                 kind (if (= status "??") "untracked"
                        (if (or (str-includes status "A") (str-includes status "C")) "added"
                          (if (str-includes status "D") "deleted" "modified")))]
             {"kind" kind "status" status "path" path}))
         rows)))

(defn api-safe-git-path [path]
  (let [clean (str-trim (str path))]
    (and (> (length clean) 0)
         (not (str-starts-with clean "/"))
         (not (str-includes clean ".."))
         (not (str-includes clean "\\\\")))))

(defn api-file-command [action paths]
  (let [safe (filter api-safe-git-path (or paths []))]
    (if (or (= (length safe) 0) (not (= (length safe) (length (or paths [])))))
      {"code" 2 "stderr" "안전하지 않은 파일 경로가 포함되어 있습니다."}
      (api-command (str "git " action " -- " (str-join (map api-shell-quote safe) " "))))))

(defn api-commit-selected [message paths]
  (let [clean-message (str-trim (str message))
        safe (filter api-safe-git-path (or paths []))]
    (if (= clean-message "")
      {"code" 2 "stderr" "커밋 메시지가 필요합니다."}
      (if (or (= (length safe) 0) (not (= (length safe) (length (or paths [])))))
        {"code" 2 "stderr" "선택 파일이 없거나 안전하지 않은 파일 경로가 포함되어 있습니다."}
        (let [stage (api-file-command "add" safe)]
          (if (not (= (api-code stage) 0))
            stage
            (api-command (str "git commit --only -m " (api-shell-quote clean-message) " -- " (str-join (map api-shell-quote safe) " ")))))))))

(defn api-root-allowed [root]
  (let [candidate (api-resolve-directory root)
        configured (filter (fn [allowed] (> (length (str-trim allowed)) 0)) (regex_split fl-git-roots ":"))]
    (and (> (length candidate) 0)
         (> (length configured) 0)
         (= (length (filter (fn [allowed] (= (str-trim allowed) "*")) configured)) 0)
         (> (length
              (filter
                (fn [allowed]
                  (let [base (api-resolve-directory allowed)]
                    (and (> (length base) 0)
                         (or (= candidate base) (str-starts-with candidate (str base "/"))))))
                configured))
            0))))

(defn api-select-repo [requested]
  (let [path (api-resolve-directory requested)
        result (api-run-at path "git rev-parse --show-toplevel")
        root (api-resolve-directory (api-out result))]
    (if (= path "")
      {"ok" false "error" "선택한 폴더를 읽을 수 없습니다."}
      (if (not (= (api-code result) 0))
        {"ok" false "error" "선택한 폴더가 Git 저장소가 아닙니다."}
        (if (not (api-root-allowed root))
          {"ok" false "error" "허용된 물리 경로 밖의 저장소입니다. FL_GIT_ROOTS를 확인하세요."}
          (do (reset! fl-git-repo root) {"ok" true "root" root}))))))

(defn api-list-folders [requested]
  (let [candidate (str-trim (str (or requested "")))
        base (if (= candidate "") (first (regex_split fl-git-roots ":")) candidate)
        root (api-resolve-directory base)]
    (if (= root "")
      {"ok" false "error" "폴더를 읽을 수 없습니다."}
      (if (not (api-root-allowed root))
        {"ok" false "error" "허용되지 않은 물리 경로입니다. FL_GIT_ROOTS를 확인하세요."}
        (let [entries (api-run-at root "find . -mindepth 1 -maxdepth 1 -type d -printf '%f\\n' | sort")
              names (filter (fn [name] (> (length (str-trim name)) 0)) (regex_split (api-out entries) "\\n"))]
          {"ok" true "root" root
           "folders" (map (fn [name] (str root "/" (str-trim name))) names)})))))

(defn api-repo-paths [base names]
  (map (fn [name] (str-replace-in (str base "/" (str-replace-in (str-trim name) "./" "") "/") "/.git/" "")) names))

(defn api-list-repos []
  (let [roots (filter (fn [root] (> (length (str-trim root)) 0)) (regex_split fl-git-roots ":"))
        repos (reduce
                (fn [acc root]
                  (let [base (api-resolve-directory root)
                        result (if (and (> (length base) 0) (api-root-allowed base))
                                 (api-run-at base "find . -type d -name .git -prune -print | sort")
                                 {"code" 1 "stdout" ""})
                        names (filter (fn [name] (> (length (str-trim name)) 0)) (regex_split (api-out result) "\\n"))]
                    (concat acc (api-repo-paths base names))))
                [] roots)]
    (if (= (length (filter (fn [root] (= (str-trim root) "*")) roots)) 0)
      {"ok" true "roots" roots "repositories" repos}
      {"ok" false "error" "FL_GIT_ROOTS에 *를 사용할 수 없습니다."})))

(defn api-create-repo [parent name]
  (let [base (str-trim (str parent))
        repo-name (str-trim (str name))
        resolved (api-run-at base "pwd -P")
        root (api-out resolved)
        target (str root "/" repo-name)]
    (if (= repo-name "")
      {"ok" false "error" "새 저장소 이름을 입력하세요."}
      (if (or (= repo-name ".") (= repo-name "..") (str-includes repo-name "/"))
        {"ok" false "error" "저장소 이름에는 경로 구분자를 사용할 수 없습니다."}
        (if (not (= (api-code resolved) 0))
          {"ok" false "error" "상위 폴더를 읽을 수 없습니다."}
          (if (not (api-root-allowed root))
            {"ok" false "error" (str "허용된 폴더 밖입니다. 허용 범위: " fl-git-roots)}
            (let [created (api-run-at root (str "mkdir -p -- " (api-shell-quote repo-name) " && git init -q -- " (api-shell-quote repo-name)))]
              (if (= (api-code created) 0)
                (do (reset! fl-git-repo target) {"ok" true "root" target})
                {"ok" false "error" (or (get created "stderr") "저장소를 만들 수 없습니다.")}))))))))

(defn api-gitignore-content [template]
  (cond
    (= template "node") "node_modules/\n.env\n"
    (= template "next") "node_modules/\n.next/\n.env\n"
    (= template "python") "__pycache__/\n.venv/\n.env\n"
    ""))

(defn api-project-setup [parent name github-name visibility readme gitignore-template initial-push]
  (let [base (str-trim (str parent))
        project-name (str-trim (str name))
        gh-name (str-trim (str (or github-name "")))
        template (str-trim (str (or gitignore-template "none")))
        resolved (api-run-at base "pwd -P")
        root (api-out resolved)
        target (str root "/" project-name)
        visibility-flag (if (= visibility "public") "--public" "--private")
        readme-content (str "# " project-name "\n\n")
        gitignore-content (api-gitignore-content template)
        has-seed (or (= readme true) (> (length gitignore-content) 0))]
    (if (or (= project-name "") (= project-name ".") (= project-name "..") (str-includes project-name "/"))
      {"ok" false "error" "프로젝트 이름을 확인하세요. 경로 구분자는 사용할 수 없습니다."}
      (if (or (str-starts-with gh-name "-") (str-includes gh-name " "))
        {"ok" false "error" "GitHub 저장소 이름을 확인하세요."}
      (if (not (= (api-code resolved) 0))
        {"ok" false "error" "상위 폴더를 읽을 수 없습니다."}
        (if (not (api-root-allowed root))
          {"ok" false "error" (str "허용된 폴더 밖입니다. 허용 범위: " fl-git-roots)}
          (let [created (api-run-at root (str "test ! -e " (api-shell-quote project-name) " && mkdir -p -- " (api-shell-quote project-name) " && git init -q -- " (api-shell-quote project-name)))]
            (if (not (= (api-code created) 0))
              {"ok" false "error" "프로젝트 폴더가 이미 존재하거나 생성할 수 없습니다."}
              (let [branch-set (api-run-at target "git branch -M main")
                    readme-write (if (= readme true) (api-run-at target (str "printf %s " (api-shell-quote readme-content) " > README.md")) {"code" 0})
                    gitignore-write (if (> (length gitignore-content) 0) (api-run-at target (str "printf %s " (api-shell-quote gitignore-content) " > .gitignore")) {"code" 0})
                    linked (if (= gh-name "")
                             {"code" 0}
                             (if (str-starts-with gh-name "https://github.com/")
                               (api-run-at target (str "git remote add origin " (api-shell-quote gh-name)))
                               (api-run-at root (str "gh repo create " (api-shell-quote gh-name) " " visibility-flag " --source " (api-shell-quote target) " --remote origin"))))
                    committed (if (= has-seed true) (api-run-at target "git add -- . && git commit -m 'chore: initialize project'") {"code" 0})
                    pushed (if (and (= initial-push true) (not (= gh-name "")) (= has-seed true)) (api-run-at target "git push -u origin main") {"code" 0})]
                (if (or (not (= (api-code branch-set) 0)) (not (= (api-code readme-write) 0)) (not (= (api-code gitignore-write) 0)))
                  {"ok" false "error" "프로젝트 초기 파일을 만들지 못했습니다."}
                  (if (not (= (api-code linked) 0))
                    {"ok" false "error" (or (get linked "stderr") "GitHub 저장소 연결에 실패했습니다.")}
                    (if (not (= (api-code committed) 0))
                      {"ok" false "error" (or (get committed "stderr") "초기 커밋을 만들지 못했습니다.")}
                      (if (not (= (api-code pushed) 0))
                        {"ok" false "error" (or (get pushed "stderr") "첫 Push에 실패했습니다.")}
                        (do (reset! fl-git-repo target)
                            {"ok" true "root" target "message" (if (and (= initial-push true) (not (= gh-name "")) (= has-seed true)) "프로젝트 초기화와 첫 Push를 완료했습니다." (if (= gh-name "") "로컬 프로젝트 초기화를 완료했습니다." "프로젝트 초기화와 GitHub 연결을 완료했습니다."))}))))))))))))))

(defn api-connect-github [github-ref visibility initial-push]
  (let [ref (str-trim (str github-ref))
        repo (deref fl-git-repo)
        root-result (api-run "git rev-parse --show-toplevel")
        root (api-out root-result)
        branch-result (api-run "git branch --show-current")
        branch (api-out branch-result)
        origin-result (api-run "git remote get-url origin")
        visibility-flag (if (= visibility "public") "--public" "--private")]
    (if (= ref "")
      {"ok" false "error" "GitHub 저장소 이름 또는 URL을 입력하세요."}
      (if (not (= (api-code root-result) 0))
        {"ok" false "error" "현재 선택된 폴더가 Git 저장소가 아닙니다."}
        (if (not (api-root-allowed root))
          {"ok" false "error" "허용된 폴더 밖의 저장소입니다."}
          (if (= (api-code origin-result) 0)
            {"ok" false "error" (str "이미 origin이 연결되어 있습니다: " (api-out origin-result))}
            (let [linked (if (str-starts-with ref "https://github.com/")
                           (api-run (str "git remote add origin " (api-shell-quote ref)))
                           (if (or (str-starts-with ref "-") (str-includes ref " "))
                             {"code" 1 "stderr" "GitHub 저장소 이름을 확인하세요."}
                             (api-run (str "gh repo create " (api-shell-quote ref) " " visibility-flag " --source " (api-shell-quote repo) " --remote origin"))))
                  pushed (if (= initial-push true) (api-run (str "git push -u origin " (api-shell-quote branch))) {"code" 0})]
              (if (not (= (api-code linked) 0))
                {"ok" false "error" (or (get linked "stderr") "GitHub 연결에 실패했습니다.")}
                (if (not (= (api-code pushed) 0))
                  {"ok" false "error" (or (get pushed "stderr") "GitHub 연결은 완료했지만 첫 Push에 실패했습니다.")}
                  (api-payload (if (= initial-push true) "현재 저장소를 GitHub에 연결하고 Push했습니다." "현재 저장소를 GitHub에 연결했습니다.")))))))))))

(defn api-context-json [root branch remote status log]
  (json-stringify {"root" root "branch" branch "remote" remote "status" status "recent_log" log}))

(defn api-context-cards [root branch remote status diff commits github sync conflicts branches]
  [{"number" "01" "key" "repo:root" "title" "저장소 경로" "content" root}
   {"number" "02" "key" "repo:branch" "title" "현재 branch" "content" branch}
   {"number" "03" "key" "repo:remote" "title" "Remote" "content" remote}
   {"number" "04" "key" "repo:sync" "title" "Ahead / Behind" "content" (str "ahead=" (get sync "ahead") " behind=" (get sync "behind") " upstream=" (get sync "upstream"))}
   {"number" "05" "key" "changes:files" "title" "변경 파일" "content" (str-join (map (fn [file] (str (get file "kind") " " (get file "path"))) (or (api-status-files) [])) "\n")}
   {"number" "06" "key" "diff:current" "title" "현재 Diff" "content" diff}
   {"number" "07" "key" "github:status" "title" "GitHub 연결" "content" (str (get github "name") " connected=" (get github "connected"))}
   {"number" "08" "key" "commits:recent" "title" "최근 커밋" "content" (str-join (map (fn [commit] (str (get commit "hash") " " (get commit "message"))) (or commits [])) "\n")}
   {"number" "09" "key" "remote:conflicts" "title" "충돌 파일" "content" (str-join (or conflicts []) "\n")}
   {"number" "10" "key" "repo:branches" "title" "Branch 목록" "content" (str-join (or branches []) "\n")}])

(defn api-context-markdown [cards]
  (str-join (map (fn [card] (str "## " (get card "number") " · " (get card "title") " [" (get card "key") "]\n" (or (get card "content") ""))) (or cards [])) "\n\n"))

(defn api-context-select [cards keys]
  (filter
    (fn [card]
      (> (length (filter (fn [key] (= key (get card "key"))) (or keys []))) 0))
    (or cards [])))

(defn api-commit-list []
  (let [result (api-run "git --no-pager log --date=short --pretty=format:'%H~%ad~%an~%s' -12")
        rows (filter (fn [row] (> (length (str-trim row)) 0)) (regex_split (api-out result) "\\n"))]
    (map (fn [row]
           (let [parts (regex_split row "~")]
             {"hash" (or (get parts 0) "")
              "date" (or (get parts 1) "")
              "author" (or (get parts 2) "")
              "message" (or (get parts 3) "")})) rows)))

(defn api-github-info []
  (let [result (api-run "gh repo view --json nameWithOwner,isPrivate,defaultBranchRef,url,description")
        remote-result (api-run "git remote get-url origin")]
    (if (= (api-code result) 0)
      (let [info (json_parse (api-out result))]
        {"connected" true "name" (or (get info "nameWithOwner") "")
         "private" (or (get info "isPrivate") false)
         "default_branch" (or (get (get info "defaultBranchRef") "name") "")
         "url" (or (get info "url") "")
         "description" (or (get info "description") "")})
      {"connected" false "name" "" "private" false "default_branch" ""
       "url" (api-out remote-result) "description" "GitHub 저장소 정보를 불러오지 못했습니다."})))

(defn api-sync-info []
  (let [upstream (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
        counts (api-run "git rev-list --left-right --count HEAD...@{upstream}")
        parts (regex_split (api-out counts) " ")]
    {"upstream" (if (= (api-code upstream) 0) (api-out upstream) "")
     "ahead" (if (= (api-code counts) 0) (or (get parts 0) "0") "—")
     "behind" (if (= (api-code counts) 0) (or (get parts 1) "0") "—")}))

(defn api-conflict-files []
  (let [result (api-run "git diff --name-only --diff-filter=U")]
    (api-file-lines result)))

(defn api-branch-valid [name]
  (let [clean (str-trim (str name))
        result (if (= clean "") {"code" 1} (api-run (str "git check-ref-format --branch " (api-shell-quote clean))))]
    (and (> (length clean) 0) (= (api-code result) 0))))

(defn api-branch-list []
  (let [result (api-run "git branch --format='%(refname:short)'")]
    (api-file-lines result)))

(defn api-file-lines [result]
  (filter (fn [line] (> (length (str-trim line)) 0)) (regex_split (api-out result) "\\n")))

(defn api-path-lower [path]
  (str-to-lower (str-trim (str path))))

(defn api-sensitive-file [path]
  (let [clean (api-path-lower path)
        name (last (regex_split clean "/"))]
    (or (= name ".env")
        (str-starts-with name ".env.")
        (str-ends-with name ".env")
        (str-includes clean "/.env")
        (str-starts-with clean ".ssh/")
        (str-includes clean "/.ssh/")
        (str-starts-with clean ".aws/")
        (str-includes clean "/.aws/")
        (str-starts-with clean ".gnupg/")
        (str-includes clean "/.gnupg/")
        (= name ".netrc")
        (= name ".npmrc")
        (= name "credentials")
        (= name "credentials.json")
        (= name "credentials.xml")
        (str-starts-with name "service-account")
        (str-includes name "secret")
        (= name "id_rsa")
        (= name "id_dsa")
        (= name "id_ecdsa")
        (= name "id_ed25519")
        (= name "id_ed25519_sk")
        (str-ends-with name ".pem")
        (str-ends-with name ".key")
        (str-ends-with name ".p12")
        (str-ends-with name ".pfx")
        (str-ends-with name ".jks")
        (str-ends-with name ".keystore")
        (str-ends-with name ".ppk")
        (str-ends-with name ".kdbx"))))

(defn api-safe-file-path [path]
  (let [clean (str-trim (str path))]
    (and (> (length clean) 0)
         (not (str-starts-with clean "/"))
         (not (str-includes clean ".."))
         (not (str-includes clean "\\\\"))
         (not (api-sensitive-file clean)))))

(defn api-file-content [side path upstream]
  (let [clean (str-trim (str path))]
    (if (not (api-safe-file-path clean))
      {"ok" false "error" "보안상 열 수 없는 파일 경로입니다."}
      (let [target (if (= side "github") (str upstream ":" clean) clean)
            command (if (= side "github")
                      (str "git show --no-ext-diff --format= " (api-shell-quote target))
                      (str "head -c 200000 -- " (api-shell-quote target)))
            result (api-run command)]
        (if (not (= (api-code result) 0))
          {"ok" false "error" (or (get result "stderr") "파일 내용을 읽을 수 없습니다.")}
          {"ok" true "side" side "path" clean "upstream" upstream
           "content" (or (get result "stdout") "") "truncated" (> (length (or (get result "stdout") "")) 199999)})))))

(defn api-file-compare-content [path]
  (let [clean (str-trim (str path))
        branch-result (api-run "git branch --show-current")
        branch (api-out branch-result)
        upstream-result (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
        upstream (if (= (api-code upstream-result) 0) (api-out upstream-result) (if (= branch "") "origin/main" (str "origin/" branch)))]
    (if (not (api-safe-file-path clean))
      {"ok" false "error" "보안상 비교할 수 없는 파일 경로입니다."}
      {"ok" true "path" clean "upstream" upstream
       "server" (api-file-content "server" clean upstream)
       "github" (api-file-content "github" clean upstream)})))

(defn api-file-compare []
  (let [branch-result (api-run "git branch --show-current")
        branch (api-out branch-result)
        upstream-result (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
        upstream (if (= (api-code upstream-result) 0) (api-out upstream-result) (if (= branch "") "origin/main" (str "origin/" branch)))
        server-result (api-run "git ls-files -co --exclude-standard")
        github-result (api-run (str "git ls-tree -r --name-only " (api-shell-quote upstream)))]
    (if (not (= (api-code github-result) 0))
      {"ok" false "error" (or (get github-result "stderr") (str "GitHub 원격 브랜치를 읽을 수 없습니다: " upstream))}
      {"ok" true "branch" branch "upstream" upstream
       "server_files" (api-file-lines server-result)
       "github_files" (api-file-lines github-result)})))

(defn api-payload [message]
  (let [root-result (api-run "git rev-parse --show-toplevel")
        branch-result (api-run "git branch --show-current")
        remote-result (api-run "git remote -v")
        status-result (api-run "git status --short --branch")
        diff-result (api-run "git --no-pager diff --stat && git --no-pager diff")
        log-result (api-run "git --no-pager log --oneline --decorate -12")
        commits (api-commit-list)
        files (api-status-files)
        conflicts (api-conflict-files)
        branches (api-branch-list)
        github (api-github-info)
        sync (api-sync-info)
        root (api-out root-result)
        branch (api-out branch-result)
        remote (api-out remote-result)
        status (api-out status-result)
        log (api-out log-result)
        context-cards (api-context-cards root branch remote status (api-out diff-result) commits github sync conflicts branches)]
    {"ok" true "message" (or message "") "root" root "branch" branch
     "remote" remote "status" status "files" files "diff" (api-out diff-result) "log" log "commits" commits
     "github" github "sync" sync "conflicts" conflicts "branches" branches
     "context_json" (api-context-json root branch remote status log)
     "context_cards" context-cards
     "context_available_keys" (map (fn [card] (get card "key")) context-cards)}))

(defn render [req]
  (server-json (api-payload "")))

(defn render_post [req]
  (let [body (or (get req "body") {})
        action (or (get body "action") "")]
    (cond
      (= action "list-folders")
        (server-json (api-list-folders (get body "path")))
      (= action "list-repos")
        (server-json (api-list-repos))
      (= action "commit-detail")
        (let [hash (str-trim (str (get body "hash")))
              result (api-command (str "git --no-pager show --no-ext-diff --format=fuller --stat --patch " (api-shell-quote hash)))]
          (if (= (api-code result) 0)
            (server-json {"ok" true "hash" hash "detail" (get result "stdout")})
            (server-json {"ok" false "error" (or (get result "stderr") "커밋 상세 정보를 불러오지 못했습니다.")} 400)))
      (= action "compare-files")
        (server-json (api-file-compare))
      (= action "file-content")
        (let [branch-result (api-run "git branch --show-current")
              branch (api-out branch-result)
              upstream-result (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
              upstream (if (= (api-code upstream-result) 0) (api-out upstream-result) (if (= branch "") "origin/main" (str "origin/" branch)))]
          (server-json (api-file-content (get body "side") (get body "path") upstream)))
      (= action "compare-file-content")
        (server-json (api-file-compare-content (get body "path")))
      (= action "context")
        (let [snapshot (api-payload "")
              cards (api-context-select (get snapshot "context_cards") (get body "keys"))]
          (server-json {"ok" true "cards" cards
                        "available_keys" (get snapshot "context_available_keys")
                        "markdown" (api-context-markdown cards)
                        "ai_instruction" "선택한 카드만 기준으로 답변하세요."}))
      (= action "project-setup")
        (let [created (api-project-setup (get body "parent") (get body "name") (get body "github_name") (get body "visibility") (get body "readme") (get body "gitignore_template") (get body "initial_push"))]
          (if (= (get created "ok") true)
            (server-json (api-payload (get created "message")))
            (server-json created 400)))
      (= action "connect-github")
        (let [connected (api-connect-github (get body "github_ref") (get body "visibility") (get body "initial_push"))]
          (if (= (get connected "ok") true)
            (server-json connected)
            (server-json connected 400)))
      (= action "create-repo")
        (let [created (api-create-repo (get body "parent") (get body "name"))]
          (if (= (get created "ok") true)
            (server-json (api-payload "새 저장소를 만들었습니다."))
            (server-json created 400)))
      (= action "select-repo")
        (let [selected (api-select-repo (get body "path"))]
          (if (= (get selected "ok") true)
            (server-json (api-payload "저장소를 전환했습니다."))
            (server-json selected 400)))
      (= action "add-all")
        (let [r (api-command "git add -- .")]
          (if (= (api-code r) 0) (server-json (api-payload "전체 파일을 Stage했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "unstage-all")
        (let [r (api-command "git reset -- .")]
          (if (= (api-code r) 0) (server-json (api-payload "Stage를 취소했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "stage-file")
        (let [path (str-trim (str (get body "path")))]
          (if (not (api-safe-git-path path))
            (server-json {"ok" false "error" "안전하지 않은 파일 경로입니다."} 400)
            (let [r (api-command (str "git add -- " (api-shell-quote path)))]
              (if (= (api-code r) 0) (server-json (api-payload "파일을 Stage했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))))
      (= action "unstage-file")
        (let [path (str-trim (str (get body "path")))]
          (if (not (api-safe-git-path path))
            (server-json {"ok" false "error" "안전하지 않은 파일 경로입니다."} 400)
            (let [r (api-command (str "git reset -- " (api-shell-quote path)))]
              (if (= (api-code r) 0) (server-json (api-payload "파일의 Stage를 취소했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))))
      (= action "stage-files")
        (let [r (api-file-command "add" (get body "paths"))]
          (if (= (api-code r) 0) (server-json (api-payload "선택한 파일을 Stage했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "unstage-files")
        (let [r (api-file-command "reset" (get body "paths"))]
          (if (= (api-code r) 0) (server-json (api-payload "선택한 파일의 Stage를 취소했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "create-branch")
        (let [name (str-trim (str (get body "name")))]
          (if (not (api-branch-valid name))
            (server-json {"ok" false "error" "유효하지 않은 branch 이름입니다."} 400)
            (let [r (api-command (str "git switch -c " (api-shell-quote name)))]
              (if (= (api-code r) 0) (server-json (api-payload (str "branch를 생성하고 전환했습니다: " name))) (server-json {"ok" false "error" (or (get r "stderr") "branch 생성에 실패했습니다.")} 400)))))
      (= action "switch-branch")
        (let [name (str-trim (str (get body "name")))]
          (if (not (api-branch-valid name))
            (server-json {"ok" false "error" "유효하지 않은 branch 이름입니다."} 400)
            (let [r (api-command (str "git switch -- " (api-shell-quote name)))]
              (if (= (api-code r) 0) (server-json (api-payload (str "branch를 전환했습니다: " name))) (server-json {"ok" false "error" (or (get r "stderr") "branch 전환에 실패했습니다.")} 400)))))
      (= action "fetch")
        (let [r (api-command "git fetch --all --prune")]
          (if (= (api-code r) 0) (server-json (api-payload "Fetch 완료")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "pull")
        (if (= (get body "confirm") true)
          (let [r (api-command "git pull")]
            (if (= (api-code r) 0) (server-json (api-payload "Pull 완료")) (server-json {"ok" false "error" (get r "stderr") "conflicts" (api-conflict-files)} 400)))
          (server-json {"ok" false "error" "Pull은 confirm=true가 필요합니다."} 400))
      (= action "push")
        (if (= (get body "confirm") true)
          (let [r (api-command "git push")]
            (if (= (api-code r) 0) (server-json (api-payload "Push 완료")) (server-json {"ok" false "error" (get r "stderr")} 400)))
          (server-json {"ok" false "error" "Push는 confirm=true가 필요합니다."} 400))
      (= action "commit")
        (let [message (str-trim (or (get body "message") ""))]
          (if (= message "")
            (server-json {"ok" false "error" "커밋 메시지가 필요합니다."} 400)
            (let [r (api-command (str "git commit -m " (api-shell-quote message)))]
              (if (= (api-code r) 0)
                (server-json (api-payload "커밋 완료"))
                (server-json {"ok" false "error" (or (get r "stderr") (get r "stdout"))} 400)))))
      (= action "commit-selected")
        (let [r (api-commit-selected (get body "message") (get body "paths"))]
          (if (= (api-code r) 0)
            (server-json (api-payload "선택한 파일을 커밋했습니다."))
            (server-json {"ok" false "error" (or (get r "stderr") (get r "stdout"))} 400)))
      (= action "commit-push")
        (if (= (get body "confirm") true)
          (let [message (str-trim (or (get body "message") ""))]
            (if (= message "")
              (server-json {"ok" false "error" "커밋 메시지가 필요합니다."} 400)
              (let [commit-result (api-command (str "git commit -m " (api-shell-quote message)))]
                (if (not (= (api-code commit-result) 0))
                  (server-json {"ok" false "error" (or (get commit-result "stderr") (get commit-result "stdout"))} 400)
                  (let [push-result (api-command "git push")]
                    (if (= (api-code push-result) 0)
                      (server-json (api-payload "커밋 및 Push 완료"))
                      (server-json {"ok" false "committed" true "error" (str "커밋은 완료됐지만 Push에 실패했습니다: " (or (get push-result "stderr") (get push-result "stdout")))} 400)))))))
          (server-json {"ok" false "error" "Commit & Push는 confirm=true가 필요합니다."} 400))
      true (server-json {"ok" false "error" (str "알 수 없는 action: " action)} 400))))
