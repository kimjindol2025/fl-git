; fl-git 웹 API — 선택된 Git 저장소에서만 명령을 실행한다.

(define fl-git-repo (atom (or (fl-env-get "FL_GIT_REPO") "/home/kim/kim/projects/fl-git")))
(define fl-git-roots (or (fl-env-get "FL_GIT_ROOTS") "/home/kim/kim/projects"))

(defn api-shell-quote [value]
  (str "'" (str-replace-in (str value) "'" "'\\''") "'"))

(defn api-run-at [repo command]
  (shell_capture (str "cd " (api-shell-quote repo) " && " command)))

(defn api-run [command]
  (api-run-at (deref fl-git-repo) command))

(defn api-out [result]
  (str-trim (or (get result "stdout") "")))

(defn api-code [result]
  (or (get result "code") -1))

(defn api-resolve-directory [path]
  (let [candidate (str-trim (str path))]
    (if (= candidate "")
      ""
      (let [result (api-run-at candidate "pwd -P")]
        (if (= (api-code result) 0) (api-out result) "")))))

(defn api-command [command]
  (let [result (api-run command)]
    {"stdout" (or (get result "stdout") "")
     "stderr" (or (get result "stderr") "")
     "code" (api-code result)}))

(defn api-status-files []
  (let [result (api-run "git status --short --untracked-files=all | sed -E 's/^(.{2}) (.*)$/\\1\\t\\2/'")
        rows (filter (fn [row] (> (length (str-trim row)) 0)) (regex_split (api-out result) "\\n"))]
    (map (fn [row]
           (let [parts (regex_split row "\\t")
                 status (or (get parts 0) "")
                 path (or (get parts 1) "")
                 kind (if (= status "??") "untracked"
                        (if (or (str-includes status "A") (str-includes status "C")) "added"
                          (if (str-includes status "D") "deleted" "modified")))]
             {"kind" kind "status" status "path" path}))
         rows)))

(defn api-safe-git-path [path]
  (let [clean (str-trim (str path))]
    (and (> (length clean) 0)
         (not (str-starts-with clean "/"))
         (not (str-includes clean ".."))
         (not (str-includes clean "\\\\")))))

(defn api-file-command [action paths]
  (let [safe (filter api-safe-git-path (or paths []))]
    (if (or (= (length safe) 0) (not (= (length safe) (length (or paths [])))))
      {"code" 2 "stderr" "안전하지 않은 파일 경로가 포함되어 있습니다."}
      (api-command (str "git " action " -- " (str-join (map api-shell-quote safe) " "))))))

(defn api-commit-selected [message paths]
  (let [clean-message (str-trim (str message))
        safe (filter api-safe-git-path (or paths []))]
    (if (= clean-message "")
      {"code" 2 "stderr" "커밋 메시지가 필요합니다."}
      (if (or (= (length safe) 0) (not (= (length safe) (length (or paths [])))))
        {"code" 2 "stderr" "선택 파일이 없거나 안전하지 않은 파일 경로가 포함되어 있습니다."}
        (let [stage (api-file-command "add" safe)]
          (if (not (= (api-code stage) 0))
            stage
            (api-command (str "git commit --only -m " (api-shell-quote clean-message) " -- " (str-join (map api-shell-quote safe) " ")))))))))

(defn api-root-allowed [root]
  (let [candidate (api-resolve-directory root)
        configured (filter (fn [allowed] (> (length (str-trim allowed)) 0)) (regex_split fl-git-roots ":"))]
    (and (> (length candidate) 0)
         (> (length configured) 0)
         (= (length (filter (fn [allowed] (= (str-trim allowed) "*")) configured)) 0)
         (> (length
              (filter
                (fn [allowed]
                  (let [base (api-resolve-directory allowed)]
                    (and (> (length base) 0)
                         (or (= candidate base) (str-starts-with candidate (str base "/"))))))
                configured))
            0))))

(defn api-select-repo [requested]
  (let [path (api-resolve-directory requested)
        result (api-run-at path "git rev-parse --show-toplevel")
        root (api-resolve-directory (api-out result))]
    (if (= path "")
      {"ok" false "error" "선택한 폴더를 읽을 수 없습니다."}
      (if (not (= (api-code result) 0))
        {"ok" false "error" "선택한 폴더가 Git 저장소가 아닙니다."}
        (if (not (api-root-allowed root))
          {"ok" false "error" "허용된 물리 경로 밖의 저장소입니다. FL_GIT_ROOTS를 확인하세요."}
          (do (reset! fl-git-repo root) {"ok" true "root" root}))))))

(defn api-list-folders [requested]
  (let [candidate (str-trim (str (or requested "")))
        base (if (= candidate "") (first (regex_split fl-git-roots ":")) candidate)
        root (api-resolve-directory base)]
    (if (= root "")
      {"ok" false "error" "폴더를 읽을 수 없습니다."}
      (if (not (api-root-allowed root))
        {"ok" false "error" "허용되지 않은 물리 경로입니다. FL_GIT_ROOTS를 확인하세요."}
        (let [entries (api-run-at root "find . -mindepth 1 -maxdepth 1 -type d -printf '%f\\n' | sort")
              names (filter (fn [name] (> (length (str-trim name)) 0)) (regex_split (api-out entries) "\\n"))]
          {"ok" true "root" root
           "folders" (map (fn [name] (str root "/" (str-trim name))) names)})))))

(defn api-repo-paths [base names]
  (map (fn [name] (str-replace-in (str base "/" (str-replace-in (str-trim name) "./" "") "/") "/.git/" "")) names))

(defn api-list-repos []
  (let [roots (filter (fn [root] (> (length (str-trim root)) 0)) (regex_split fl-git-roots ":"))
        repos (reduce
                (fn [acc root]
                  (let [base (api-resolve-directory root)
                        result (if (and (> (length base) 0) (api-root-allowed base))
                                 (api-run-at base "find . -type d -name .git -prune -print | sort")
                                 {"code" 1 "stdout" ""})
                        names (filter (fn [name] (> (length (str-trim name)) 0)) (regex_split (api-out result) "\\n"))]
                    (concat acc (api-repo-paths base names))))
                [] roots)]
    (if (= (length (filter (fn [root] (= (str-trim root) "*")) roots)) 0)
      {"ok" true "roots" roots "repositories" repos}
      {"ok" false "error" "FL_GIT_ROOTS에 *를 사용할 수 없습니다."})))

(defn api-provider-redact [text]
  (let [step1 (regex-replace (str text) "Token: \\S+" "Token: [redacted]")
        step2 (regex-replace step1 "GH_TOKEN=\\S+" "GH_TOKEN=[redacted]")
        step3 (regex-replace step2 "GITHUB_TOKEN=\\S+" "GITHUB_TOKEN=[redacted]")]
    step3))

(defn api-provider-tool? [name]
  (= (api-code (api-run (str "command -v " name " >/dev/null 2>&1"))) 0))

(defn api-provider-auth-github []
  (if (not (api-provider-tool? "gh"))
    {"provider" "github" "host" "github.com" "auth" "blocked" "account" "" "code" "AUTH_BLOCKED" "detail" "gh CLI not found"}
    (let [result (api-run "gh api user --jq .login")
          account (str-trim (api-out result))]
      (if (and (= (api-code result) 0) (> (length account) 0))
        {"provider" "github" "host" "github.com" "auth" "configured" "account" account "code" "AUTH_OK" "detail" ""}
        {"provider" "github" "host" "github.com" "auth" "blocked" "account" "" "code" "AUTH_BLOCKED"
         "detail" (api-provider-redact (or (get result "stderr") (api-out result) "GitHub authentication missing"))}))))

(defn api-provider-tea-configured? [logins]
  (> (length
       (filter (fn [item]
                 (let [url (str-to-lower (str (or (get item "url") "")))
                       ssh (str-to-lower (str (or (get item "ssh_host") "")))]
                   (or (str-includes url "fg.dclub.kr") (str-includes url "fg.dclub.jp") (str-includes ssh "fg.dclub.kr") (str-includes ssh "fg.dclub.jp"))))
               (or logins [])))
     0))

(defn api-provider-tea-account [logins]
  (let [matched (filter (fn [item]
                          (let [url (str-to-lower (str (or (get item "url") "")))
                                ssh (str-to-lower (str (or (get item "ssh_host") "")))]
                            (or (str-includes url "fg.dclub.kr") (str-includes url "fg.dclub.jp") (str-includes ssh "fg.dclub.kr") (str-includes ssh "fg.dclub.jp"))))
                        (or logins []))]
    (if (= (length matched) 0) "" (str (or (get (first matched) "user") "")))))

(defn api-provider-auth-forgejo []
  (if (not (api-provider-tool? "tea"))
    {"provider" "forgejo" "host" "fg.dclub.kr" "auth" "blocked" "account" "" "code" "AUTH_BLOCKED" "detail" "tea CLI not found"}
    (let [result (api-run "tea login list --output json")
          raw (str-trim (api-out result))]
      (if (not (= (api-code result) 0))
        {"provider" "forgejo" "host" "fg.dclub.kr" "auth" "blocked" "account" "" "code" "AUTH_BLOCKED"
         "detail" (api-provider-redact (or (get result "stderr") "tea login list failed"))}
        (let [logins (if (= raw "") [] (json_parse raw))]
          (if (api-provider-tea-configured? logins)
            {"provider" "forgejo" "host" "fg.dclub.kr" "auth" "configured"
             "account" (api-provider-tea-account logins) "code" "AUTH_OK" "detail" ""}
            {"provider" "forgejo" "host" "fg.dclub.kr" "auth" "blocked" "account" "" "code" "AUTH_BLOCKED"
             "detail" "Forgejo tea login for fg.dclub.kr missing"}))))))

(defn api-provider-auth [provider]
  (let [kind (str-to-lower (str-trim (str provider)))]
    (cond
      (= kind "github") (api-provider-auth-github)
      (= kind "forgejo") (api-provider-auth-forgejo)
      true {"provider" kind "host" "" "auth" "blocked" "account" "" "code" "UNKNOWN" "detail" "unsupported provider"})))

(defn api-provider-status [provider]
  (let [kind (str-to-lower (str-trim (str provider)))]
    (if (= kind "")
      {"ok" true "providers" [(api-provider-auth "github") (api-provider-auth "forgejo")]}
      {"ok" true "providers" [(api-provider-auth kind)]})))

(defn api-provider-repos [provider]
  (let [kind (str-to-lower (str-trim (str provider)))]
    (if (not (or (= kind "github") (= kind "forgejo")))
      {"ok" false "provider" kind "auth" "blocked" "code" "UNKNOWN" "repositories" []
       "error" "지원하지 않는 Git provider입니다."}
      (let [auth-info (api-provider-auth kind)]
        (if (not (= (get auth-info "auth") "configured"))
          {"ok" false "provider" kind "auth" (get auth-info "auth") "code" "AUTH_BLOCKED"
           "account" (get auth-info "account") "repositories" []
           "error" (or (get auth-info "detail") "AUTH_BLOCKED")}
          (let [result (if (= kind "github")
                         (api-run "gh repo list --limit 50 --json nameWithOwner,url,description,isPrivate,updatedAt")
                         (api-run "tea repos list --output json --limit 50 --fields owner,name,type,ssh,url,description,updated"))]
            (if (not (= (api-code result) 0))
              {"ok" false "provider" kind "auth" "blocked" "code" "AUTH_BLOCKED" "repositories" []
               "error" (api-provider-redact (or (get result "stderr") "provider 레포 목록을 불러오지 못했습니다."))}
              (let [parsed (json_parse (api-out result))
                    repos (map (fn [item]
                                 (if (= kind "github")
                                   (let [full (or (get item "nameWithOwner") "")
                                         parts (regex_split full "/")
                                         owner (if (> (length parts) 0) (get parts 0) "")
                                         name (if (> (length parts) 1) (get parts 1) full)]
                                     {"provider" "github"
                                      "owner" owner
                                      "repository" name
                                      "full_name" full
                                      "name" full
                                      "remote" (or (get item "url") "")
                                      "url" (or (get item "url") "")
                                      "description" (or (get item "description") "")
                                      "private" (or (get item "isPrivate") false)
                                      "updated" (or (get item "updatedAt") "")})
                                   (let [owner (or (get item "owner") "")
                                         name (or (get item "name") "")
                                         full (if (or (= owner "") (= name "")) name (str owner "/" name))]
                                     {"provider" "forgejo"
                                      "owner" owner
                                      "repository" name
                                      "full_name" full
                                      "name" name
                                      "remote" (or (get item "ssh") (get item "url") "")
                                      "url" (or (get item "url") "")
                                      "description" (or (get item "description") "")
                                      "private" false
                                      "updated" (or (get item "updated") "")})))
                               parsed)]
                {"ok" true "provider" kind "auth" "configured" "code" "PROVIDER_REPOS_OK"
                 "account" (get auth-info "account") "repositories" repos}))))))))

(defn api-create-repo [parent name]
  (let [base (str-trim (str parent))
        repo-name (str-trim (str name))
        resolved (api-run-at base "pwd -P")
        root (api-out resolved)
        target (str root "/" repo-name)]
    (if (= repo-name "")
      {"ok" false "error" "새 저장소 이름을 입력하세요."}
      (if (or (= repo-name ".") (= repo-name "..") (str-includes repo-name "/"))
        {"ok" false "error" "저장소 이름에는 경로 구분자를 사용할 수 없습니다."}
        (if (not (= (api-code resolved) 0))
          {"ok" false "error" "상위 폴더를 읽을 수 없습니다."}
          (if (not (api-root-allowed root))
            {"ok" false "error" (str "허용된 폴더 밖입니다. 허용 범위: " fl-git-roots)}
            (let [created (api-run-at root (str "mkdir -p -- " (api-shell-quote repo-name) " && git init -q -- " (api-shell-quote repo-name)))]
              (if (= (api-code created) 0)
                (do (reset! fl-git-repo target) {"ok" true "root" target})
                {"ok" false "error" (or (get created "stderr") "저장소를 만들 수 없습니다.")}))))))))

(defn api-gitignore-content [template]
  (cond
    (= template "node") "node_modules/\n.env\n"
    (= template "next") "node_modules/\n.next/\n.env\n"
    (= template "python") "__pycache__/\n.venv/\n.env\n"
    ""))

(defn api-project-setup [parent name github-name visibility readme gitignore-template initial-push]
  (let [base (str-trim (str parent))
        project-name (str-trim (str name))
        gh-name (str-trim (str (or github-name "")))
        template (str-trim (str (or gitignore-template "none")))
        resolved (api-run-at base "pwd -P")
        root (api-out resolved)
        target (str root "/" project-name)
        visibility-flag (if (= visibility "public") "--public" "--private")
        readme-content (str "# " project-name "\n\n")
        gitignore-content (api-gitignore-content template)
        has-seed (or (= readme true) (> (length gitignore-content) 0))]
    (if (or (= project-name "") (= project-name ".") (= project-name "..") (str-includes project-name "/"))
      {"ok" false "error" "프로젝트 이름을 확인하세요. 경로 구분자는 사용할 수 없습니다."}
      (if (or (str-starts-with gh-name "-") (str-includes gh-name " "))
        {"ok" false "error" "GitHub 저장소 이름을 확인하세요."}
      (if (not (= (api-code resolved) 0))
        {"ok" false "error" "상위 폴더를 읽을 수 없습니다."}
        (if (not (api-root-allowed root))
          {"ok" false "error" (str "허용된 폴더 밖입니다. 허용 범위: " fl-git-roots)}
          (let [created (api-run-at root (str "test ! -e " (api-shell-quote project-name) " && mkdir -p -- " (api-shell-quote project-name) " && git init -q -- " (api-shell-quote project-name)))]
            (if (not (= (api-code created) 0))
              {"ok" false "error" "프로젝트 폴더가 이미 존재하거나 생성할 수 없습니다."}
              (let [branch-set (api-run-at target "git branch -M main")
                    readme-write (if (= readme true) (api-run-at target (str "printf %s " (api-shell-quote readme-content) " > README.md")) {"code" 0})
                    gitignore-write (if (> (length gitignore-content) 0) (api-run-at target (str "printf %s " (api-shell-quote gitignore-content) " > .gitignore")) {"code" 0})
                    linked (if (= gh-name "")
                             {"code" 0}
                             (if (str-starts-with gh-name "https://github.com/")
                               (api-run-at target (str "git remote add origin " (api-shell-quote gh-name)))
                               (api-run-at root (str "gh repo create " (api-shell-quote gh-name) " " visibility-flag " --source " (api-shell-quote target) " --remote origin"))))
                    committed (if (= has-seed true) (api-run-at target "git add -- . && git commit -m 'chore: initialize project'") {"code" 0})
                    pushed (if (and (= initial-push true) (not (= gh-name "")) (= has-seed true)) (api-run-at target "git push -u origin main") {"code" 0})]
                (if (or (not (= (api-code branch-set) 0)) (not (= (api-code readme-write) 0)) (not (= (api-code gitignore-write) 0)))
                  {"ok" false "error" "프로젝트 초기 파일을 만들지 못했습니다."}
                  (if (not (= (api-code linked) 0))
                    {"ok" false "error" (or (get linked "stderr") "GitHub 저장소 연결에 실패했습니다.")}
                    (if (not (= (api-code committed) 0))
                      {"ok" false "error" (or (get committed "stderr") "초기 커밋을 만들지 못했습니다.")}
                      (if (not (= (api-code pushed) 0))
                        {"ok" false "error" (or (get pushed "stderr") "첫 Push에 실패했습니다.")}
                        (do (reset! fl-git-repo target)
                            {"ok" true "root" target "message" (if (and (= initial-push true) (not (= gh-name "")) (= has-seed true)) "프로젝트 초기화와 첫 Push를 완료했습니다." (if (= gh-name "") "로컬 프로젝트 초기화를 완료했습니다." "프로젝트 초기화와 GitHub 연결을 완료했습니다."))}))))))))))))))

(defn api-connect-github [github-ref visibility initial-push]
  (let [ref (str-trim (str github-ref))
        repo (deref fl-git-repo)
        root-result (api-run "git rev-parse --show-toplevel")
        root (api-out root-result)
        branch-result (api-run "git branch --show-current")
        branch (api-out branch-result)
        origin-result (api-run "git remote get-url origin")
        visibility-flag (if (= visibility "public") "--public" "--private")]
    (if (= ref "")
      {"ok" false "error" "GitHub 저장소 이름 또는 URL을 입력하세요."}
      (if (not (= (api-code root-result) 0))
        {"ok" false "error" "현재 선택된 폴더가 Git 저장소가 아닙니다."}
        (if (not (api-root-allowed root))
          {"ok" false "error" "허용된 폴더 밖의 저장소입니다."}
          (if (= (api-code origin-result) 0)
            {"ok" false "error" (str "이미 origin이 연결되어 있습니다: " (api-out origin-result))}
            (let [linked (if (str-starts-with ref "https://github.com/")
                           (api-run (str "git remote add origin " (api-shell-quote ref)))
                           (if (or (str-starts-with ref "-") (str-includes ref " "))
                             {"code" 1 "stderr" "GitHub 저장소 이름을 확인하세요."}
                             (api-run (str "gh repo create " (api-shell-quote ref) " " visibility-flag " --source " (api-shell-quote repo) " --remote origin"))))
                  pushed (if (= initial-push true) (api-run (str "git push -u origin " (api-shell-quote branch))) {"code" 0})]
              (if (not (= (api-code linked) 0))
                {"ok" false "error" (or (get linked "stderr") "GitHub 연결에 실패했습니다.")}
                (if (not (= (api-code pushed) 0))
                  {"ok" false "error" (or (get pushed "stderr") "GitHub 연결은 완료했지만 첫 Push에 실패했습니다.")}
                  (api-payload (if (= initial-push true) "현재 저장소를 GitHub에 연결하고 Push했습니다." "현재 저장소를 GitHub에 연결했습니다.")))))))))))

(defn api-remote-url-valid [remote]
  (let [clean (str-trim (str remote))
        lower (str-to-lower clean)]
    (and (> (length clean) 0)
         (not (str-includes clean " "))
         (not (str-includes clean "\n"))
         (not (str-includes clean ";"))
         (not (str-includes clean "|"))
         (not (str-includes clean "&&"))
         (or (str-starts-with lower "https://github.com/")
             (str-starts-with lower "git@github.com:")
             (str-starts-with lower "https://fg.dclub.kr/")
             (str-starts-with lower "ssh://git@fg.dclub.kr/")
             (str-starts-with lower "ssh://git@fg.dclub.kr:")
             (str-starts-with lower "forgejo-dclub:")
             (str-starts-with lower "https://gitlab.com/")
             (str-starts-with lower "git@gitlab.com:")))))

(defn api-connect-remote [remote-url expected-provider]
  (let [ref (str-trim (str remote-url))
        expected (str-to-lower (str-trim (str expected-provider)))
        detected (api-remote-provider ref)
        root-result (api-run "git rev-parse --show-toplevel")
        root (api-out root-result)
        origin-result (api-run "git remote get-url origin")]
    (if (not (api-remote-url-valid ref))
      {"ok" false "error" "GitHub, Forgejo, GitLab의 저장소 URL 또는 SSH alias만 허용합니다."}
      (if (and (not (= expected "")) (not (= expected detected)))
        {"ok" false "error" (str "현재 페이지는 " expected " 전용입니다. 입력한 Remote는 " detected " 형식입니다.")}
        (if (not (= (api-code root-result) 0))
        {"ok" false "error" "현재 선택된 폴더가 Git 저장소가 아닙니다."}
        (if (not (api-root-allowed root))
          {"ok" false "error" "허용된 폴더 밖의 저장소입니다."}
          (if (= (api-code origin-result) 0)
            {"ok" false "error" (str "이미 origin이 연결되어 있습니다: " (api-out origin-result))}
            (let [linked (api-run (str "git remote add origin " (api-shell-quote ref)))]
              (if (= (api-code linked) 0)
                (api-payload (str "Remote 연결 완료: " (api-remote-provider ref) "; Push는 실행하지 않았습니다."))
                {"ok" false "error" (or (get linked "stderr") "Remote 연결에 실패했습니다.")})))))))))

(defn api-provider-write-op? [op]
  (let [kind (str-to-lower (str-trim (str op)))]
    (or (= kind "connect") (= kind "fetch") (= kind "pull") (= kind "push"))))

(defn api-provider-write-target-from-info [info op]
  (let [full (or (get info "full_name")
                 (api-provider-full-name (or (get info "owner") "") (or (get info "repository") "")))]
    {"op" (str-to-lower (str-trim (str op)))
     "provider" (str (or (get info "provider") "none"))
     "host" (str (or (get info "host") ""))
     "owner" (str (or (get info "owner") ""))
     "repository" (str full)
     "branch" (str (or (get info "branch") ""))
     "upstream" (str (or (get info "upstream") ""))
     "remote" (str (or (get info "remote") ""))
     "name" (str (or (get info "name") ""))}))

(defn api-provider-write-display [target]
  {"provider" (or (get target "provider") "none")
   "repository" (or (get target "repository") "")
   "branch" (or (get target "branch") "")
   "upstream" (or (get target "upstream") "")
   "remote" (or (get target "remote") "")
   "op" (or (get target "op") "")})

(defn api-provider-write-confirm-message [target]
  (str (or (get target "op") "write") " 대상\n"
       "provider: " (or (get target "provider") "none") "\n"
       "repository: " (or (get target "repository") "") "\n"
       "branch: " (or (get target "branch") "") "\n"
       "실행하려면 confirm=true 가 필요합니다."))

(defn api-provider-write-gate [target expected-provider confirmed]
  (let [expected (str-to-lower (str-trim (str (or expected-provider ""))))
        provider (str-to-lower (str-trim (str (or (get target "provider") ""))))
        op (str-to-lower (str-trim (str (or (get target "op") ""))))
        display (api-provider-write-display target)]
    (cond
      (not (api-provider-write-op? op))
        {"ok" false "code" "REMOTE_WRITE_UNKNOWN_OP" "target" target "display" display
         "error" (str "지원하지 않는 쓰기 작업입니다: " op)}
      (or (= provider "") (= provider "none"))
        {"ok" false "code" "REMOTE_WRITE_NO_PROVIDER" "target" target "display" display
         "error" "연결된 provider remote가 없습니다."}
      (and (> (length expected) 0) (not (= expected provider)))
        {"ok" false "code" "REMOTE_WRITE_MISMATCH" "target" target "display" display
         "error" (str "현재 요청은 " expected " 전용입니다. 대상 provider는 " provider " 입니다.")}
      (not (= confirmed true))
        {"ok" false "code" "REMOTE_WRITE_CONFIRM_REQUIRED" "target" target "display" display
         "preview" true "error" (api-provider-write-confirm-message target)}
      true
        {"ok" true "code" "REMOTE_WRITE_READY" "target" target "display" display})))

(defn api-provider-write-current-target [op]
  (let [branch-result (api-run "git branch --show-current")
        remote-v-result (api-run "git remote -v")
        sync (api-sync-info)
        branch (api-out branch-result)
        remotes (api-remotes-from-remote-v (api-out remote-v-result) branch sync)
        info (if (> (length remotes) 0) (first remotes) (api-remote-info "" branch sync))]
    (api-provider-write-target-from-info info op)))

(defn api-provider-write-connect-target [remote-url branch]
  (let [info (api-remote-info remote-url branch {"upstream" "" "ahead" "" "behind" ""})]
    (api-provider-write-target-from-info info "connect")))

(defn api-provider-write-merge [payload gate message]
  (obj-merge payload
             {"write_code" (or (get gate "code") "")
              "target" (or (get gate "target") {})
              "display" (or (get gate "display") {})
              "message" (if (> (length (str-trim (str (or message "")))) 0)
                          message
                          (or (get payload "message") ""))}))

(defn api-provider-write [op expected-provider confirmed remote-url]
  (let [kind (str-to-lower (str-trim (str op)))
        expected (str-to-lower (str-trim (str (or expected-provider ""))))
        branch (api-out (api-run "git branch --show-current"))
        target (if (= kind "connect")
                 (api-provider-write-connect-target remote-url branch)
                 (api-provider-write-current-target kind))
        gate (api-provider-write-gate target expected confirmed)]
    (if (not (= (get gate "ok") true))
      gate
      (cond
        (= kind "connect")
          (let [connected (api-connect-remote remote-url expected)]
            (if (= (get connected "ok") true)
              (api-provider-write-merge connected gate (get connected "message"))
              (obj-merge connected {"code" "REMOTE_WRITE_FAIL" "target" target "display" (get gate "display")})))
        (= kind "fetch")
          (let [r (api-command "git fetch --all --prune")]
            (if (= (api-code r) 0)
              (api-provider-write-merge (api-payload "Fetch 완료") gate "Fetch 완료")
              {"ok" false "code" "REMOTE_WRITE_FAIL" "target" target "display" (get gate "display")
               "error" (or (get r "stderr") "Fetch 실패")}))
        (= kind "pull")
          (let [r (api-command "git pull")]
            (if (= (api-code r) 0)
              (api-provider-write-merge (api-payload "Pull 완료") gate "Pull 완료")
              {"ok" false "code" "REMOTE_WRITE_FAIL" "target" target "display" (get gate "display")
               "error" (or (get r "stderr") "Pull 실패") "conflicts" (api-conflict-files)}))
        (= kind "push")
          (let [r (api-command "git push")]
            (if (= (api-code r) 0)
              (api-provider-write-merge (api-payload "Push 완료") gate "Push 완료")
              {"ok" false "code" "REMOTE_WRITE_FAIL" "target" target "display" (get gate "display")
               "error" (or (get r "stderr") "Push 실패")}))
        true
          {"ok" false "code" "REMOTE_WRITE_UNKNOWN_OP" "error" (str "지원하지 않는 쓰기 작업: " kind)
           "target" target "display" (get gate "display")}))))

(defn api-continuity []
  (let [result (api-run "if test -f PROJECT-CONTINUITY.airc; then cat -- PROJECT-CONTINUITY.airc; else printf '{}'; fi")
        raw (api-out result)
        document (json_parse raw)
        identity (or (get document "identity") {})
        nodes (or (get document "nodes") {})
        hot (or (get document "hot") "")
        hot-node (or (get nodes hot) {})
        constitution (or (get document "constitution") {})
        handoff (or (get document "handoff") {})
        locks (or (get document "lock") [])]
    {"available" (> (length (or (get identity "what") "")) 0)
     "source" "PROJECT-CONTINUITY.airc"
     "identity" identity
     "constitution" constitution
     "hot" hot
     "hot_node" hot-node
     "locks" locks
     "handoff" handoff}))

(defn api-airc-documents []
  (map
    (fn [path]
      (let [result (api-command (str "cat -- " (api-shell-quote path)))
            content (api-out result)]
        {"path" path
         "available" (> (length content) 0)
         "content" content}))
    ["PROJECT-CONTINUITY.airc" "SPEC.airc"]))

(defn api-ai-search [query scope]
  (let [clean (str-trim (str query))
        requested (str-trim (str scope))
        selected (if (= requested "files") "files"
                   (if (= requested "history") "history"
                     (if (= requested "continuity") "continuity" "all")))]
    (if (= clean "")
      {"ok" false "error" "검색어가 필요합니다."}
      (let [file-result (if (or (= selected "files") (= selected "all"))
                          (api-command (str "git grep -n -I -F -- " (api-shell-quote clean) " -- . | head -n 80"))
                          {"code" 0 "stdout" "" "stderr" ""})
            history-result (if (or (= selected "history") (= selected "all"))
                             (api-command (str "git log --all --oneline --regexp-ignore-case --grep=" (api-shell-quote clean) " -n 40"))
                             {"code" 0 "stdout" "" "stderr" ""})
            continuity-result (if (or (= selected "continuity") (= selected "all"))
                               (api-command (str "if test -f PROJECT-CONTINUITY.airc; then grep -n -F -- " (api-shell-quote clean) " PROJECT-CONTINUITY.airc | head -n 80; fi"))
                               {"code" 0 "stdout" "" "stderr" ""})]
        {"ok" true
         "mode" "read-only"
         "query" clean
         "scope" selected
         "files" (api-out file-result)
         "history" (api-out history-result)
         "continuity" (api-out continuity-result)
         "ai_instruction" "검색 결과는 참고 자료입니다. 변경·커밋·Push·Pull은 이 검색 API에서 실행되지 않습니다."}))))

(defn api-context-json [root branch remote status log continuity risk remote-info remotes sync recent-commits]
  (json-stringify {"root" root "branch" branch "remote" remote "status" status "recent_log" log
                   "continuity" continuity "change_risk" risk
                   "remote_info" remote-info "remotes" remotes "sync" sync "recent_commits" recent-commits}))

(defn api-context-cards [root branch remote status diff commits github sync conflicts branches continuity risk remote-info]
  [{"number" "01" "key" "continuity:identity" "title" "프로젝트 정체성" "content" (if (= (get continuity "available") true) (str (get (get continuity "identity") "what") "\n이유: " (get (get continuity "identity") "why")) "AIRC 정본 없음")}
   {"number" "02" "key" "continuity:hot" "title" "현재 Hot 작업" "content" (if (= (get continuity "available") true) (str "hot=" (get continuity "hot") "\n" (get (get continuity "hot_node") "v") "\n검증: " (str-join (or (get (get continuity "hot_node") "check") []) "\n")) "AIRC 정본 없음")}
   {"number" "03" "key" "continuity:locks" "title" "계승 Lock" "content" (if (= (get continuity "available") true) (str-join (map (fn [item] (str "[" (get item "severity") "] " (get item "rule") " — " (get item "why"))) (or (get continuity "locks") [])) "\n") "AIRC 정본 없음")}
   {"number" "04" "key" "continuity:handoff" "title" "AI 인수인계" "content" (if (= (get continuity "available") true) (str-join [(get (get continuity "handoff") "step1") (get (get continuity "handoff") "step2") (get (get continuity "handoff") "step3") (get (get continuity "handoff") "step4") (get (get continuity "handoff") "step5") (get (get continuity "handoff") "step6")] "\n") "AIRC 정본 없음")}
   {"number" "05" "key" "ai:change-risk" "title" "변경 위험도" "content" (str "level=" (get risk "level") "\n" (get risk "reason") "\n변경 파일=" (get risk "file_count") " 민감 파일=" (get risk "sensitive_count") " 충돌=" (get risk "conflict_count"))}
   {"number" "06" "key" "repo:root" "title" "저장소 경로" "content" root}
   {"number" "07" "key" "repo:branch" "title" "현재 branch" "content" branch}
   {"number" "08" "key" "repo:remote" "title" "Remote" "content" (str (get remote-info "provider") " · " (or (get remote-info "full_name") (get remote-info "repository")) "\n" remote)}
   {"number" "09" "key" "repo:sync" "title" "HEAD Sync" "content" (str "match=" (get sync "match") "\nlocal_head=" (get sync "local_head") "\nremote_head=" (get sync "remote_head") "\nupstream=" (get sync "upstream") " ahead=" (get sync "ahead") " behind=" (get sync "behind"))}
   {"number" "10" "key" "changes:files" "title" "변경 파일" "content" (str-join (map (fn [file] (str (get file "kind") " " (get file "path"))) (or (api-status-files) [])) "\n")}
   {"number" "11" "key" "diff:current" "title" "현재 Diff" "content" diff}
   {"number" "12" "key" "remote:status" "title" "Remote Provider" "content" (str "provider=" (get remote-info "provider") " host=" (get remote-info "host") " auth=" (get remote-info "auth") " owner=" (get remote-info "owner") " repository=" (get remote-info "repository"))}
   {"number" "13" "key" "commits:recent" "title" "최근 커밋" "content" (str-join (map (fn [commit] (str (get commit "hash") " " (get commit "message"))) (or commits [])) "\n")}
   {"number" "14" "key" "remote:conflicts" "title" "충돌 파일" "content" (str-join (or conflicts []) "\n")}
   {"number" "15" "key" "repo:branches" "title" "Branch 목록" "content" (str-join (or branches []) "\n")}])

(defn api-context-markdown [cards]
  (str-join (map (fn [card] (str "## " (get card "number") " · " (get card "title") " [" (get card "key") "]\n" (or (get card "content") ""))) (or cards [])) "\n\n"))

(defn api-context-select [cards keys]
  (filter
    (fn [card]
      (> (length (filter (fn [key] (= key (get card "key"))) (or keys []))) 0))
    (or cards [])))

(defn api-commit-list []
  (let [result (api-run "git --no-pager log --date=short --pretty=format:'%H~%ad~%an~%s' -12")
        rows (filter (fn [row] (> (length (str-trim row)) 0)) (regex_split (api-out result) "\\n"))]
    (map (fn [row]
           (let [parts (regex_split row "~")]
             {"hash" (or (get parts 0) "")
              "date" (or (get parts 1) "")
              "author" (or (get parts 2) "")
             "message" (or (get parts 3) "")})) rows)))

(defn api-remote-provider [remote]
  (let [value (str-to-lower (str-trim (str remote)))]
    (cond
      (= value "") "none"
      (or (str-includes value "github.com") (str-starts-with value "github:")) "github"
      (or (str-includes value "fg.dclub.kr") (str-includes value "fg.dclub.jp") (str-starts-with value "forgejo-dclub:")) "forgejo"
      (or (str-includes value "gitlab.com") (str-starts-with value "gitlab:")) "gitlab"
      true "unknown")))

(defn api-provider-host [provider]
  (cond
    (= provider "github") "github.com"
    (= provider "forgejo") "fg.dclub.kr"
    (= provider "gitlab") "gitlab.com"
    true ""))

(defn api-provider-strip-git [name]
  (let [value (str-trim (str name))]
    (if (and (str-ends-with value ".git") (> (length value) 4))
      (substring value 0 (- (length value) 4))
      value)))

(defn api-provider-owner-token? [owner]
  (let [value (str-to-lower (str-trim (str owner)))]
    (and (> (length value) 0)
         (not (str-includes value "@"))
         (not (= value "https"))
         (not (= value "http"))
         (not (= value "ssh"))
         (not (= value "git"))
         (not (= value "github.com"))
         (not (= value "gitlab.com"))
         (not (= value "fg.dclub.kr"))
         (not (= value "fg.dclub.jp"))
         (not (= value "forgejo-dclub")))))

(defn api-provider-parse-owner-repo [remote]
  (let [clean (str-trim (str remote))
        parts (filter (fn [part] (> (length (str-trim part)) 0)) (regex_split clean "[/:]"))
        n (length parts)
        repo-raw (if (> n 0) (get parts (- n 1)) "")
        owner-raw (if (> n 1) (get parts (- n 2)) "")
        owner (str-trim (str owner-raw))]
    {"owner" (if (api-provider-owner-token? owner) owner "")
     "repository" (api-provider-strip-git repo-raw)}))

(defn api-provider-full-name [owner repository]
  (let [o (str-trim (str owner))
        r (str-trim (str repository))]
    (if (= o "")
      r
      (if (= r "") o (str o "/" r)))))

(defn api-remotes-from-remote-v [remote-v branch sync]
  (let [lines (filter (fn [line] (str-includes (str-to-lower line) "(fetch)"))
                      (filter (fn [line] (> (length (str-trim line)) 0))
                              (regex_split (str remote-v) "\n")))]
    (map (fn [line]
           (let [parts (filter (fn [part] (> (length (str-trim part)) 0)) (regex_split (str-trim line) "[ \t]+"))
                 name (if (> (length parts) 0) (str-trim (str (get parts 0))) "")
                 url (if (> (length parts) 1) (str-trim (str (get parts 1))) "")
                 info (api-remote-info url branch sync)]
             (assoc info "name" name)))
         lines)))

(defn api-remote-info [remote branch sync]
  (let [clean (str-trim (str remote))
        provider (api-remote-provider clean)
        parsed (api-provider-parse-owner-repo clean)
        owner (or (get parsed "owner") "")
        repository (or (get parsed "repository") "")
        auth (if (= clean "") "missing" "unknown")]
    {"provider" provider
     "host" (api-provider-host provider)
     "owner" owner
     "repository" repository
     "remote" clean
     "branch" branch
     "upstream" (or (get sync "upstream") "")
     "auth" auth
     "name" ""
     "ahead" (get sync "ahead")
     "behind" (get sync "behind")
     "configured" (> (length clean) 0)
     "full_name" (api-provider-full-name owner repository)}))

(defn api-github-info []
  (let [result (api-run "gh repo view --json nameWithOwner,isPrivate,defaultBranchRef,url,description")
        remote-result (api-run "git remote get-url origin")]
    (if (= (api-code result) 0)
      (let [info (json_parse (api-out result))]
        {"connected" true "name" (or (get info "nameWithOwner") "")
         "private" (or (get info "isPrivate") false)
         "default_branch" (or (get (get info "defaultBranchRef") "name") "")
         "url" (or (get info "url") "")
         "description" (or (get info "description") "")})
      {"connected" false "name" "" "private" false "default_branch" ""
       "url" (api-out remote-result) "description" "GitHub 저장소 정보를 불러오지 못했습니다."})))

(defn api-sync-info []
  (let [upstream-result (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
        upstream (if (= (api-code upstream-result) 0) (api-out upstream-result) "")
        local-result (api-run "git rev-parse HEAD")
        local-head (if (= (api-code local-result) 0) (api-out local-result) "")
        remote-result (if (= upstream "") {"code" 1 "stdout" ""} (api-run (str "git rev-parse " (api-shell-quote upstream))))
        remote-head (if (= (api-code remote-result) 0) (api-out remote-result) "")
        counts (api-run "git rev-list --left-right --count HEAD...@{upstream}")
        parts (regex_split (api-out counts) "[ \t]+")
        ahead (if (= (api-code counts) 0) (or (get parts 0) "0") "")
        behind (if (= (api-code counts) 0) (or (get parts 1) "0") "")]
    {"local_head" local-head
     "remote_head" remote-head
     "upstream" upstream
     "ahead" ahead
     "behind" behind
     "match" (and (> (length local-head) 0) (> (length remote-head) 0) (= local-head remote-head))}))

(defn api-conflict-files []
  (let [result (api-run "git diff --name-only --diff-filter=U")]
    (api-file-lines result)))

(defn api-branch-valid [name]
  (let [clean (str-trim (str name))
        result (if (= clean "") {"code" 1} (api-run (str "git check-ref-format --branch " (api-shell-quote clean))))]
    (and (> (length clean) 0) (= (api-code result) 0))))

(defn api-branch-list []
  (let [result (api-run "git branch --format='%(refname:short)'")]
    (api-file-lines result)))

(defn api-file-lines [result]
  (filter (fn [line] (> (length (str-trim line)) 0)) (regex_split (api-out result) "\\n")))

(defn api-path-lower [path]
  (str-to-lower (str-trim (str path))))

(defn api-sensitive-file [path]
  (let [clean (api-path-lower path)
        name (last (regex_split clean "/"))]
    (or (= name ".env")
        (str-starts-with name ".env.")
        (str-ends-with name ".env")
        (str-includes clean "/.env")
        (str-starts-with clean ".ssh/")
        (str-includes clean "/.ssh/")
        (str-starts-with clean ".aws/")
        (str-includes clean "/.aws/")
        (str-starts-with clean ".gnupg/")
        (str-includes clean "/.gnupg/")
        (= name ".netrc")
        (= name ".npmrc")
        (= name "credentials")
        (= name "credentials.json")
        (= name "credentials.xml")
        (str-starts-with name "service-account")
        (str-includes name "secret")
        (= name "id_rsa")
        (= name "id_dsa")
        (= name "id_ecdsa")
        (= name "id_ed25519")
        (= name "id_ed25519_sk")
        (str-ends-with name ".pem")
        (str-ends-with name ".key")
        (str-ends-with name ".p12")
        (str-ends-with name ".pfx")
        (str-ends-with name ".jks")
        (str-ends-with name ".keystore")
        (str-ends-with name ".ppk")
        (str-ends-with name ".kdbx"))))

(defn api-safe-file-path [path]
  (let [clean (str-trim (str path))]
    (and (> (length clean) 0)
         (not (str-starts-with clean "/"))
         (not (str-includes clean ".."))
         (not (str-includes clean "\\\\"))
         (not (api-sensitive-file clean)))))

(defn api-change-risk [files conflicts]
  (let [items (or files [])
        conflict-items (or conflicts [])
        sensitive (filter (fn [file] (api-sensitive-file (get file "path"))) items)
        file-count (length items)
        sensitive-count (length sensitive)
        conflict-count (length conflict-items)]
    {"level" (if (> conflict-count 0) "high"
               (if (> sensitive-count 0) "high"
                 (if (> file-count 0) "medium" "low")))
     "reason" (if (> conflict-count 0) "충돌 파일이 있어 먼저 충돌을 해결해야 합니다."
                 (if (> sensitive-count 0) "민감 파일 변경이 포함되어 내용을 확인한 뒤 승인해야 합니다."
                   (if (> file-count 0) "미커밋 변경이 있어 Diff 확인 후 작업해야 합니다." "작업 트리가 깨끗합니다.")))
     "file_count" file-count
     "sensitive_count" sensitive-count
     "conflict_count" conflict-count}))

(defn api-file-content [side path upstream]
  (let [clean (str-trim (str path))]
    (if (not (api-safe-file-path clean))
      {"ok" false "error" "보안상 열 수 없는 파일 경로입니다."}
      (let [target (if (= side "github") (str upstream ":" clean) clean)
            command (if (= side "github")
                      (str "git show --no-ext-diff --format= " (api-shell-quote target))
                      (str "head -c 200000 -- " (api-shell-quote target)))
            result (api-run command)]
        (if (not (= (api-code result) 0))
          {"ok" false "error" (or (get result "stderr") "파일 내용을 읽을 수 없습니다.")}
          {"ok" true "side" side "path" clean "upstream" upstream
           "content" (or (get result "stdout") "") "truncated" (> (length (or (get result "stdout") "")) 199999)})))))

(defn api-file-compare-content [path]
  (let [clean (str-trim (str path))
        branch-result (api-run "git branch --show-current")
        branch (api-out branch-result)
        upstream-result (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
        upstream (if (= (api-code upstream-result) 0) (api-out upstream-result) (if (= branch "") "origin/main" (str "origin/" branch)))]
    (if (not (api-safe-file-path clean))
      {"ok" false "error" "보안상 비교할 수 없는 파일 경로입니다."}
      {"ok" true "path" clean "upstream" upstream
       "server" (api-file-content "server" clean upstream)
       "github" (api-file-content "github" clean upstream)})))

(defn api-file-compare []
  (let [branch-result (api-run "git branch --show-current")
        branch (api-out branch-result)
        upstream-result (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
        upstream (if (= (api-code upstream-result) 0) (api-out upstream-result) (if (= branch "") "origin/main" (str "origin/" branch)))
        server-result (api-run "git ls-files -co --exclude-standard")
        github-result (api-run (str "git ls-tree -r --name-only " (api-shell-quote upstream)))]
    (if (not (= (api-code github-result) 0))
      {"ok" false "error" (or (get github-result "stderr") (str "GitHub 원격 브랜치를 읽을 수 없습니다: " upstream))}
      {"ok" true "branch" branch "upstream" upstream
       "server_files" (api-file-lines server-result)
       "github_files" (api-file-lines github-result)})))

(defn api-payload [message]
  (let [root-result (api-run "git rev-parse --show-toplevel")
        branch-result (api-run "git branch --show-current")
        remote-url-result (api-run "git remote get-url origin")
        remote-v-result (api-run "git remote -v")
        status-result (api-run "git status --short --branch")
        diff-result (api-run "git --no-pager diff --stat && git --no-pager diff")
        log-result (api-run "git --no-pager log --oneline --decorate -12")
        commits (api-commit-list)
        files (api-status-files)
        conflicts (api-conflict-files)
        branches (api-branch-list)
        github (api-github-info)
        sync (api-sync-info)
        continuity (api-continuity)
        airc-documents (api-airc-documents)
        risk (api-change-risk files conflicts)
        root (api-out root-result)
        branch (api-out branch-result)
        remote-v (api-out remote-v-result)
        remote (if (= (api-code remote-url-result) 0) (api-out remote-url-result) remote-v)
        status (api-out status-result)
        log (api-out log-result)
        remotes (api-remotes-from-remote-v remote-v branch sync)
        remote-info (if (> (length remotes) 0) (first remotes) (api-remote-info remote branch sync))
        context-cards (api-context-cards root branch remote status (api-out diff-result) commits github sync conflicts branches continuity risk remote-info)]
    {"ok" true "message" (or message "") "root" root "branch" branch
     "remote" remote "status" status "files" files "diff" (api-out diff-result) "log" log "commits" commits
     "recent_commits" commits
     "github" github "sync" sync "conflicts" conflicts "branches" branches
     "continuity" continuity "airc_documents" airc-documents "change_risk" risk
     "remote_info" remote-info "remotes" remotes
     "context_json" (api-context-json root branch remote status log continuity risk remote-info remotes sync commits)
     "context_cards" context-cards
     "context_available_keys" (map (fn [card] (get card "key")) context-cards)}))

(defn render [req]
  (server-json (api-payload "")))

(defn render_post [req]
  (let [body (or (get req "body") {})
        action (or (get body "action") "")]
    (cond
      (= action "list-folders")
        (server-json (api-list-folders (get body "path")))
      (= action "list-repos")
        (server-json (api-list-repos))
      (= action "provider-status")
        (server-json (api-provider-status (get body "provider")))
      (= action "provider-repos")
        (let [listed (api-provider-repos (get body "provider"))]
          (if (= (get listed "ok") true)
            (server-json listed)
            (server-json listed 400)))
      (= action "commit-detail")
        (let [hash (str-trim (str (get body "hash")))
              result (api-command (str "git --no-pager show --no-ext-diff --format=fuller --stat --patch " (api-shell-quote hash)))]
          (if (= (api-code result) 0)
            (server-json {"ok" true "hash" hash "detail" (get result "stdout")})
            (server-json {"ok" false "error" (or (get result "stderr") "커밋 상세 정보를 불러오지 못했습니다.")} 400)))
      (= action "compare-files")
        (server-json (api-file-compare))
      (= action "file-content")
        (let [branch-result (api-run "git branch --show-current")
              branch (api-out branch-result)
              upstream-result (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
              upstream (if (= (api-code upstream-result) 0) (api-out upstream-result) (if (= branch "") "origin/main" (str "origin/" branch)))]
          (server-json (api-file-content (get body "side") (get body "path") upstream)))
      (= action "compare-file-content")
        (server-json (api-file-compare-content (get body "path")))
      (= action "context")
        (let [snapshot (api-payload "")
              cards (api-context-select (get snapshot "context_cards") (get body "keys"))]
          (server-json {"ok" true "cards" cards
                        "available_keys" (get snapshot "context_available_keys")
                        "markdown" (api-context-markdown cards)
                        "ai_instruction" "선택한 카드만 기준으로 답변하세요."}))
      (= action "ai-context")
        (let [snapshot (api-payload "")
              cards (get snapshot "context_cards")]
          (server-json {"ok" true
                        "mode" "read-only"
                        "source" "fl-git"
                        "continuity" (get snapshot "continuity")
                        "change_risk" (get snapshot "change_risk")
                        "remote_info" (get snapshot "remote_info")
                        "remotes" (get snapshot "remotes")
                        "sync" (get snapshot "sync")
                        "recent_commits" (get snapshot "recent_commits")
                        "available_keys" (get snapshot "context_available_keys")
                        "cards" cards
                        "markdown" (api-context-markdown cards)
                        "ai_instruction" "이 응답은 현재 저장소와 AIRC 정본의 읽기 전용 상태입니다. remote_info.provider로 GitHub와 Forgejo를 구분하세요. 변경 작업은 사용자 승인과 별도 UI 작업을 거친 뒤에만 실행하세요."}))
      (= action "ai-search")
        (let [result (api-ai-search (get body "query") (get body "scope"))]
          (if (= (get result "ok") true)
            (server-json result)
            (server-json result 400)))
      (= action "project-setup")
        (let [created (api-project-setup (get body "parent") (get body "name") (get body "github_name") (get body "visibility") (get body "readme") (get body "gitignore_template") (get body "initial_push"))]
          (if (= (get created "ok") true)
            (server-json (api-payload (get created "message")))
            (server-json created 400)))
      (= action "connect-github")
        (let [connected (api-connect-github (get body "github_ref") (get body "visibility") (get body "initial_push"))]
          (if (= (get connected "ok") true)
            (server-json connected)
            (server-json connected 400)))
      (= action "provider-write")
        (let [written (api-provider-write (get body "op") (get body "provider") (get body "confirm") (get body "remote_url"))]
          (if (= (get written "ok") true)
            (server-json written)
            (server-json written 400)))
      (= action "connect-remote")
        (let [written (api-provider-write "connect" (get body "provider") (get body "confirm") (get body "remote_url"))]
          (if (= (get written "ok") true)
            (server-json written)
            (server-json written 400)))
      (= action "create-repo")
        (let [created (api-create-repo (get body "parent") (get body "name"))]
          (if (= (get created "ok") true)
            (server-json (api-payload "새 저장소를 만들었습니다."))
            (server-json created 400)))
      (= action "select-repo")
        (let [selected (api-select-repo (get body "path"))]
          (if (= (get selected "ok") true)
            (server-json (api-payload "저장소를 전환했습니다."))
            (server-json selected 400)))
      (= action "add-all")
        (let [r (api-command "git add -- .")]
          (if (= (api-code r) 0) (server-json (api-payload "전체 파일을 Stage했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "unstage-all")
        (let [r (api-command "git reset -- .")]
          (if (= (api-code r) 0) (server-json (api-payload "Stage를 취소했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "stage-file")
        (let [path (str-trim (str (get body "path")))]
          (if (not (api-safe-git-path path))
            (server-json {"ok" false "error" "안전하지 않은 파일 경로입니다."} 400)
            (let [r (api-command (str "git add -- " (api-shell-quote path)))]
              (if (= (api-code r) 0) (server-json (api-payload "파일을 Stage했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))))
      (= action "unstage-file")
        (let [path (str-trim (str (get body "path")))]
          (if (not (api-safe-git-path path))
            (server-json {"ok" false "error" "안전하지 않은 파일 경로입니다."} 400)
            (let [r (api-command (str "git reset -- " (api-shell-quote path)))]
              (if (= (api-code r) 0) (server-json (api-payload "파일의 Stage를 취소했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))))
      (= action "stage-files")
        (let [r (api-file-command "add" (get body "paths"))]
          (if (= (api-code r) 0) (server-json (api-payload "선택한 파일을 Stage했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "unstage-files")
        (let [r (api-file-command "reset" (get body "paths"))]
          (if (= (api-code r) 0) (server-json (api-payload "선택한 파일의 Stage를 취소했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "create-branch")
        (let [name (str-trim (str (get body "name")))]
          (if (not (api-branch-valid name))
            (server-json {"ok" false "error" "유효하지 않은 branch 이름입니다."} 400)
            (let [r (api-command (str "git switch -c " (api-shell-quote name)))]
              (if (= (api-code r) 0) (server-json (api-payload (str "branch를 생성하고 전환했습니다: " name))) (server-json {"ok" false "error" (or (get r "stderr") "branch 생성에 실패했습니다.")} 400)))))
      (= action "switch-branch")
        (let [name (str-trim (str (get body "name")))]
          (if (not (api-branch-valid name))
            (server-json {"ok" false "error" "유효하지 않은 branch 이름입니다."} 400)
            (let [r (api-command (str "git switch -- " (api-shell-quote name)))]
              (if (= (api-code r) 0) (server-json (api-payload (str "branch를 전환했습니다: " name))) (server-json {"ok" false "error" (or (get r "stderr") "branch 전환에 실패했습니다.")} 400)))))
      (= action "fetch")
        (let [written (api-provider-write "fetch" (get body "provider") (get body "confirm") "")]
          (if (= (get written "ok") true)
            (server-json written)
            (server-json written 400)))
      (= action "pull")
        (let [written (api-provider-write "pull" (get body "provider") (get body "confirm") "")]
          (if (= (get written "ok") true)
            (server-json written)
            (server-json written 400)))
      (= action "push")
        (let [written (api-provider-write "push" (get body "provider") (get body "confirm") "")]
          (if (= (get written "ok") true)
            (server-json written)
            (server-json written 400)))
      (= action "commit")
        (let [message (str-trim (or (get body "message") ""))]
          (if (= message "")
            (server-json {"ok" false "error" "커밋 메시지가 필요합니다."} 400)
            (let [r (api-command (str "git commit -m " (api-shell-quote message)))]
              (if (= (api-code r) 0)
                (server-json (api-payload "커밋 완료"))
                (server-json {"ok" false "error" (or (get r "stderr") (get r "stdout"))} 400)))))
      (= action "commit-selected")
        (let [r (api-commit-selected (get body "message") (get body "paths"))]
          (if (= (api-code r) 0)
            (server-json (api-payload "선택한 파일을 커밋했습니다."))
            (server-json {"ok" false "error" (or (get r "stderr") (get r "stdout"))} 400)))
      (= action "commit-push")
        (if (= (get body "confirm") true)
          (let [message (str-trim (or (get body "message") ""))]
            (if (= message "")
              (server-json {"ok" false "error" "커밋 메시지가 필요합니다."} 400)
              (let [commit-result (api-command (str "git commit -m " (api-shell-quote message)))]
                (if (not (= (api-code commit-result) 0))
                  (server-json {"ok" false "error" (or (get commit-result "stderr") (get commit-result "stdout"))} 400)
                  (let [push-result (api-command "git push")]
                    (if (= (api-code push-result) 0)
                      (server-json (api-payload "커밋 및 Push 완료"))
                      (server-json {"ok" false "committed" true "error" (str "커밋은 완료됐지만 Push에 실패했습니다: " (or (get push-result "stderr") (get push-result "stdout")))} 400)))))))
          (server-json {"ok" false "error" "Commit & Push는 confirm=true가 필요합니다."} 400))
      true (server-json {"ok" false "error" (str "알 수 없는 action: " action)} 400))))
