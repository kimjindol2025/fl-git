; fl-git 웹 API — 선택된 Git 저장소에서만 명령을 실행한다.

(define fl-git-repo (atom (or (fl-env-get "FL_GIT_REPO") "/home/kim/kim/projects/fl-git")))
(define fl-git-roots (or (fl-env-get "FL_GIT_ROOTS") "/home/kim/kim/projects"))

(defn api-shell-quote [value]
  (str "'" (str-replace-in (str value) "'" "'\\''") "'"))

(defn api-run-at [repo command]
  (shell_capture (str "cd " (api-shell-quote repo) " && " command)))

(defn api-run [command]
  (api-run-at (deref fl-git-repo) command))

(defn api-out [result]
  (str-trim (or (get result "stdout") "")))

(defn api-code [result]
  (or (get result "code") -1))

(defn api-command [command]
  (let [result (api-run command)]
    {"stdout" (or (get result "stdout") "")
     "stderr" (or (get result "stderr") "")
     "code" (api-code result)}))

(defn api-root-allowed [root]
  (or (= (str-trim fl-git-roots) "*")
      (> (length
           (filter
             (fn [allowed]
               (let [base (str-trim allowed)]
                 (or (= root base) (str-starts-with root (str base "/")))))
             (regex_split fl-git-roots ":")))
         0)))

(defn api-select-repo [requested]
  (let [path (str-trim (str requested))
        result (api-run-at path "git rev-parse --show-toplevel")
        root (api-out result)]
    (if (not (= (api-code result) 0))
      {"ok" false "error" "선택한 폴더가 Git 저장소가 아닙니다."}
      (if (not (api-root-allowed root))
        {"ok" false "error" (str "허용된 폴더 밖의 저장소입니다. 허용 범위: " fl-git-roots)}
        (do (reset! fl-git-repo root) {"ok" true "root" root})))))

(defn api-list-folders [requested]
  (let [candidate (str-trim (str (or requested "")))
        base (if (= candidate "") (first (regex_split fl-git-roots ":")) candidate)
        result (api-run-at base "pwd -P")
        root (api-out result)]
    (if (not (= (api-code result) 0))
      {"ok" false "error" "폴더를 읽을 수 없습니다."}
      (if (not (api-root-allowed root))
        {"ok" false "error" (str "허용된 폴더 밖입니다. 허용 범위: " fl-git-roots)}
        (let [entries (api-run-at root "find . -mindepth 1 -maxdepth 1 -type d -printf '%f\\n' | sort")
              names (filter (fn [name] (> (length (str-trim name)) 0)) (regex_split (api-out entries) "\\n"))]
          {"ok" true "root" root
           "folders" (map (fn [name] (str root "/" (str-trim name))) names)})))))

(defn api-repo-paths [base names]
  (map (fn [name] (str-replace-in (str base "/" (str-replace-in (str-trim name) "./" "") "/") "/.git/" "")) names))

(defn api-list-repos []
  (let [roots (filter (fn [root] (> (length (str-trim root)) 0)) (regex_split fl-git-roots ":"))
        repos (reduce
                (fn [acc root]
                  (let [base (str-trim root)
                        result (api-run-at base "find . -type d -name .git -prune -print | sort")
                        names (filter (fn [name] (> (length (str-trim name)) 0)) (regex_split (api-out result) "\\n"))]
                    (concat acc (api-repo-paths base names))))
                [] roots)]
    {"ok" true "roots" roots "repositories" repos}))

(defn api-create-repo [parent name]
  (let [base (str-trim (str parent))
        repo-name (str-trim (str name))
        resolved (api-run-at base "pwd -P")
        root (api-out resolved)
        target (str root "/" repo-name)]
    (if (= repo-name "")
      {"ok" false "error" "새 저장소 이름을 입력하세요."}
      (if (or (= repo-name ".") (= repo-name "..") (str-includes repo-name "/"))
        {"ok" false "error" "저장소 이름에는 경로 구분자를 사용할 수 없습니다."}
        (if (not (= (api-code resolved) 0))
          {"ok" false "error" "상위 폴더를 읽을 수 없습니다."}
          (if (not (api-root-allowed root))
            {"ok" false "error" (str "허용된 폴더 밖입니다. 허용 범위: " fl-git-roots)}
            (let [created (api-run-at root (str "mkdir -p -- " (api-shell-quote repo-name) " && git init -q -- " (api-shell-quote repo-name)))]
              (if (= (api-code created) 0)
                (do (reset! fl-git-repo target) {"ok" true "root" target})
                {"ok" false "error" (or (get created "stderr") "저장소를 만들 수 없습니다.")}))))))))

(defn api-project-setup [parent name github-name visibility]
  (let [base (str-trim (str parent))
        project-name (str-trim (str name))
        gh-name (str-trim (str (or github-name "")))
        resolved (api-run-at base "pwd -P")
        root (api-out resolved)
        target (str root "/" project-name)
        visibility-flag (if (= visibility "public") "--public" "--private")]
    (if (or (= project-name "") (= project-name ".") (= project-name "..") (str-includes project-name "/"))
      {"ok" false "error" "프로젝트 이름을 확인하세요. 경로 구분자는 사용할 수 없습니다."}
      (if (or (str-starts-with gh-name "-") (str-includes gh-name " "))
        {"ok" false "error" "GitHub 저장소 이름을 확인하세요."}
      (if (not (= (api-code resolved) 0))
        {"ok" false "error" "상위 폴더를 읽을 수 없습니다."}
        (if (not (api-root-allowed root))
          {"ok" false "error" (str "허용된 폴더 밖입니다. 허용 범위: " fl-git-roots)}
          (let [created (api-run-at root (str "test ! -e " (api-shell-quote project-name) " && mkdir -p -- " (api-shell-quote project-name) " && git init -q -- " (api-shell-quote project-name)))]
            (if (not (= (api-code created) 0))
              {"ok" false "error" "프로젝트 폴더가 이미 존재하거나 생성할 수 없습니다."}
              (if (= gh-name "")
                (do (reset! fl-git-repo target) {"ok" true "root" target "message" "로컬 Git 프로젝트를 만들었습니다."})
                (let [linked (api-run-at root (str "gh repo create " (api-shell-quote gh-name) " " visibility-flag " --source " (api-shell-quote target) " --remote origin"))]
                  (if (= (api-code linked) 0)
                    (do (reset! fl-git-repo target) {"ok" true "root" target "message" "로컬 Git과 GitHub 저장소를 연결했습니다."})
                    {"ok" false "error" (or (get linked "stderr") "GitHub 저장소 연결에 실패했습니다.")})))))))))))

(defn api-context-json [root branch remote status log]
  (json-stringify {"root" root "branch" branch "remote" remote "status" status "recent_log" log}))

(defn api-commit-list []
  (let [result (api-run "git --no-pager log --date=short --pretty=format:'%H~%ad~%an~%s' -12")
        rows (filter (fn [row] (> (length (str-trim row)) 0)) (regex_split (api-out result) "\\n"))]
    (map (fn [row]
           (let [parts (regex_split row "~")]
             {"hash" (or (get parts 0) "")
              "date" (or (get parts 1) "")
              "author" (or (get parts 2) "")
              "message" (or (get parts 3) "")})) rows)))

(defn api-github-info []
  (let [result (api-run "gh repo view --json nameWithOwner,isPrivate,defaultBranchRef,url,description")
        remote-result (api-run "git remote get-url origin")]
    (if (= (api-code result) 0)
      (let [info (json_parse (api-out result))]
        {"connected" true "name" (or (get info "nameWithOwner") "")
         "private" (or (get info "isPrivate") false)
         "default_branch" (or (get (get info "defaultBranchRef") "name") "")
         "url" (or (get info "url") "")
         "description" (or (get info "description") "")})
      {"connected" false "name" "" "private" false "default_branch" ""
       "url" (api-out remote-result) "description" "GitHub 저장소 정보를 불러오지 못했습니다."})))

(defn api-sync-info []
  (let [upstream (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
        counts (api-run "git rev-list --left-right --count HEAD...@{upstream}")
        parts (regex_split (api-out counts) " ")]
    {"upstream" (if (= (api-code upstream) 0) (api-out upstream) "")
     "ahead" (if (= (api-code counts) 0) (or (get parts 0) "0") "—")
     "behind" (if (= (api-code counts) 0) (or (get parts 1) "0") "—")}))

(defn api-file-lines [result]
  (filter (fn [line] (> (length (str-trim line)) 0)) (regex_split (api-out result) "\\n")))

(defn api-safe-file-path [path]
  (let [clean (str-trim (str path))]
    (and (> (length clean) 0)
         (not (str-starts-with clean "/"))
         (not (str-includes clean ".."))
         (not (str-includes clean "\\\\"))
         (not (= clean ".env"))
         (not (str-starts-with clean ".env/"))
         (not (str-includes clean "/.env"))
         (not (str-includes clean "id_rsa"))
         (not (str-includes clean ".pem"))
         (not (str-includes clean ".key")))))

(defn api-file-content [side path upstream]
  (let [clean (str-trim (str path))]
    (if (not (api-safe-file-path clean))
      {"ok" false "error" "보안상 열 수 없는 파일 경로입니다."}
      (let [target (if (= side "github") (str upstream ":" clean) clean)
            command (if (= side "github")
                      (str "git show --no-ext-diff --format= " (api-shell-quote target))
                      (str "head -c 200000 -- " (api-shell-quote target)))
            result (api-run command)]
        (if (not (= (api-code result) 0))
          {"ok" false "error" (or (get result "stderr") "파일 내용을 읽을 수 없습니다.")}
          {"ok" true "side" side "path" clean "upstream" upstream
           "content" (or (get result "stdout") "") "truncated" (> (length (or (get result "stdout") "")) 199999)})))))

(defn api-file-compare []
  (let [branch-result (api-run "git branch --show-current")
        branch (api-out branch-result)
        upstream-result (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
        upstream (if (= (api-code upstream-result) 0) (api-out upstream-result) (if (= branch "") "origin/main" (str "origin/" branch)))
        server-result (api-run "git ls-files -co --exclude-standard")
        github-result (api-run (str "git ls-tree -r --name-only " (api-shell-quote upstream)))]
    (if (not (= (api-code github-result) 0))
      {"ok" false "error" (or (get github-result "stderr") (str "GitHub 원격 브랜치를 읽을 수 없습니다: " upstream))}
      {"ok" true "branch" branch "upstream" upstream
       "server_files" (api-file-lines server-result)
       "github_files" (api-file-lines github-result)})))

(defn api-payload [message]
  (let [root-result (api-run "git rev-parse --show-toplevel")
        branch-result (api-run "git branch --show-current")
        remote-result (api-run "git remote -v")
        status-result (api-run "git status --short --branch")
        diff-result (api-run "git --no-pager diff --stat && git --no-pager diff")
        log-result (api-run "git --no-pager log --oneline --decorate -12")
        commits (api-commit-list)
        github (api-github-info)
        sync (api-sync-info)
        root (api-out root-result)
        branch (api-out branch-result)
        remote (api-out remote-result)
        status (api-out status-result)
        log (api-out log-result)]
    {"ok" true "message" (or message "") "root" root "branch" branch
     "remote" remote "status" status "diff" (api-out diff-result) "log" log "commits" commits
     "github" github "sync" sync
     "context_json" (api-context-json root branch remote status log)}))

(defn render [req]
  (server-json (api-payload "")))

(defn render_post [req]
  (let [body (or (get req "body") {})
        action (or (get body "action") "")]
    (cond
      (= action "list-folders")
        (server-json (api-list-folders (get body "path")))
      (= action "list-repos")
        (server-json (api-list-repos))
      (= action "commit-detail")
        (let [hash (str-trim (str (get body "hash")))
              result (api-command (str "git --no-pager show --no-ext-diff --format=fuller --stat --patch " (api-shell-quote hash)))]
          (if (= (api-code result) 0)
            (server-json {"ok" true "hash" hash "detail" (get result "stdout")})
            (server-json {"ok" false "error" (or (get result "stderr") "커밋 상세 정보를 불러오지 못했습니다.")} 400)))
      (= action "compare-files")
        (server-json (api-file-compare))
      (= action "file-content")
        (let [branch-result (api-run "git branch --show-current")
              branch (api-out branch-result)
              upstream-result (api-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")
              upstream (if (= (api-code upstream-result) 0) (api-out upstream-result) (if (= branch "") "origin/main" (str "origin/" branch)))]
          (server-json (api-file-content (get body "side") (get body "path") upstream)))
      (= action "project-setup")
        (let [created (api-project-setup (get body "parent") (get body "name") (get body "github_name") (get body "visibility"))]
          (if (= (get created "ok") true)
            (server-json (api-payload (get created "message")))
            (server-json created 400)))
      (= action "create-repo")
        (let [created (api-create-repo (get body "parent") (get body "name"))]
          (if (= (get created "ok") true)
            (server-json (api-payload "새 저장소를 만들었습니다."))
            (server-json created 400)))
      (= action "select-repo")
        (let [selected (api-select-repo (get body "path"))]
          (if (= (get selected "ok") true)
            (server-json (api-payload "저장소를 전환했습니다."))
            (server-json selected 400)))
      (= action "add-all")
        (let [r (api-command "git add -- .")]
          (if (= (api-code r) 0) (server-json (api-payload "전체 파일을 Stage했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "unstage-all")
        (let [r (api-command "git reset -- .")]
          (if (= (api-code r) 0) (server-json (api-payload "Stage를 취소했습니다.")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "fetch")
        (let [r (api-command "git fetch --all --prune")]
          (if (= (api-code r) 0) (server-json (api-payload "Fetch 완료")) (server-json {"ok" false "error" (get r "stderr")} 400)))
      (= action "pull")
        (if (= (get body "confirm") true)
          (let [r (api-command "git pull")]
            (if (= (api-code r) 0) (server-json (api-payload "Pull 완료")) (server-json {"ok" false "error" (get r "stderr")} 400)))
          (server-json {"ok" false "error" "Pull은 confirm=true가 필요합니다."} 400))
      (= action "push")
        (if (= (get body "confirm") true)
          (let [r (api-command "git push")]
            (if (= (api-code r) 0) (server-json (api-payload "Push 완료")) (server-json {"ok" false "error" (get r "stderr")} 400)))
          (server-json {"ok" false "error" "Push는 confirm=true가 필요합니다."} 400))
      (= action "commit")
        (let [message (str-trim (or (get body "message") ""))]
          (if (= message "")
            (server-json {"ok" false "error" "커밋 메시지가 필요합니다."} 400)
            (let [r (api-command (str "git commit -m " (api-shell-quote message)))]
              (if (= (api-code r) 0)
                (server-json (api-payload "커밋 완료"))
                (server-json {"ok" false "error" (or (get r "stderr") (get r "stdout"))} 400)))))
      (= action "commit-push")
        (let [message (str-trim (or (get body "message") ""))]
          (if (= message "")
            (server-json {"ok" false "error" "커밋 메시지가 필요합니다."} 400)
            (let [commit-result (api-command (str "git commit -m " (api-shell-quote message)))]
              (if (not (= (api-code commit-result) 0))
                (server-json {"ok" false "error" (or (get commit-result "stderr") (get commit-result "stdout"))} 400)
                (let [push-result (api-command "git push")]
                  (if (= (api-code push-result) 0)
                    (server-json (api-payload "커밋 및 Push 완료"))
                    (server-json {"ok" false "committed" true "error" (str "커밋은 완료됐지만 Push에 실패했습니다: " (or (get push-result "stderr") (get push-result "stdout")))} 400)))))))
      true (server-json {"ok" false "error" (str "알 수 없는 action: " action)} 400))))
