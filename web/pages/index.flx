<style>.rail-repo-toolbar{display:flex;align-items:center;justify-content:space-between;margin:0 0 10px;padding:0 8px}.rail-section-label{color:var(--muted);font:10px ui-monospace,monospace;letter-spacing:.12em}.rail-refresh{border:1px solid var(--line);background:#182235;color:var(--blue);border-radius:7px;width:28px;height:26px;cursor:pointer}.rail-refresh:hover{border-color:var(--blue);color:var(--text)}.rail-repositories{display:flex;flex-direction:column;gap:4px;max-height:310px;overflow:auto;padding-right:2px}.rail-repo{display:flex;align-items:center;gap:7px;width:100%;min-width:0;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--muted);padding:9px 8px;text-align:left;cursor:pointer;font:11px ui-monospace,monospace}.rail-repo:hover{background:#182235;border-color:var(--line);color:var(--text)}.rail-repo.active{background:#1d2b46;border-color:#365274;color:var(--text)}.rail-repo-dot{flex:0 0 12px;color:var(--blue)}.rail-repo-path{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rail-empty{color:var(--muted);font-size:11px;line-height:1.6;padding:10px 8px 16px}.rail-current{margin-top:18px;padding:14px 8px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);min-width:0}.rail-current strong{display:block;margin-top:8px;color:var(--text);font:11px ui-monospace,monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rail-github{display:block;margin-top:9px;color:var(--muted);font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rail-github.connected{color:var(--green)}.change-summary{color:var(--muted);font-size:11px}.change-list{margin-top:14px;max-height:520px;overflow:auto}.change-group{margin-bottom:14px}.change-group-heading{display:flex;justify-content:space-between;align-items:center;padding:8px 10px;background:#0d131d;border:1px solid var(--line);border-radius:8px 8px 0 0;color:var(--muted);font-size:11px}.change-group-heading strong{color:var(--text);font-size:12px