; fl-git 웹 UI — 브라우저에서 Git 상태를 보고 작업한다.

(island FlGitApp []
  (let [data (atom nil)
        loaded (atom false)
        tab (atom "overview")
        repo-input (atom "")
        folders (atom [])
        repositories (atom [])
        new-repo-name (atom "")
        commit-message (atom "")
        commit-detail (atom nil)
        file-compare (atom nil)
        file-view (atom nil)
        compare-view (atom nil)
        selected-files (atom [])
        right-open (atom true)
        project-parent (atom "/home/kim/kim/projects")
        project-name (atom "")
        project-github (atom "")
        project-visibility (atom "private")
        project-readme (atom true)
        project-gitignore (atom "next")
        project-initial-push (atom true)
        project-folders (atom [])
        connect-github-ref (atom "")
        connect-visibility (atom "private")
        connect-initial-push (atom true)
        notice (atom "")
        error (atom "")
        apply-result (fn [res]
                       (if (= (get res "ok") false)
                         (reset! error (or (get res "error") "요청 실패"))
                         (do (reset! data res) (reset! selected-files []) (reset! repo-input (or (get res "root") @repo-input)) (reset! error "") (reset! notice (or (get res "message") "완료")))))
        reload (fn [res]
                 (if (= (get res "ok") false)
                   (reset! error (or (get res "error") "상태를 불러오지 못했습니다"))
                   (do (reset! data res) (reset! repo-input (or (get res "root") @repo-input)) (reset! error ""))))
        send (fn [payload] (fetch-post! "/api" payload apply-result))
        compare-result (fn [res]
                         (if (= (get res "ok") false)
                           (reset! error (or (get res "error") "파일 비교 정보를 불러오지 못했습니다"))
                           (do (reset! file-compare res) (reset! error "") (reset! notice "서버와 GitHub 파일 목록을 불러왔습니다."))))
        open-compare (fn [] (do (reset! tab "compare") (reset! notice "파일 비교 준비 중…") (fetch-post! "/api" {"action" "compare-files"} compare-result)))
        file-view-result (fn [res]
                           (if (= (get res "ok") false)
                             (reset! error (or (get res "error") "파일 내용을 불러오지 못했습니다"))
                             (do (reset! file-view res) (reset! error "") (reset! notice "파일 내용을 불러왔습니다."))))
        open-file (fn [side path]
                    (do (reset! notice "파일 내용을 불러오는 중…")
                        (fetch-post! "/api" {"action" "file-content" "side" side "path" path} file-view-result)))
        compare-file-result (fn [res]
                              (if (= (get res "ok") false)
                                (reset! error (or (get res "error") "좌우 파일을 불러오지 못했습니다"))
                                (do (reset! compare-view res) (reset! error "") (reset! notice "서버와 GitHub 파일을 불러왔습니다."))))
        open-file-compare (fn [path]
                           (do (reset! notice "서버와 GitHub 파일을 비교하는 중…")
                               (fetch-post! "/api" {"action" "compare-file-content" "path" path} compare-file-result)))
        project-browse-result (fn [res]
                                (if (= (get res "ok") false)
                                  (reset! error (or (get res "error") "상위 폴더를 불러오지 못했습니다"))
                                  (do (reset! project-folders (or (get res "folders") [])) (reset! error "") (reset! notice "상위 폴더 목록을 불러왔습니다."))))
        browse-project-folders (fn [] (fetch-post! "/api" {"action" "list-folders" "path" @project-parent} project-browse-result))
        setup-project-result (fn [res]
                               (if (= (get res "ok") false)
                                 (reset! error (or (get res "error") "프로젝트를 만들지 못했습니다"))
                                 (do (reset! project-folders []) (reset! project-name "") (reset! project-github "") (reset! tab "overview") (apply-result res))))
        setup-project (fn []
                        (if (or (= (str-trim @project-parent) "") (= (str-trim @project-name) ""))
                          (reset! error "상위 폴더와 프로젝트 이름을 입력하세요")
                          (if (js_confirm "새 로컬 Git 프로젝트를 만들고 설정할까요?")
                            (do (reset! notice "프로젝트 초기화 및 GitHub 연결 중…") (fetch-post! "/api" {"action" "project-setup" "parent" @project-parent "name" @project-name "github_name" @project-github "visibility" @project-visibility "readme" @project-readme "gitignore_template" @project-gitignore "initial_push" @project-initial-push} setup-project-result))
                            nil)))
        connect-github-result (fn [res]
                               (if (= (get res "ok") false)
                                 (reset! error (or (get res "error") "GitHub 연결에 실패했습니다"))
                                 (do (reset! connect-github-ref "") (reset! tab "overview") (apply-result res))))
        connect-github (fn []
                         (if (= (str-trim @connect-github-ref) "")
                           (reset! error "GitHub 저장소 이름 또는 URL을 입력하세요")
                           (if (js_confirm "현재 저장소를 GitHub에 연결할까요?")
                             (do (reset! notice "GitHub 연결 및 Push 중…") (fetch-post! "/api" {"action" "connect-github" "github_ref" @connect-github-ref "visibility" @connect-visibility "initial_push" @connect-initial-push} connect-github-result))
                             nil)))
        commit-detail-result (fn [res]
                               (if (= (get res "ok") false)
                                 (reset! error (or (get res "error") "커밋 상세 정보를 불러오지 못했습니다"))
                                 (reset! commit-detail res)))
        browse-result (fn [res]
                        (if (= (get res "ok") false)
                          (reset! error (or (get res "error") "폴더를 불러오지 못했습니다"))
                          (do (reset! folders (or (get res "folders") [])) (reset! repositories []) (reset! repo-input (or (get res "root") @repo-input)) (reset! error "") (reset! notice "폴더 목록을 불러왔습니다."))))
        browse-folders (fn [] (fetch-post! "/api" {"action" "list-folders" "path" @repo-input} browse-result))
        repo-result (fn [res]
                      (if (= (get res "ok") false)
                        (reset! error (or (get res "error") "저장소 목록을 불러오지 못했습니다"))
                        (do (reset! repositories (or (get res "repositories") [])) (reset! folders []) (reset! error "") (reset! notice "서버 저장소 목록을 불러왔습니다."))))
        browse-repositories (fn [] (fetch-post! "/api" {"action" "list-repos"} repo-result))
        create-repo (fn []
                      (if (= (str-trim @new-repo-name) "")
                        (reset! error "새 저장소 이름을 입력하세요")
                        (do (reset! notice "저장소 생성 중…") (fetch-post! "/api" {"action" "create-repo" "parent" @repo-input "name" @new-repo-name} apply-result) (reset! new-repo-name ""))))
        do-action (fn [action]
                    (if (or (= action "push") (= action "pull"))
                      (if (js_confirm (str action "은 원격 저장소를 변경합니다. 실행할까요?"))
                        (do (reset! notice "실행 중…") (send {"action" action "confirm" true}))
                        nil)
                      (do (reset! notice "실행 중…") (send {"action" action}))))
        commit (fn []
                 (if (= (str-trim @commit-message) "")
                   (reset! error "커밋 메시지를 입력하세요")
                   (do (send {"action" "commit" "message" @commit-message}) (reset! commit-message ""))))
        commit-push (fn []
                      (if (= (str-trim @commit-message) "")
                        (reset! error "커밋 메시지를 입력하세요")
                        (if (js_confirm "커밋 후 원격 저장소로 Push할까요?")
                          (do (reset! notice "커밋 및 Push 실행 중…") (send {"action" "commit-push" "message" @commit-message "confirm" true}) (reset! commit-message ""))
                          nil)))
        file-selected? (fn [path]
                         (> (length (filter (fn [item] (= item path)) @selected-files)) 0))
        toggle-file (fn [path]
                      (if (file-selected? path)
                        (reset! selected-files (filter (fn [item] (not (= item path))) @selected-files))
                        (reset! selected-files (concat @selected-files [path]))))
        change-action (fn [action path]
                        (do (reset! notice "파일 상태를 변경하는 중…") (send {"action" action "path" path})))
        selected-action (fn [action]
                          (if (= (length @selected-files) 0)
                            (reset! error "먼저 파일을 선택하세요.")
                            (do (reset! notice "선택한 파일을 처리하는 중…") (send {"action" action "paths" @selected-files}))))
        select-repo (fn []
                      (if (= (str-trim @repo-input) "")
                        (reset! error "저장소 폴더 경로를 입력하세요")
                        (do (reset! notice "저장소 확인 중…") (send {"action" "select-repo" "path" @repo-input}))))
        open-repository (fn [path] (do (reset! repo-input path) (select-repo)))
        select-commit (fn [commit]
                        (do (reset! commit-message (or (get commit "message") "")) (reset! notice "커밋 상세 정보를 불러오는 중…") (fetch-post! "/api" {"action" "commit-detail" "hash" (get commit "hash")} commit-detail-result)))
        view-tab (fn [name label]
                   (h "button" {:class (if (= @tab name) "tab active" "tab") :on-click (if (= name "compare") open-compare (fn [] (reset! tab name)))} label))
        status-card (fn [label value tone]
                      (h "div" {:class "stat-card"}
                        (str (h "span" {:class "stat-label"} label) (h "strong" {:class (str "tone-" tone)} (or value "—")))))
        file-row (fn [line]
                   (h "div" {:class "file-row"}
                     (str (h "span" {:class "file-mark"} (if (> (str-count line "??") 0) "?" "M")) (h "code" {} line))))
        render-files (fn []
                      (let [raw (or (get @data "status") "")
                            lines (filter (fn [x] (> (length (str-trim x)) 0)) (regex_split raw "\\n"))]
                        (if (= (length lines) 0)
                          (h "div" {:class "empty"} "작업 트리가 깨끗합니다.")
                          (arr-join (map file-row lines) ""))))
        render-change-file (fn [file]
                            (let [path (get file "path")
                                  kind (get file "kind")]
                              (h "div" {:class (str "change-row " kind)}
                                (str (h "input" {:type "checkbox" :checked (file-selected? path) :on-change (fn [] (toggle-file path))})
                                     (h "span" {:class "change-kind"} (get {"modified" "M" "added" "A" "deleted" "D" "untracked" "?"} kind))
                                     (h "button" {:class "change-path" :title "서버 파일 보기" :on-click (fn [] (open-file "server" path))} path)
                                     (h "span" {:class "change-status"} (get file "status"))
                                     (h "button" {:class "change-action" :on-click (fn [] (change-action "stage-file" path))} "Stage")
                                     (h "button" {:class "change-action ghost" :on-click (fn [] (change-action "unstage-file" path))} "Unstage")))))
        change-group (fn [label kind]
                       (let [items (filter (fn [file] (= (get file "kind") kind)) (or (get @data "files") []))]
                         (if (= (length items) 0)
                           ""
                           (h "section" {:class (str "change-group " kind)}
                             (str (h "div" {:class "change-group-heading"}
                                      (str (h "strong" {} label) (h "span" {} (str (length items) "개"))))
                                  (arr-join (map render-change-file items) ""))))))
        commit-row (fn [commit]
                     (h "article" {:class "commit-row" :on-click (fn [] (select-commit commit))}
                       (str (h "div" {:class "commit-top"}
                              (h "code" {:class "commit-hash"} (get commit "hash"))
                              (h "span" {:class "commit-date"} (get commit "date")))
                            (h "div" {:class "commit-message"} (get commit "message"))
                            (h "div" {:class "commit-author"} (str "by " (get commit "author"))))))
        compare-file-row (fn [side path]
                           (h "button" {:class "compare-file-row" :title (str "서버 ↔ GitHub 비교: " path) :on-click (fn [] (open-file-compare path))}
                             (str (h "span" {:class "file-mark"} "•") (h "code" {} path))))
        compare-column (fn [title paths tone side]
                         (h "div" {:class (str "compare-column " tone)}
                           (str (h "div" {:class "compare-column-heading"}
                                    (h "h3" {} title)
                                    (h "span" {:class "compare-count"} (str (length paths) " files")))
                                (h "div" {:class "compare-files"}
                                  (if (= (length paths) 0)
                                    (h "div" {:class "empty"} "파일 없음")
                                    (arr-join (map (fn [path] (compare-file-row side path)) paths) ""))))))
        render-file-view (fn []
                           (if (= @file-view nil)
                             ""
                             (h "div" {:class "file-modal"}
                               (h "section" {:class "file-viewer"}
                                 (str (h "div" {:class "file-viewer-heading"}
                                          (str (h "div" {:class "file-viewer-title"} (get @file-view "path"))
                                               (h "span" {:class "file-viewer-source"} (str (get @file-view "side") " · 원문"))
                                               (h "button" {:class "button ghost file-viewer-close" :on-click (fn [] (reset! file-view nil))} "닫기")))
                                    (if (= (get @file-view "truncated") true)
                                      (h "div" {:class "file-viewer-note"} "파일이 너무 커 앞 200KB만 표시합니다.")
                                      "")
                                    (h "pre" {:class "file-viewer-content"} (get @file-view "content")))))))
        compare-pane (fn [label item tone]
                       (h "div" {:class (str "compare-pane " tone)}
                         (str (h "div" {:class "compare-pane-heading"} label)
                              (if (= (get item "ok") true)
                                (str (if (= (get item "truncated") true)
                                       (h "div" {:class "file-viewer-note"} "파일이 너무 커 앞 200KB만 표시합니다.")
                                       "")
                                     (h "pre" {:class "compare-pane-content"} (get item "content")))
                                (h "div" {:class "compare-pane-error"} (or (get item "error") "원격 파일을 불러올 수 없습니다."))))))
        render-compare-view (fn []
                              (if (= @compare-view nil)
                                ""
                                (h "div" {:class "file-modal"}
                                  (h "section" {:class "file-viewer compare-viewer"}
                                    (str (h "div" {:class "file-viewer-heading"}
                                             (str (h "div" {:class "file-viewer-title"} (get @compare-view "path"))
                                                  (h "span" {:class "file-viewer-source"} (str "서버 ↔ GitHub · " (get @compare-view "upstream")))
                                                  (h "button" {:class "button ghost file-viewer-close" :on-click (fn [] (reset! compare-view nil))} "닫기")))
                                         (h "div" {:class "compare-view-grid"}
                                           (str (compare-pane "SERVER · 작업 폴더" (get @compare-view "server") "server-pane")
                                                (compare-pane "GITHUB · 원격" (get @compare-view "github") "github-pane"))))))))
        render-project-wizard (fn []
                                (h "section" {:class "panel project-wizard"}
                                  (str (h "div" {:class "panel-heading"}
                                           (str (h "div" {} (h "h2" {} "새 프로젝트 연결 마법사"))
                                                (h "span" {:class "wizard-step"} "1 · 서버 → GitHub")))
                                       (h "p" {:class "muted"} "서버 폴더를 선택하고 로컬 Git과 GitHub 저장소를 한 번에 준비합니다.")
                                       (h "label" {:class "wizard-label"} "서버 상위 폴더")
                                       (h "div" {:class "picker-row"}
                                         (h "input" {:class "repo-input" :type "text" :value @project-parent :placeholder "/home/kim/kim/projects" :on-input (fn [e] (reset! project-parent (.-value (.-target e))))})
                                         (h "button" {:class "button ghost picker-button" :on-click browse-project-folders} "폴더 찾기"))
                                       (if (= (length @project-folders) 0) ""
                                           (h "div" {:class "folder-list wizard-folders"}
                                             (arr-join (map (fn [folder] (h "button" {:class "folder-item" :on-click (fn [] (do (reset! project-parent folder) (reset! project-folders [])))} (str "📁 " folder))) @project-folders) "")))
                                       (h "label" {:class "wizard-label"} "새 프로젝트 이름")
                                       (h "input" {:class "repo-input wizard-input" :type "text" :value @project-name :placeholder "예: my-app" :on-input (fn [e] (reset! project-name (.-value (.-target e))))})
                                       (h "label" {:class "wizard-label"} "GitHub 저장소 이름 또는 기존 URL · 비워두면 로컬만 생성")
                                       (h "input" {:class "repo-input wizard-input" :type "text" :value @project-github :placeholder "새 이름 또는 https://github.com/owner/repo.git" :on-input (fn [e] (reset! project-github (.-value (.-target e))))})
                                       (h "div" {:class "wizard-options"}
                                         (str (h "button" {:class (if (= @project-visibility "private") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-visibility "private"))} "Private")
                                              (h "button" {:class (if (= @project-visibility "public") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-visibility "public"))} "Public")))
                                       (h "div" {:class "wizard-options"}
                                         (str (h "button" {:class (if (= @project-readme true) "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-readme (not @project-readme)))} "README 생성")
                                              (h "button" {:class (if (= @project-initial-push true) "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-initial-push (not @project-initial-push)))} "첫 Push")))
                                       (h "div" {:class "wizard-options"}
                                         (str (h "span" {:class "wizard-label inline-label"} ".gitignore")
                                              (h "button" {:class (if (= @project-gitignore "none") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-gitignore "none"))} "없음")
                                              (h "button" {:class (if (= @project-gitignore "node") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-gitignore "node"))} "Node")
                                              (h "button" {:class (if (= @project-gitignore "next") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-gitignore "next"))} "Next.js")
                                              (h "button" {:class (if (= @project-gitignore "python") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-gitignore "python"))} "Python")))
                                       (h "div" {:class "action-row"}
                                         (h "button" {:class "button primary" :on-click setup-project} "프로젝트 만들고 연결")))))
        render-connect-panel (fn []
                               (h "section" {:class "panel project-wizard"}
                                 (str (h "div" {:class "panel-heading"}
                                          (str (h "div" {} (h "h2" {} "현재 저장소를 GitHub에 연결"))
                                               (h "span" {:class "wizard-step"} "2 · 기존 폴더 연결")))
                                      (h "p" {:class "muted"} "새 폴더를 만들지 않고 현재 선택된 Git 저장소에 origin을 추가합니다.")
                                      (h "div" {:class "selected-folder"} (str "현재 저장소: " (or (get @data "root") "—")))
                                      (h "label" {:class "wizard-label"} "GitHub 저장소 이름 또는 URL")
                                      (h "input" {:class "repo-input wizard-input" :type "text" :value @connect-github-ref :placeholder "my-app 또는 https://github.com/owner/repo.git" :on-input (fn [e] (reset! connect-github-ref (.-value (.-target e))))})
                                      (h "div" {:class "wizard-options"}
                                        (str (h "button" {:class (if (= @connect-visibility "private") "visibility-option active" "visibility-option") :on-click (fn [] (reset! connect-visibility "private"))} "Private")
                                             (h "button" {:class (if (= @connect-visibility "public") "visibility-option active" "visibility-option") :on-click (fn [] (reset! connect-visibility "public"))} "Public")
                                             (h "button" {:class (if (= @connect-initial-push true) "visibility-option active" "visibility-option") :on-click (fn [] (reset! connect-initial-push (not @connect-initial-push)))} "첫 Push")))
                                      (h "div" {:class "action-row"}
                                        (h "button" {:class "button primary" :on-click connect-github} "origin 연결")))))
        render-compare (fn []
                        (let [server-files (or (get @file-compare "server_files") [])
                              github-files (or (get @file-compare "github_files") [])]
                          (h "section" {:class "compare-shell"}
                            (str (h "div" {:class "compare-toolbar"}
                                     (str (h "div" {:class "compare-title"} "서버 ↔ GitHub 파일 비교")
                                          (h "span" {:class "compare-ref"} (str "원격 " (or (get @file-compare "upstream") "—")))
                                          (h "button" {:class "button ghost" :on-click open-compare} "새로고침")))
                                 (h "div" {:class "compare-grid"}
                                   (str (compare-column "1 · 서버 작업 폴더" server-files "server-column" "server")
                                        (compare-column "2 · GitHub 원격" github-files "github-column" "github")))
                                 ""))))
        render-commits (fn []
                         (let [commits (or (get @data "commits") [])]
                           (if (= (length commits) 0)
                             (h "div" {:class "empty"} "커밋이 없습니다.")
                             (arr-join (map commit-row commits) ""))))]
    (when (not @loaded) (do (reset! loaded true) (fetch! "/api" reload)))
    (h "main" {:class "app-shell"}
      (str
        (h "aside" {:class "desktop-rail"}
          (str (h "div" {:class "rail-brand"} (h "span" {:class "brand-dot"} "●") "fl-git")
               (h "div" {:class "rail-kicker"} "SERVER REPOSITORIES")
               (h "div" {:class "rail-repo-toolbar"}
                 (str (h "span" {:class "rail-section-label"} (str "저장소 " (length @repositories) "개"))
                      (h "button" {:class "rail-refresh" :title "서버 저장소 새로고침" :on-click browse-repositories} "↻")))
               (if (= (length @repositories) 0)
                 (h "div" {:class "rail-empty"} "새로고침을 눌러 저장소를 불러오세요.")
                 (h "div" {:class "rail-repositories"}
                   (arr-join
                     (map (fn [path]
                            (h "button" {:class (if (= path (get @data "root")) "rail-repo active" "rail-repo")
                                          :title path
                                          :on-click (fn [] (open-repository path))}
                              (str (h "span" {:class "rail-repo-dot"} (if (= path (get @data "root")) "●" "○"))
                                   (h "span" {:class "rail-repo-path"} path))))
                           @repositories)
                     "")))
               (h "div" {:class "rail-current"}
                 (str (h "div" {:class "rail-section-label"} "CURRENT")
                      (h "strong" {} (or (get @data "root") "선택된 저장소 없음"))
                      (h "span" {:class (if (= (get (get @data "github") "connected") true) "rail-github connected" "rail-github")}
                        (if (= (get (get @data "github") "connected") true)
                          (str "● GitHub " (or (get (get @data "github") "name") "연결됨"))
                          "○ GitHub 미연결"))))
               (h "nav" {:class "rail-nav"}
                 (str (h "div" {:class "rail-nav-item active"} "Workspace")
                      (h "div" {:class "rail-nav-item"} "Changes")
                      (h "div" {:class "rail-nav-item"} "Diff")
                      (h "div" {:class "rail-nav-item"} "Commits")
                      (h "div" {:class "rail-nav-item"} "GitHub")
                      (h "div" {:class "rail-nav-item"} "AI Context")))
               (h "div" {:class "rail-footer"}
                 (str (h "span" {:class "online-dot"} "●") " DESKTOP MODE"))))
        (h "header" {:class "topbar"}
          (str (h "div" {:class "brand"} (h "span" {:class "brand-dot"} "●") "fl-git")
               (h "div" {:class "connection"} (h "span" {:class "online-dot"} "●") "LOCAL REPOSITORY")))
        (h "section" {:class "shell-meta"}
          (str (h "div" {:class "shell-meta-item root-meta"}
                   (str (h "span" {:class "shell-meta-label"} "ROOT")
                        (h "strong" {} (or (get @data "root") "—"))))
               (h "div" {:class "shell-meta-item"}
                 (str (h "span" {:class "shell-meta-label"} "BRANCH")
                      (h "strong" {} (or (get @data "branch") "—"))))
               (h "div" {:class "shell-meta-item"}
                 (str (h "span" {:class "shell-meta-label"} "UPSTREAM")
                      (h "strong" {} (or (get (get @data "sync") "upstream") "—"))))
               (h "div" {:class "shell-meta-item compact-meta"}
                 (str (h "span" {:class "shell-meta-label"} "SYNC")
                      (h "strong" {} (str "↑" (or (get (get @data "sync") "ahead") "—") "  ↓" (or (get (get @data "sync") "behind") "—")))))))
        (h "section" {:class "hero"}
          (str (h "div" {:class "eyebrow"} "GIT WORKSPACE / WEB CONTROL")
               (h "h1" {} "코드의 흐름을 한 화면에서.")
               (h "p" {:class "hero-copy"} "터미널 명령을 기억하지 않아도 됩니다. 현재 저장소를 확인하고, 변경을 고르고, 커밋까지 클릭으로 처리하세요.")))
        (h "section" {:class "repo-bar"}
          (str (h "div" {:class "repo-picker"}
                    (str (h "span" {:class "muted"} "관리할 저장소 폴더")
                         (h "div" {:class "picker-row"}
                           (h "input" {:class "repo-input" :type "text" :value @repo-input :placeholder "/home/kim/kim/projects/my-repo" :on-input (fn [e] (reset! repo-input (.-value (.-target e))))})
                           (h "button" {:class "button primary picker-button" :on-click select-repo} "저장소 열기")
                           (h "button" {:class "button ghost picker-button" :on-click browse-folders} "폴더 선택")
                           (h "button" {:class "button ghost picker-button" :on-click browse-repositories} "서버 저장소"))))
                    (if (= (length @folders) 0)
                      ""
                      (h "div" {:class "folder-list"}
                        (arr-join (map (fn [folder] (h "button" {:class "folder-item" :on-click (fn [] (do (reset! repo-input folder) (reset! folders [])))} (str "📁 " folder))) @folders) "")))
                    (if (= (length @repositories) 0)
                      ""
                      (str (h "div" {:class "repo-list-heading"} (str "서버 Git 저장소 · " (length @repositories) "개"))
                           (h "div" {:class "folder-list repo-list"}
                             (arr-join (map (fn [path] (h "button" {:class "folder-item repo-item" :title path :on-click (fn [] (open-repository path))} (str "◆ " path))) @repositories) ""))))
                    (h "div" {:class "selected-folder"} (str "선택 경로: " (or @repo-input "—"))))
               (h "div" {:class "branch-pill"} (str "⎇ " (or (get @data "branch") "—")))))
        (h "section" {:class "stats-grid"}
          (str (status-card "BRANCH" (get @data "branch") "blue")
               (status-card "REMOTE" (if (> (length (or (get @data "remote") "")) 0) "CONNECTED" "LOCAL ONLY") "green")
               (status-card "CHANGES" (if (= (str-trim (or (get @data "status") "")) "") "0" "OPEN") "orange")))
        (h "section" {:class "source-grid"}
          (str (h "div" {:class "source-card server-source"}
                   (str (h "div" {:class "source-label"} "SERVER")
                        (h "strong" {} (or (get @data "root") "—"))
                        (h "div" {:class "source-meta"} (str "branch " (or (get @data "branch") "—")))))
               (h "div" {:class "source-card github-source"}
                 (str (h "div" {:class "source-label"} "GITHUB")
                      (h "strong" {} (if (= (get (get @data "github") "connected") true) (get (get @data "github") "name") "연결 정보 없음"))
                      (h "div" {:class "source-meta"}
                        (str (if (= (get (get @data "github") "private") true) "PRIVATE" "PUBLIC")
                             " · default " (or (get (get @data "github") "default_branch") "—")
                             " · ↑" (or (get (get @data "sync") "ahead") "—")
                             " ↓" (or (get (get @data "sync") "behind") "—")))))))
        (h "aside" {:class (if (= @right-open true) "desktop-detail" "desktop-detail collapsed")}
          (if (= @right-open true)
            (str (h "div" {:class "detail-heading"}
                     (str (h "span" {} "DETAIL")
                          (h "button" {:class "detail-toggle" :on-click (fn [] (reset! right-open false))} "접기")))
                 (h "div" {:class "detail-placeholder"}
                   (str (h "strong" {} "선택 항목 상세")
                        (h "p" {} "변경 파일을 선택하면 Diff와 파일 내용을 이 영역에 표시합니다."))))
            (h "button" {:class "detail-expand" :on-click (fn [] (reset! right-open true))} "‹")))
        (h "nav" {:class "tabs"}
          (str (view-tab "overview" "Overview") (view-tab "project" "새 프로젝트") (view-tab "remote" "원격 연결") (view-tab "changes" "Changes") (view-tab "compare" "파일 비교") (view-tab "context" "AI Context")))
        (if (= @tab "context")
          (h "section" {:class "panel context-panel"}
            (str (h "div" {:class "panel-heading"} (h "h2" {} "AI에게 전달할 문맥"))
                 (h "p" {:class "muted"} "아래 JSON을 복사해 AI 대화에 붙여 넣으면 현재 저장소 상태를 바로 공유할 수 있습니다.")
                 (h "pre" {:class "context-output"} (or (get @data "context_json") "불러오는 중…"))))
          (if (= @tab "project")
            (render-project-wizard)
            (if (= @tab "remote")
              (render-connect-panel)
              (if (= @tab "compare")
            (if (= @file-compare nil)
              (h "section" {:class "panel compare-loading"} "파일 비교 정보를 불러오는 중…")
              (render-compare))
            (if (= @tab "changes")
            (h "section" {:class "columns"}
              (str (h "div" {:class "panel"}
                       (str (h "div" {:class "panel-heading"} (h "h2" {} "변경 파일"))
                            (h "div" {:class "change-summary"} (str "선택 " (length @selected-files) "개 · 전체 " (length (or (get @data "files") [])) "개"))
                            (h "div" {:class "change-list"}
                              (str (change-group "Modified" "modified")
                                   (change-group "Added" "added")
                                   (change-group "Deleted" "deleted")
                                   (change-group "Untracked" "untracked")))
                            (h "div" {:class "action-row"}
                              (str (h "button" {:class "button secondary" :on-click (fn [] (selected-action "stage-files"))} "선택 Stage")
                                   (h "button" {:class "button ghost" :on-click (fn [] (selected-action "unstage-files"))} "선택 Unstage")
                                   (h "button" {:class "button dark" :on-click (fn [] (do-action "add-all"))} "전체 Stage")))))
                   (h "div" {:class "panel diff-panel"}
                     (str (h "div" {:class "panel-heading"} (h "h2" {} "Diff 미리보기"))
                          (h "pre" {:class "diff-output"} (or (get @data "diff") "변경 내용이 없습니다."))))))
            (h "section" {:class "columns"}
              (str (h "div" {:class "panel"}
                       (str (h "div" {:class "panel-heading"} (h "h2" {} "빠른 작업"))
                            (h "p" {:class "muted"} "원격 작업은 서버에서 확인 후 실행됩니다.")
                            (h "div" {:class "action-grid"}
                              (str (h "button" {:class "button secondary" :on-click (fn [] (do-action "fetch"))} "Fetch")
                                   (h "button" {:class "button secondary" :on-click (fn [] (do-action "pull"))} "Pull")
                                   (h "button" {:class "button primary" :on-click (fn [] (do-action "push"))} "Push")))
                            (h "div" {:class "commit-box"}
                              (str (h "label" {} "로컬 커밋")
                                   (h "input" {:type "text" :placeholder "예: feat: update landing page" :value @commit-message :on-input (fn [e] (reset! commit-message (.-value (.-target e))))})
                                   (h "button" {:class "button primary" :on-click commit-push} "Commit & Push")))))
                   (h "div" {:class "panel"}
                     (str (h "div" {:class "panel-heading"} (h "h2" {} "최근 커밋"))
                          (h "div" {:class "commit-list"} (render-commits))
                          (if (= @commit-detail nil)
                            ""
                            (h "div" {:class "commit-detail"}
                              (str (h "div" {:class "commit-detail-heading"} "커밋 상세 · 클릭한 커밋의 변경 내용")
                                   (h "pre" {:class "commit-detail-output"} (get @commit-detail "detail")))))))))))
        (if (= @tab "overview")
          (h "section" {:class "panel create-panel"}
            (str (h "div" {:class "panel-heading"} (h "h2" {} "새 저장소 만들기"))
                 (h "p" {:class "muted"} "현재 폴더에 새 로컬 Git 저장소를 생성합니다.")
                 (h "div" {:class "picker-row"}
                   (h "input" {:class "repo-input" :type "text" :value @new-repo-name :placeholder "예: my-new-repo" :on-input (fn [e] (reset! new-repo-name (.-value (.-target e))))})
                   (h "button" {:class "button primary picker-button" :on-click create-repo} "저장소 생성"))))
          "")
        (if (> (length @error) 0) (h "div" {:class "toast error"} @error) "")
        (if (> (length @notice) 0) (h "div" {:class "toast"} @notice) "")
        (render-file-view)
        (render-compare-view)))))))

(defn render [req]
  (server_header
    (server_html
      (h "html" {:lang "ko"}
        (str
          (h "head" {}
                 (str (h! "meta" {:charset "utf-8"})
                      (h! "meta" {:name "viewport" :content "width=device-width,initial-scale=1"})
                 (h! "link" {:rel "icon" :href "data:,"})
                 (h "title" {} "fl-git · Git Workspace")
                 """
<style>
:root{color-scheme:dark;--bg:#0a0d12;--surface:#111722;--line:#273244;--text:#f4f7fb;--muted:#8d9aae;--blue:#7c9cff;--green:#61d8a2;--orange:#f7a45b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.layout_nav{display:none}.layout_main{max-width:none!important;padding:0!important}.app-shell{min-height:100vh;max-width:1240px;margin:0 auto;padding:28px 42px 64px}.topbar{display:flex;justify-content:space-between;align-items:center;padding-bottom:34px;border-bottom:1px solid var(--line)}.brand{font-weight:800;font-size:20px;letter-spacing:-.04em}.brand-dot{color:var(--blue);font-size:13px;margin-right:8px}.connection{font-size:10px;letter-spacing:.18em;color:var(--muted)}.online-dot{color:var(--green);font-size:12px;margin-right:8px}.hero{padding:64px 0 38px;max-width:780px}.eyebrow{color:var(--blue);font-size:11px;font-weight:800;letter-spacing:.2em;margin-bottom:18px}.hero h1{font-size:clamp(38px,6vw,74px);line-height:.98;letter-spacing:-.075em;margin:0 0 24px}.hero-copy{color:var(--muted);font-size:17px;line-height:1.75;max-width:650px}.repo-bar{display:flex;align-items:center;justify-content:space-between;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px 22px;margin-bottom:16px}.repo-bar strong{display:block;margin-top:5px;font-family:ui-monospace,monospace;font-size:14px;word-break:break-all}.muted,.stat-label{color:var(--muted);font-size:12px}.branch-pill{background:#202b42;color:var(--blue);padding:9px 13px;border-radius:999px;font:12px ui-monospace,monospace}.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stat-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px 20px}.stat-label{display:block;letter-spacing:.13em;font-size:10px}.stat-card strong{display:block;margin-top:10px;font-size:19px}.tone-blue{color:var(--blue)}.tone-green{color:var(--green)}.tone-orange{color:var(--orange)}.tabs{display:flex;gap:28px;border-bottom:1px solid var(--line);margin-top:42px}.tab{appearance:none;background:none;border:0;color:var(--muted);padding:15px 2px;font-weight:700;cursor:pointer;border-bottom:2px solid transparent}.tab.active{color:var(--text);border-color:var(--blue)}.columns{display:grid;grid-template-columns:1.15fr .85fr;gap:16px;margin-top:22px}.panel{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:24px;min-width:0}.panel-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.panel h2{font-size:17px;letter-spacing:-.03em;margin:0}.file-list{min-height:170px}.file-row{display:flex;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid #202a39;font-size:13px}.file-mark{display:grid;place-items:center;width:22px;height:22px;border-radius:6px;background:#263653;color:var(--blue);font-size:11px;font-weight:800}.file-row code{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.diff-output,.log-output,.context-output{background:#0a0e15;border:1px solid #1d2838;border-radius:10px;min-height:230px;max-height:420px;overflow:auto;padding:16px;color:#c6d1e1;font:12px/1.65 ui-monospace,SFMono-Regular,monospace;white-space:pre-wrap}.action-row,.action-grid{display:flex;gap:9px;margin-top:20px}.action-grid{display:grid;grid-template-columns:repeat(3,1fr)}.button{border:0;border-radius:9px;padding:11px 14px;font-weight:750;cursor:pointer;color:#fff;background:#24314a}.button:hover{filter:brightness(1.16)}.button.primary{background:#587df5}.button.ghost{background:transparent;border:1px solid var(--line);color:var(--muted)}.button.dark{background:#293548}.empty{color:var(--muted);padding:45px 0;text-align:center;font-size:13px}.context-panel{margin-top:22px}.commit-box{border-top:1px solid var(--line);margin-top:24px;padding-top:20px}.commit-box label{display:block;color:var(--muted);font-size:11px;margin-bottom:8px}.commit-box input{width:100%;background:#0a0e15;border:1px solid var(--line);border-radius:8px;color:var(--text);padding:12px;margin-bottom:10px;outline:none}.toast{position:fixed;right:24px;bottom:24px;background:#1c2d42;border:1px solid #365274;color:#b9d3ff;border-radius:10px;padding:13px 17px;font-size:13px}.toast.error{background:#43242a;border-color:#79434c;color:#ffc2c8}@media(max-width:760px){.app-shell{padding:20px 16px 42px}.hero{padding:46px 0 28px}.hero h1{font-size:43px}.stats-grid,.columns{grid-template-columns:1fr}.repo-bar{display:block}.branch-pill{display:inline-block;margin-top:14px}.topbar{padding-bottom:22px}}
</style>
<style>
.repo-bar{gap:18px}.repo-picker{flex:1;min-width:0}.picker-row{display:flex;gap:9px;margin-top:8px}.repo-input{width:100%;min-width:0;background:#0a0e15;border:1px solid var(--line);border-radius:8px;color:var(--text);padding:11px 12px;font:12px ui-monospace,monospace;outline:none}.repo-input:focus{border-color:var(--blue)}.picker-button{white-space:nowrap}
.folder-list{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}.folder-item{border:1px solid var(--line);border-radius:8px;background:#182235;color:var(--muted);padding:8px 10px;cursor:pointer;font:12px ui-monospace,monospace}.folder-item:hover{border-color:var(--blue);color:var(--text)}.create-panel{margin-top:22px}.create-panel .picker-row{max-width:600px}.repo-bar{display:block;position:relative}.repo-picker{width:100%;padding-right:110px}.picker-row{min-width:0}.repo-input{flex:1;min-width:0;font-size:12px}.picker-button{font-size:12px}.branch-pill{position:absolute;top:18px;right:22px}.selected-folder{margin-top:10px;color:var(--blue);font:12px ui-monospace,monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.repo-list-heading{margin-top:16px;color:var(--text);font-size:12px;font-weight:700}.repo-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));max-height:220px;overflow-y:auto;padding:8px;border:1px solid var(--line);border-radius:10px;background:#0d131d}.repo-item{display:block;width:100%;min-width:0;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.repo-item:hover{background:#253452}
.commit-list{display:flex;flex-direction:column;gap:9px;max-height:420px;overflow:auto}.commit-row{background:#0d131d;border:1px solid #202c3f;border-radius:10px;padding:12px 13px}.commit-top{display:flex;justify-content:space-between;gap:10px;align-items:center}.commit-hash{color:var(--blue);font:11px ui-monospace,monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.commit-date,.commit-author{color:var(--muted);font-size:11px}.commit-message{color:var(--text);font-size:13px;font-weight:700;margin:8px 0 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.commit-row{cursor:pointer}.commit-row:hover{border-color:var(--blue);background:#142039}.commit-detail{margin-top:16px;border-top:1px solid var(--line);padding-top:14px}.commit-detail-heading{color:var(--blue);font-size:11px;font-weight:800;letter-spacing:.08em;margin-bottom:9px}.commit-detail-output{max-height:360px;overflow:auto;margin:0;background:#080c12;border:1px solid #1d2838;border-radius:9px;padding:13px;color:#c6d1e1;font:11px/1.6 ui-monospace,SFMono-Regular,monospace;white-space:pre-wrap}
.source-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.source-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px;min-width:0}.source-label{font-size:10px;letter-spacing:.15em;font-weight:800;color:var(--muted);margin-bottom:9px}.source-card strong{display:block;color:var(--text);font:13px ui-monospace,monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.source-meta{margin-top:9px;color:var(--muted);font-size:11px}.github-source{border-color:#31557e}.github-source .source-label{color:var(--blue)}@media(max-width:760px){.source-grid{grid-template-columns:1fr}}
.compare-shell{margin-top:22px}.compare-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.compare-title{font-size:16px;font-weight:800}.compare-ref{color:var(--muted);font:11px ui-monospace,monospace;margin-left:auto}.compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.compare-column{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px;min-width:0}.server-column{border-top:2px solid var(--green)}.github-column{border-top:2px solid var(--blue)}.compare-column-heading{display:flex;justify-content:space-between;align-items:center;gap:10px}.compare-column-heading h3{margin:0;font-size:14px}.compare-count{color:var(--muted);font-size:11px;white-space:nowrap}.compare-files{margin-top:14px;max-height:520px;overflow:auto;background:#0b1018;border:1px solid #1d2838;border-radius:9px}.compare-file-row{display:flex;align-items:center;gap:8px;width:100%;text-align:left;color:var(--text);background:transparent;padding:9px 11px;border:0;border-bottom:1px solid #1b2635;cursor:pointer;font:12px ui-monospace,monospace}.compare-file-row:last-child{border-bottom:0}.compare-file-row:hover{background:#17243a;color:#fff}.compare-file-row code{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.compare-loading{margin-top:22px;color:var(--muted)}@media(max-width:760px){.compare-grid{grid-template-columns:1fr}.compare-toolbar{align-items:flex-start;flex-wrap:wrap}.compare-ref{margin-left:0}}
.file-modal{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:28px;background:rgba(3,6,11,.78);backdrop-filter:blur(5px)}.file-viewer{width:min(1100px,94vw);max-height:88vh;background:var(--surface);border:1px solid #3b4e6b;border-radius:16px;padding:18px;box-shadow:0 24px 80px rgba(0,0,0,.55)}.file-viewer-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.file-viewer-title{font:14px ui-monospace,monospace;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.file-viewer-source,.file-viewer-note{color:var(--muted);font-size:11px}.file-viewer-close{flex:none;padding:8px 12px}.file-viewer-content{margin:0;max-height:calc(88vh - 110px);overflow:auto;background:#080c12;border:1px solid #1d2838;border-radius:9px;padding:16px;color:#d5deeb;font:12px/1.65 ui-monospace,SFMono-Regular,monospace;white-space:pre-wrap;tab-size:2}.file-viewer-note{margin:-3px 0 10px;color:var(--orange)}
.project-wizard{margin-top:22px;max-width:760px}.wizard-step{color:var(--blue);font:11px ui-monospace,monospace}.wizard-label{display:block;margin-top:18px;margin-bottom:7px;color:var(--muted);font-size:11px;font-weight:700}.wizard-input{display:block;margin-top:0}.wizard-folders{margin-top:10px}.wizard-options{display:flex;gap:8px;margin-top:18px}.visibility-option{border:1px solid var(--line);border-radius:8px;background:#182235;color:var(--muted);padding:9px 14px;cursor:pointer;font-size:12px}.visibility-option.active{border-color:var(--blue);color:var(--text);background:#243555}
.inline-label{display:inline-flex;align-items:center;margin:0 6px 0 0}.desktop-rail{grid-column:1;grid-row:1 / span 40;align-self:start;position:sticky;top:28px;min-height:calc(100vh - 56px);background:#0d131d;border:1px solid var(--line);border-radius:18px;padding:22px 16px;display:flex;flex-direction:column;box-shadow:0 18px 50px rgba(0,0,0,.18)}.rail-brand{font-size:19px;font-weight:850;letter-spacing:-.04em;padding:4px 8px 28px}.rail-kicker{color:var(--muted);font:10px ui-monospace,monospace;letter-spacing:.16em;padding:0 8px 12px}.rail-nav{display:flex;flex-direction:column;gap:5px}.rail-nav-item{color:var(--muted);border-radius:9px;padding:11px 10px;font-size:13px;font-weight:700}.rail-nav-item.active{color:var(--text);background:#1d2b46;border-left:2px solid var(--blue);padding-left:8px}.rail-footer{margin-top:auto;color:var(--muted);font:10px ui-monospace,monospace;padding:14px 8px 4px;border-top:1px solid var(--line)}.app-shell{width:100%;min-width:1200px;max-width:1800px;margin:0 auto;padding:28px 42px 64px;display:grid;grid-template-columns:300px minmax(640px,1fr) 340px;gap:20px}.app-shell>.topbar,.app-shell>.shell-meta{grid-column:2 / 4;min-width:0}.app-shell>.hero,.app-shell>.repo-bar,.app-shell>.stats-grid,.app-shell>.source-grid,.app-shell>.tabs,.app-shell>.panel,.app-shell>.columns,.app-shell>.compare-shell,.app-shell>.project-wizard{grid-column:2;min-width:0}.app-shell>.desktop-detail{grid-column:3;grid-row:3 / span 40;min-width:0}.topbar{padding-bottom:24px}.shell-meta{display:grid;grid-template-columns:minmax(260px,1.8fr) repeat(3,minmax(120px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden}.shell-meta-item{background:var(--surface);padding:12px 14px;min-width:0}.shell-meta-label{display:block;color:var(--muted);font:10px ui-monospace,monospace;letter-spacing:.12em;margin-bottom:6px}.shell-meta strong{display:block;color:var(--text);font:12px ui-monospace,monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.compact-meta strong{color:var(--blue)}.hero{padding:32px 0 22px;max-width:880px}.hero h1{font-size:56px}.stats-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.source-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.columns{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr)}.compare-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.repo-bar{display:block}.branch-pill{display:block}.tabs{gap:24px}.desktop-detail{align-self:start;position:sticky;top:28px;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px;min-height:260px}.desktop-detail.collapsed{padding:8px;min-height:52px;width:52px;justify-self:end}.detail-heading{display:flex;align-items:center;justify-content:space-between;color:var(--muted);font:10px ui-monospace,monospace;letter-spacing:.14em}.detail-toggle,.detail-expand{border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:7px;padding:6px 8px;cursor:pointer}.detail-placeholder{margin-top:32px;color:var(--muted);font-size:12px;line-height:1.7}.detail-placeholder strong{display:block;color:var(--text);font-size:14px;margin-bottom:8px}.app-shell{grid-template-columns:300px minmax(0,1fr) 300px;gap:16px;padding:24px 24px 56px}
