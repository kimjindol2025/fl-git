; fl-git 웹 UI — 브라우저에서 Git 상태를 보고 작업한다.

(island FlGitApp []
  (let [data (atom nil)
        loaded (atom false)
        tab (atom "overview")
        repo-input (atom "")
        folders (atom [])
        repositories (atom [])
        new-repo-name (atom "")
        commit-message (atom "")
        branch-name (atom "")
        commit-detail (atom nil)
        file-compare (atom nil)
        file-view (atom nil)
        compare-view (atom nil)
        selected-files (atom [])
        context-selected (atom [])
        context-response (atom nil)
        airc-selected (atom "PROJECT-CONTINUITY.airc")
        conflict-files (atom [])
        right-open (atom true)
        project-parent (atom "/home/kim/kim/projects")
        project-name (atom "")
        project-github (atom "")
        project-visibility (atom "private")
        project-readme (atom true)
        project-gitignore (atom "next")
        project-initial-push (atom true)
        project-folders (atom [])
        provider-repos (atom [])
        provider-repos-provider (atom "")
        provider-repos-loading (atom false)
        provider-selected-repo (atom "")
        connect-github-ref (atom "")
        connect-remote-ref (atom "")
        remote-provider (atom "github")
        connect-visibility (atom "private")
        connect-initial-push (atom true)
        notice (atom "")
        error (atom "")
        apply-result (fn [res]
                       (if (= (get res "ok") false)
                         (reset! error (or (get res "error") "요청 실패"))
                         (do (reset! data res) (reset! remote-provider (or (get (get res "remote_info") "provider") @remote-provider)) (reset! conflict-files (or (get res "conflicts") [])) (reset! selected-files []) (reset! repo-input (or (get res "root") @repo-input)) (reset! error "") (reset! notice (or (get res "message") "완료")))))
        reload (fn [res]
                 (if (= (get res "ok") false)
                   (reset! error (or (get res "error") "상태를 불러오지 못했습니다"))
                   (do (reset! data res) (reset! remote-provider (or (get (get res "remote_info") "provider") @remote-provider)) (reset! conflict-files (or (get res "conflicts") [])) (reset! repo-input (or (get res "root") @repo-input)) (reset! error ""))))
        send (fn [payload] (fetch-post! "/api" payload apply-result))
        remote-action-result (fn [res]
                               (if (= (get res "ok") false)
                                 (do (reset! conflict-files (or (get res "conflicts") [])) (reset! error (or (get res "error") "원격 작업에 실패했습니다")))
                                 (do (reset! data res) (reset! conflict-files (or (get res "conflicts") [])) (reset! error "") (reset! notice (or (get res "message") "원격 작업 완료")))))
        compare-result (fn [res]
                         (if (= (get res "ok") false)
                           (reset! error (or (get res "error") "파일 비교 정보를 불러오지 못했습니다"))
                           (do (reset! file-compare res) (reset! error "") (reset! notice "서버와 GitHub 파일 목록을 불러왔습니다."))))
        open-compare (fn [] (do (reset! tab "compare") (reset! notice "파일 비교 준비 중…") (fetch-post! "/api" {"action" "compare-files"} compare-result)))
        file-view-result (fn [res]
                           (if (= (get res "ok") false)
                             (reset! error (or (get res "error") "파일 내용을 불러오지 못했습니다"))
                             (do (reset! file-view res) (reset! error "") (reset! notice "파일 내용을 불러왔습니다."))))
        open-file (fn [side path]
                    (do (reset! notice "파일 내용을 불러오는 중…")
                        (fetch-post! "/api" {"action" "file-content" "side" side "path" path} file-view-result)))
        compare-file-result (fn [res]
                              (if (= (get res "ok") false)
                                (reset! error (or (get res "error") "좌우 파일을 불러오지 못했습니다"))
                                (do (reset! compare-view res) (reset! error "") (reset! notice "서버와 GitHub 파일을 불러왔습니다."))))
        open-file-compare (fn [path]
                           (do (reset! notice "서버와 GitHub 파일을 비교하는 중…")
                               (fetch-post! "/api" {"action" "compare-file-content" "path" path} compare-file-result)))
        project-browse-result (fn [res]
                                (if (= (get res "ok") false)
                                  (reset! error (or (get res "error") "상위 폴더를 불러오지 못했습니다"))
                                  (do (reset! project-folders (or (get res "folders") [])) (reset! error "") (reset! notice "상위 폴더 목록을 불러왔습니다."))))
        browse-project-folders (fn [] (fetch-post! "/api" {"action" "list-folders" "path" @project-parent} project-browse-result))
        setup-project-result (fn [res]
                               (if (= (get res "ok") false)
                                 (reset! error (or (get res "error") "프로젝트를 만들지 못했습니다"))
                                 (do (reset! project-folders []) (reset! project-name "") (reset! project-github "") (reset! tab "overview") (apply-result res))))
        setup-project (fn []
                        (if (or (= (str-trim @project-parent) "") (= (str-trim @project-name) ""))
                          (reset! error "상위 폴더와 프로젝트 이름을 입력하세요")
                          (if (js_confirm "새 로컬 Git 프로젝트를 만들고 설정할까요?")
                            (do (reset! notice "프로젝트 초기화 및 GitHub 연결 중…") (fetch-post! "/api" {"action" "project-setup" "parent" @project-parent "name" @project-name "github_name" @project-github "visibility" @project-visibility "readme" @project-readme "gitignore_template" @project-gitignore "initial_push" @project-initial-push} setup-project-result))
                            nil)))
        connect-github-result (fn [res]
                               (if (= (get res "ok") false)
                                 (reset! error (or (get res "error") "GitHub 연결에 실패했습니다"))
                                 (do (reset! connect-github-ref "") (reset! tab "overview") (apply-result res))))
        connect-github (fn []
                         (if (= (str-trim @connect-github-ref) "")
                           (reset! error "GitHub 저장소 이름 또는 URL을 입력하세요")
                           (if (js_confirm "현재 저장소를 GitHub에 연결할까요?")
                             (do (reset! notice "GitHub 연결 및 Push 중…") (fetch-post! "/api" {"action" "connect-github" "github_ref" @connect-github-ref "visibility" @connect-visibility "initial_push" @connect-initial-push} connect-github-result))
                             nil)))
        connect-remote-result (fn [res]
                                (if (= (get res "ok") false)
                                  (reset! error (or (get res "error") "Remote 연결에 실패했습니다"))
                                  (do (reset! connect-remote-ref "") (apply-result res))))
        write-target-label (fn [op provider]
                             (let [info (or (get @data "remote_info") {})
                                   repo (or (get info "full_name") (get info "repository") @provider-selected-repo "—")
                                   branch (or (get @data "branch") (get info "branch") "—")
                                   kind (if (> (length (str-trim (str provider))) 0) provider (or (get info "provider") @remote-provider "none"))]
                               (str op " 대상 · provider: " kind " · repository: " repo " · branch: " branch " · 실행할까요?")))
        connect-remote (fn []
                        (if (= (str-trim @connect-remote-ref) "")
                          (reset! error "현재 Provider 전용 Remote URL 또는 SSH alias를 입력하세요")
                          (if (js_confirm (str "connect 대상 · provider: " @remote-provider " · repository: " (if (= @provider-selected-repo "") @connect-remote-ref @provider-selected-repo) " · branch: " (or (get @data "branch") "—") " · Push 없이 origin만 연결합니다. 실행할까요?"))
                            (do (reset! notice (str @remote-provider " Remote 연결 중…"))
                                (fetch-post! "/api" {"action" "connect-remote" "remote_url" @connect-remote-ref "provider" @remote-provider "confirm" true} connect-remote-result))
                            nil)))
        commit-detail-result (fn [res]
                               (if (= (get res "ok") false)
                                 (reset! error (or (get res "error") "커밋 상세 정보를 불러오지 못했습니다"))
                                 (reset! commit-detail res)))
        browse-result (fn [res]
                        (if (= (get res "ok") false)
                          (reset! error (or (get res "error") "폴더를 불러오지 못했습니다"))
                          (do (reset! folders (or (get res "folders") [])) (reset! repositories []) (reset! repo-input (or (get res "root") @repo-input)) (reset! error "") (reset! notice "폴더 목록을 불러왔습니다."))))
        browse-folders (fn [] (fetch-post! "/api" {"action" "list-folders" "path" @repo-input} browse-result))
        repo-result (fn [res]
                      (if (= (get res "ok") false)
                        (reset! error (or (get res "error") "저장소 목록을 불러오지 못했습니다"))
                        (do (reset! repositories (or (get res "repositories") [])) (reset! folders []) (reset! error "") (reset! notice "서버 저장소 목록을 불러왔습니다."))))
        browse-repositories (fn [] (fetch-post! "/api" {"action" "list-repos"} repo-result))
        provider-repos-result (fn [res]
                                (reset! provider-repos-loading false)
                                (if (= (get res "ok") false)
                                  (reset! error (str (or (get res "code") "ERROR") ": " (or (get res "error") "provider 레포 목록을 불러오지 못했습니다")))
                                  (do (reset! provider-repos-provider (get res "provider")) (reset! provider-repos (or (get res "repositories") [])) (reset! error "") (reset! notice (str (get res "provider") " 레포 목록 · auth=" (or (get res "auth") "unknown"))))))
        load-provider-repos (fn [provider]
                              (do (reset! remote-provider provider)
                                  (reset! provider-repos-provider provider)
                                  (reset! provider-repos [])
                                  (reset! provider-selected-repo "")
                                  (reset! connect-remote-ref "")
                                  (reset! provider-repos-loading true)
                                  (fetch-post! "/api" {"action" "provider-repos" "provider" provider} provider-repos-result)))
        open-provider-page (fn [provider]
                             (do (reset! tab provider)
                                 (reset! provider-selected-repo "")
                                 (reset! connect-remote-ref "")
                                 (if (or (= provider "github") (= provider "forgejo") (= provider "gitlab"))
                                   (load-provider-repos provider)
                                   (do (reset! remote-provider provider)
                                       (reset! provider-repos-provider provider)
                                       (reset! provider-repos [])
                                       (reset! provider-repos-loading false)))))
        create-repo (fn []
                      (if (= (str-trim @new-repo-name) "")
                        (reset! error "새 저장소 이름을 입력하세요")
                        (do (reset! notice "저장소 생성 중…") (fetch-post! "/api" {"action" "create-repo" "parent" @repo-input "name" @new-repo-name} apply-result) (reset! new-repo-name ""))))
        do-provider-write (fn [op provider]
                            (if (js_confirm (write-target-label op provider))
                              (do (reset! notice (str op " 실행 중…"))
                                  (fetch-post! "/api" {"action" "provider-write" "op" op "provider" provider "confirm" true} remote-action-result))
                              nil))
        do-action (fn [action]
                    (if (or (= action "push") (= action "pull") (= action "fetch"))
                      (if (js_confirm (write-target-label action (or (get (get @data "remote_info") "provider") @remote-provider)))
                        (do (reset! notice "실행 중…") (fetch-post! "/api" {"action" action "confirm" true "provider" (or (get (get @data "remote_info") "provider") "")} remote-action-result))
                        nil)
                      (do (reset! notice "실행 중…") (send {"action" action}))))
        commit (fn []
                 (if (= (str-trim @commit-message) "")
                   (reset! error "커밋 메시지를 입력하세요")
                   (do (send {"action" "commit" "message" @commit-message}) (reset! commit-message ""))))
        commit-push (fn []
                      (if (= (str-trim @commit-message) "")
                        (reset! error "커밋 메시지를 입력하세요")
                        (if (js_confirm "커밋 후 원격 저장소로 Push할까요?")
                          (do (reset! notice "커밋 및 Push 실행 중…") (send {"action" "commit-push" "message" @commit-message "confirm" true}) (reset! commit-message ""))
                          nil)))
        create-branch (fn []
                        (if (= (str-trim @branch-name) "")
                          (reset! error "생성할 branch 이름을 입력하세요.")
                          (do (reset! notice "branch를 생성하는 중…") (send {"action" "create-branch" "name" @branch-name}) (reset! branch-name ""))))
        switch-branch (fn [name]
                        (do (reset! notice "branch를 전환하는 중…") (send {"action" "switch-branch" "name" name})))
        file-selected? (fn [path]
                         (> (length (filter (fn [item] (= item path)) @selected-files)) 0))
        toggle-file (fn [path]
                      (if (file-selected? path)
                        (reset! selected-files (filter (fn [item] (not (= item path))) @selected-files))
                        (reset! selected-files (concat @selected-files [path]))))
        change-action (fn [action path]
                        (do (reset! notice "파일 상태를 변경하는 중…") (send {"action" action "path" path})))
        selected-action (fn [action]
                          (if (= (length @selected-files) 0)
                            (reset! error "먼저 파일을 선택하세요.")
                            (do (reset! notice "선택한 파일을 처리하는 중…") (send {"action" action "paths" @selected-files}))))
        context-card-selected? (fn [key]
                                 (> (length (filter (fn [item] (= item key)) @context-selected)) 0))
        toggle-context-card (fn [key]
                              (if (context-card-selected? key)
                                (reset! context-selected (filter (fn [item] (not (= item key))) @context-selected))
                                (reset! context-selected (concat @context-selected [key]))))
        context-response-result (fn [res]
                                  (if (= (get res "ok") false)
                                    (reset! error (or (get res "error") "AI Context를 만들지 못했습니다."))
                                    (do (reset! context-response res) (reset! error "") (reset! notice "선택한 카드를 AI 전달용으로 만들었습니다."))))
        send-context (fn []
                       (if (= (length @context-selected) 0)
                         (reset! error "AI에게 전달할 카드를 먼저 선택하세요.")
                         (do (reset! notice "AI Context를 만드는 중…")
                             (fetch-post! "/api" {"action" "context" "keys" @context-selected} context-response-result))))
        commit-selected (fn []
                         (if (= (str-trim @commit-message) "")
                           (reset! error "커밋 메시지를 입력하세요")
                           (if (= (length @selected-files) 0)
                             (reset! error "커밋할 파일을 먼저 선택하세요.")
                             (do (reset! notice "선택한 파일을 커밋하는 중…")
                                 (send {"action" "commit-selected" "message" @commit-message "paths" @selected-files})
                                 (reset! commit-message "")))))
        select-repo (fn []
                      (if (= (str-trim @repo-input) "")
                        (reset! error "저장소 폴더 경로를 입력하세요")
                        (do (reset! notice "저장소 확인 중…") (send {"action" "select-repo" "path" @repo-input}))))
        open-repository (fn [path] (do (reset! repo-input path) (select-repo)))
        select-commit (fn [commit]
                        (do (reset! commit-message (or (get commit "message") "")) (reset! notice "커밋 상세 정보를 불러오는 중…") (fetch-post! "/api" {"action" "commit-detail" "hash" (get commit "hash")} commit-detail-result)))
        rail-tab (fn [name label]
                   (h "button" {:class (if (= @tab name) "rail-nav-item active" "rail-nav-item")
                                 :on-click (if (= name "compare") open-compare (if (or (= name "github") (= name "forgejo") (= name "gitlab") (= name "other")) (fn [] (open-provider-page name)) (fn [] (reset! tab name))))} label))
        view-tab (fn [name label]
                   (h "button" {:class (if (= @tab name) "tab active" "tab") :on-click (if (= name "compare") open-compare (fn [] (reset! tab name)))} label))
        status-card (fn [label value tone]
                      (h "div" {:class "stat-card"}
                        (str (h "span" {:class "stat-label"} label) (h "strong" {:class (str "tone-" tone)} (or value "—")))))
        provider-label (fn []
                        (let [provider (get (get @data "remote_info") "provider")]
                          (if (= provider "forgejo") "Forgejo (fg)" (if (= provider "github") "GitHub" (if (= provider "gitlab") "GitLab" "Remote")))))
        file-row (fn [line]
                   (h "div" {:class "file-row"}
                     (str (h "span" {:class "file-mark"} (if (> (str-count line "??") 0) "?" "M")) (h "code" {} line))))
        render-files (fn []
                      (let [raw (or (get @data "status") "")
                            lines (filter (fn [x] (> (length (str-trim x)) 0)) (regex_split raw "\\n"))]
                        (if (= (length lines) 0)
                          (h "div" {:class "empty"} "작업 트리가 깨끗합니다.")
                          (arr-join (map file-row lines) ""))))
        render-change-file (fn [file]
                            (let [path (get file "path")
                                  kind (get file "kind")]
                              (h "div" {:class (str "change-row " kind)}
                                (str (h "input" {:type "checkbox" :checked (file-selected? path) :on-change (fn [] (toggle-file path))})
                                     (h "span" {:class "change-kind"} (get {"modified" "M" "added" "A" "deleted" "D" "untracked" "?"} kind))
                                     (h "button" {:class "change-path" :title "서버 파일 보기" :on-click (fn [] (open-file "server" path))} path)
                                     (h "span" {:class "change-status"} (get file "status"))
                                     (h "button" {:class "change-action" :on-click (fn [] (change-action "stage-file" path))} "Stage")
                                     (h "button" {:class "change-action ghost" :on-click (fn [] (change-action "unstage-file" path))} "Unstage")))))
        change-group (fn [label kind]
                       (let [items (filter (fn [file] (= (get file "kind") kind)) (or (get @data "files") []))]
                         (if (= (length items) 0)
                           ""
                           (h "section" {:class (str "change-group " kind)}
                             (str (h "div" {:class "change-group-heading"}
                                      (str (h "strong" {} label) (h "span" {} (str (length items) "개"))))
                                  (arr-join (map render-change-file items) ""))))))
        commit-row (fn [commit]
                     (h "article" {:class "commit-row" :on-click (fn [] (select-commit commit))}
                       (str (h "div" {:class "commit-top"}
                              (h "code" {:class "commit-hash"} (get commit "hash"))
                              (h "span" {:class "commit-date"} (get commit "date")))
                            (h "div" {:class "commit-message"} (get commit "message"))
                            (h "div" {:class "commit-author"} (str "by " (get commit "author"))))))
        compare-file-row (fn [side path]
                           (h "button" {:class "compare-file-row" :title (str "서버 ↔ " (provider-label) " 비교: " path) :on-click (fn [] (open-file-compare path))}
                             (str (h "span" {:class "file-mark"} "•") (h "code" {} path))))
        compare-column (fn [title paths tone side]
                         (h "div" {:class (str "compare-column " tone)}
                           (str (h "div" {:class "compare-column-heading"}
                                    (h "h3" {} title)
                                    (h "span" {:class "compare-count"} (str (length paths) " files")))
                                (h "div" {:class "compare-files"}
                                  (if (= (length paths) 0)
                                    (h "div" {:class "empty"} "파일 없음")
                                    (arr-join (map (fn [path] (compare-file-row side path)) paths) ""))))))
        render-context-card (fn [card]
                              (let [key (get card "key")]
                                (h "article" {:class (if (context-card-selected? key) "context-card selected" "context-card")}
                                  (str (h "input" {:type "checkbox" :checked (context-card-selected? key) :on-change (fn [] (toggle-context-card key))})
                                       (h "div" {:class "context-card-number"} (get card "number"))
                                       (h "div" {:class "context-card-body"}
                                         (str (h "div" {:class "context-card-heading"}
                                                   (str (h "strong" {} (get card "title")) (h "code" {} (get card "key"))))
                                              (h "pre" {:class "context-card-content"} (or (get card "content") ""))))))))
        render-file-view (fn []
                           (if (= @file-view nil)
                             ""
                             (h "div" {:class "file-modal"}
                               (h "section" {:class "file-viewer"}
                                 (str (h "div" {:class "file-viewer-heading"}
                                          (str (h "div" {:class "file-viewer-title"} (get @file-view "path"))
                                               (h "span" {:class "file-viewer-source"} (str (get @file-view "side") " · 원문"))
                                               (h "button" {:class "button ghost file-viewer-close" :on-click (fn [] (reset! file-view nil))} "닫기")))
                                    (if (= (get @file-view "truncated") true)
                                      (h "div" {:class "file-viewer-note"} "파일이 너무 커 앞 200KB만 표시합니다.")
                                      "")
                                    (h "pre" {:class "file-viewer-content"} (get @file-view "content")))))))
        compare-pane (fn [label item tone]
                       (h "div" {:class (str "compare-pane " tone)}
                         (str (h "div" {:class "compare-pane-heading"} label)
                              (if (= (get item "ok") true)
                                (str (if (= (get item "truncated") true)
                                       (h "div" {:class "file-viewer-note"} "파일이 너무 커 앞 200KB만 표시합니다.")
                                       "")
                                     (h "pre" {:class "compare-pane-content"} (get item "content")))
                                (h "div" {:class "compare-pane-error"} (or (get item "error") "원격 파일을 불러올 수 없습니다."))))))
        render-compare-view (fn []
                              (if (= @compare-view nil)
                                ""
                                (h "div" {:class "file-modal"}
                                  (h "section" {:class "file-viewer compare-viewer"}
                                    (str (h "div" {:class "file-viewer-heading"}
                                             (str (h "div" {:class "file-viewer-title"} (get @compare-view "path"))
                                                  (h "span" {:class "file-viewer-source"} (str "서버 ↔ " (provider-label) " · " (get @compare-view "upstream")))
                                                  (h "button" {:class "button ghost file-viewer-close" :on-click (fn [] (reset! compare-view nil))} "닫기")))
                                         (h "div" {:class "compare-view-grid"}
                                           (str (compare-pane "SERVER · 작업 폴더" (get @compare-view "server") "server-pane")
                                                (compare-pane (str (provider-label) " · 원격") (get @compare-view "github") "github-pane"))))))))
        render-project-wizard (fn []
                                (h "section" {:class "panel project-wizard"}
                                  (str (h "div" {:class "panel-heading"}
                                           (str (h "div" {} (h "h2" {} "새 프로젝트 연결 마법사"))
                                                (h "span" {:class "wizard-step"} "1 · 서버 → GitHub")))
                                       (h "p" {:class "muted"} "서버 폴더를 선택하고 로컬 Git과 GitHub 저장소를 한 번에 준비합니다.")
                                       (h "label" {:class "wizard-label"} "서버 상위 폴더")
                                       (h "div" {:class "picker-row"}
                                         (h "input" {:class "repo-input" :type "text" :value @project-parent :placeholder "/home/kim/kim/projects" :on-input (fn [e] (reset! project-parent (.-value (.-target e))))})
                                         (h "button" {:class "button ghost picker-button" :on-click browse-project-folders} "폴더 찾기"))
                                       (if (= (length @project-folders) 0) ""
                                           (h "div" {:class "folder-list wizard-folders"}
                                             (arr-join (map (fn [folder] (h "button" {:class "folder-item" :on-click (fn [] (do (reset! project-parent folder) (reset! project-folders [])))} (str "📁 " folder))) @project-folders) "")))
                                       (h "label" {:class "wizard-label"} "새 프로젝트 이름")
                                       (h "input" {:class "repo-input wizard-input" :type "text" :value @project-name :placeholder "예: my-app" :on-input (fn [e] (reset! project-name (.-value (.-target e))))})
                                       (h "label" {:class "wizard-label"} "GitHub 저장소 이름 또는 기존 URL · 비워두면 로컬만 생성")
                                       (h "input" {:class "repo-input wizard-input" :type "text" :value @project-github :placeholder "새 이름 또는 https://github.com/owner/repo.git" :on-input (fn [e] (reset! project-github (.-value (.-target e))))})
                                       (h "div" {:class "wizard-options"}
                                         (str (h "button" {:class (if (= @project-visibility "private") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-visibility "private"))} "Private")
                                              (h "button" {:class (if (= @project-visibility "public") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-visibility "public"))} "Public")))
                                       (h "div" {:class "wizard-options"}
                                         (str (h "button" {:class (if (= @project-readme true) "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-readme (not @project-readme)))} "README 생성")
                                              (h "button" {:class (if (= @project-initial-push true) "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-initial-push (not @project-initial-push)))} "첫 Push")))
                                       (h "div" {:class "wizard-options"}
                                         (str (h "span" {:class "wizard-label inline-label"} ".gitignore")
                                              (h "button" {:class (if (= @project-gitignore "none") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-gitignore "none"))} "없음")
                                              (h "button" {:class (if (= @project-gitignore "node") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-gitignore "node"))} "Node")
                                              (h "button" {:class (if (= @project-gitignore "next") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-gitignore "next"))} "Next.js")
                                              (h "button" {:class (if (= @project-gitignore "python") "visibility-option active" "visibility-option") :on-click (fn [] (reset! project-gitignore "python"))} "Python")))
                                       (h "div" {:class "action-row"}
                                         (h "button" {:class "button primary" :on-click setup-project} "프로젝트 만들고 연결")))))
        provider-remotes-for (fn [provider]
                               (filter (fn [item] (= (get item "provider") provider))
                                       (or (get @data "remotes") [])))
        provider-current-for (fn [provider]
                               (let [items (provider-remotes-for provider)]
                                 (if (> (length items) 0)
                                   (first items)
                                   nil)))
        provider-active? (fn [provider]
                           (= (or (get (get @data "remote_info") "provider") "") provider))
        provider-url-guess (fn [provider value]
                             (let [v (str value)
                                   github? (or (str-contains v "github.com")
                                               (str-contains v "GitHub.com")
                                               (str-contains v "github:")
                                               (str-contains v "GitHub:"))
                                   forgejo? (or (str-contains v "fg.dclub.kr")
                                                (str-contains v "fg.dclub.jp")
                                                (str-contains v "forgejo-dclub:"))
                                   gitlab? (or (str-contains v "gitlab.com")
                                               (str-contains v "GitLab.com")
                                               (str-contains v "gitlab:")
                                               (str-contains v "GitLab:"))]
                               (if (= provider "github")
                                 github?
                                 (if (= provider "forgejo")
                                   forgejo?
                                   (if (= provider "gitlab")
                                     gitlab?
                                     (if (= provider "other")
                                       (and (not github?) (not forgejo?) (not gitlab?))
                                       true))))))
        render-provider-remote-row (fn [item]
                                     (h "div" {:class "provider-linked-row"}
                                       (str (h "strong" {} (or (get item "full_name") (str (get item "owner") "/" (get item "repository")) "—"))
                                            (h "span" {} (str (or (get item "name") "remote") " · " (or (get item "remote") ""))))))
        render-provider-commit-row (fn [commit]
                                     (h "div" {:class "provider-commit-row"}
                                       (str (h "code" {} (or (get commit "hash") "—"))
                                            (h "span" {} (or (get commit "message") "")))))
        render-provider-repo (fn [provider]
                               (fn [repo]
                                 (h "button" {:class "provider-repo-row"
                                               :on-click (fn []
                                                           (if (and (get repo "provider") (not (= (get repo "provider") provider)))
                                                             (reset! error (str "이 목록은 " provider " 전용입니다. 다른 provider 레포는 연결할 수 없습니다."))
                                                             (do (reset! error "")
                                                                 (reset! provider-selected-repo (or (get repo "full_name") (get repo "repository") ""))
                                                                 (reset! connect-remote-ref (or (get repo "remote") ""))
                                                                 (reset! notice (str provider " · " (or (get repo "full_name") (get repo "repository")) " 선택됨")))))}
                                   (str (h "div" {:class "provider-repo-main"}
                                            (str (h "strong" {} (or (get repo "full_name") (get repo "repository") "—"))
                                                 (h "span" {} (or (get repo "description") "설명 없음"))))
                                        (h "span" {:class "provider-repo-meta"} (str (if (= (get repo "private") true) "PRIVATE" "PUBLIC") " · " provider))))))
        render-provider-panel (fn [provider title host placeholder]
                                (let [linked (if (= provider "other")
                                               (filter (fn [item]
                                                         (and (not (= (get item "provider") "github"))
                                                              (not (= (get item "provider") "forgejo"))
                                                              (not (= (get item "provider") "gitlab"))))
                                                       (or (get @data "remotes") []))
                                               (provider-remotes-for provider))
                                      current (if (> (length linked) 0) (first linked) nil)
                                      active (provider-active? provider)
                                      sync (get @data "sync")
                                      commits (or (get @data "recent_commits") (get @data "commits") [])
                                      branch (or (get @data "branch") "—")
                                      upstream (or (get sync "upstream") "—")
                                      repo-rows (if (and (= @provider-repos-provider provider) (not (= provider "other")))
                                                  (filter (fn [repo]
                                                            (or (not (get repo "provider"))
                                                                (= (get repo "provider") provider)))
                                                          @provider-repos)
                                                  [])]
                                  (h "section" {:class "panel project-wizard provider-panel"}
                                    (str (h "style" {} ".provider-repo-list{display:grid;gap:7px;margin:14px 0;max-height:260px;overflow:auto}.provider-repo-row{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;text-align:left;background:#0d131d;border:1px solid var(--line);border-radius:9px;color:var(--text);padding:11px;cursor:pointer}.provider-repo-row:hover{border-color:var(--blue);background:#17243a}.provider-repo-main{min-width:0}.provider-repo-main strong{display:block;font:12px ui-monospace,monospace}.provider-repo-main span{display:block;margin-top:5px;color:var(--muted);font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.provider-repo-meta{flex:none;color:var(--muted);font:9px ui-monospace,monospace}.provider-selection{margin:14px 0;padding:12px;background:#142039;border:1px solid #365274;border-radius:9px}.provider-selection span{display:block;color:var(--muted);font:10px ui-monospace,monospace}.provider-selection strong{display:block;margin-top:6px;color:var(--text);font:12px ui-monospace,monospace}.provider-selection p{margin:7px 0 0;color:var(--muted);font-size:11px}.provider-section{margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}.provider-section h3{margin:0 0 10px;font-size:13px}.provider-linked-list,.provider-commit-list{display:grid;gap:7px;max-height:260px;overflow:auto}.provider-linked-row,.provider-commit-row{background:#0d131d;border:1px solid var(--line);border-radius:8px;padding:10px}.provider-linked-row strong,.provider-commit-row code{display:block;font:11px ui-monospace,monospace}.provider-linked-row span,.provider-commit-row span{display:block;margin-top:5px;color:var(--muted);font:11px ui-monospace,monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.provider-sync-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.provider-note{margin:8px 0 0;color:var(--muted);font-size:11px}@media(max-width:760px){.provider-sync-grid{grid-template-columns:1fr}}")
                                         (h "div" {:class "panel-heading"}
                                             (str (h "div" {} (h "h2" {} title))
                                                  (h "span" {:class "wizard-step"} (str host " 전용"))))
                                         (h "p" {:class "muted"} (str title " 화면에서는 이 provider의 레포·remote·동기화만 다룹니다. 다른 provider remote/branch를 섞지 않습니다."))
                                         (h "div" {:class "provider-facts"}
                                           (str (h "div" {:class "provider-fact"} (h "span" {} "PROVIDER") (h "strong" {} title))
                                                (h "div" {:class "provider-fact"} (h "span" {} "HOST") (h "strong" {} host))
                                                (h "div" {:class "provider-fact"} (h "span" {} "LOCAL BRANCH") (h "strong" {} branch))
                                                (h "div" {:class "provider-fact"} (h "span" {} "LINKED") (h "strong" {} (if (= current nil) "이 provider 미연결" (or (get current "full_name") (get current "repository") "연결됨"))))))
                                         (h "div" {:class "provider-section"}
                                           (str (h "h3" {} (str title " 연결 remote"))
                                                (if (= (length linked) 0)
                                                  (h "div" {:class "empty"} (str "로컬에 " title " remote가 없습니다."))
                                                  (h "div" {:class "provider-linked-list"} (arr-join (map render-provider-remote-row linked) "")))))
                                         (h "div" {:class "provider-section"}
                                           (str (h "h3" {} "동기화 상태")
                                                (if (= active true)
                                                  (h "div" {:class "provider-sync-grid"}
                                                    (str (h "div" {:class "provider-fact"} (h "span" {} "UPSTREAM") (h "strong" {} upstream))
                                                         (h "div" {:class "provider-fact"} (h "span" {} "MATCH") (h "strong" {} (str (get sync "match"))))
                                                         (h "div" {:class "provider-fact"} (h "span" {} "LOCAL HEAD") (h "strong" {} (or (get sync "local_head") "—")))
                                                         (h "div" {:class "provider-fact"} (h "span" {} "REMOTE HEAD") (h "strong" {} (or (get sync "remote_head") "—")))))
                                                  (h "div" {:class "empty"} (str "현재 upstream이 " title "가 아니므로 이 패널에서는 sync를 표시하지 않습니다.")))))
                                         (if (= provider "other")
                                           ""
                                           (h "div" {:class "provider-section"}
                                             (str (h "h3" {} "쓰기 작업")
                                                  (h "p" {:class "provider-note"} "confirm 전에 provider → repository → branch를 표시합니다. 이 패널의 provider와 대상이 다르면 서버가 거부합니다.")
                                                  (h "div" {:class "provider-facts"}
                                                    (str (h "div" {:class "provider-fact"} (h "span" {} "WRITE PROVIDER") (h "strong" {} title))
                                                         (h "div" {:class "provider-fact"} (h "span" {} "WRITE REPO") (h "strong" {} (if (= current nil) "미연결" (or (get current "full_name") (get current "repository") "—"))))
                                                         (h "div" {:class "provider-fact"} (h "span" {} "WRITE BRANCH") (h "strong" {} branch))
                                                         (h "div" {:class "provider-fact"} (h "span" {} "ACTIVE") (h "strong" {} (if (= active true) "yes" "no")))))
                                                  (if (= active true)
                                                    (h "div" {:class "action-row"}
                                                      (str (h "button" {:class "button secondary" :on-click (fn [] (do-provider-write "fetch" provider))} "Fetch")
                                                           (h "button" {:class "button secondary" :on-click (fn [] (do-provider-write "pull" provider))} "Pull")
                                                           (h "button" {:class "button primary" :on-click (fn [] (do-provider-write "push" provider))} "Push")))
                                                    (h "p" {:class "provider-note"} (str "현재 활성 provider가 " title "가 아니므로 Fetch/Pull/Push를 이 패널에서 실행하지 않습니다."))))))
                                         (h "div" {:class "provider-section"}
                                           (str (h "h3" {} "최근 커밋 (로컬)")
                                                (h "p" {:class "provider-note"} "로컬 작업 트리 이력입니다. 다른 provider branch 목록과 섞지 않습니다.")
                                                (if (= (length commits) 0)
                                                  (h "div" {:class "empty"} "커밋이 없습니다.")
                                                  (h "div" {:class "provider-commit-list"} (arr-join (map render-provider-commit-row commits) "")))))
                                         (if (= provider "other")
                                           (h "p" {:class "provider-note"} "기타 Provider는 읽기 전용 요약입니다. GitLab은 별도 탭에서 adapter·쓰기를 제공합니다.")
                                           (str (h "div" {:class "panel-heading"}
                                                  (str (h "h3" {} (str title " 레포지토리"))
                                                       (h "button" {:class "button ghost" :on-click (fn [] (load-provider-repos provider))} "새로고침")))
                                                (if (= @provider-repos-loading true)
                                                  (h "div" {:class "empty"} (str title " 레포 목록을 불러오는 중…"))
                                                  (if (not (= @provider-repos-provider provider))
                                                    (h "div" {:class "empty"} (str title " 레포 목록을 불러오세요."))
                                                    (if (= (length repo-rows) 0)
                                                      (h "div" {:class "empty"} (str title " 레포가 없거나 목록을 읽지 못했습니다."))
                                                      (h "div" {:class "provider-repo-list"} (arr-join (map (render-provider-repo provider) repo-rows) "")))))
                                                (h "div" {:class "provider-selection"}
                                                  (str (h "span" {} (str title "에서 선택한 원격 레포"))
                                                       (h "strong" {} (if (= @provider-selected-repo "") "레포 목록에서 먼저 선택하세요." @provider-selected-repo))
                                                       (h "p" {} "다른 provider 화면의 remote는 여기 입력란에 넣지 마세요. 서버도 provider 불일치를 거부합니다.")))
                                                (h "div" {:class "selected-folder"} (str "현재 저장소: " (or (get @data "root") "—")))
                                                (h "label" {:class "wizard-label"} (str title " 연결 대상 Remote"))
                                                (h "input" {:class "repo-input wizard-input" :type "text" :value @connect-remote-ref :placeholder placeholder
                                                             :on-input (fn [e]
                                                                         (let [value (.-value (.-target e))]
                                                                           (do (reset! connect-remote-ref value)
                                                                               (if (and (> (length (str-trim value)) 0)
                                                                                        (not (provider-url-guess provider value)))
                                                                                 (reset! error (str "이 입력은 " title " 형식이 아닙니다."))
                                                                                 (reset! error "")))))})
                                                (h "div" {:class "action-row"}
                                                  (h "button" {:class "button primary"
                                                                :on-click (fn []
                                                                            (if (not (provider-url-guess provider @connect-remote-ref))
                                                                              (reset! error (str "현재 페이지는 " title " 전용입니다. 다른 provider Remote는 연결할 수 없습니다."))
                                                                              (connect-remote)))}
                                                    (str title " origin 연결 (Push 없음)")))))))))
        render-connect-panel (fn []
                               (str
                                 (h "style" {} ".provider-switch{margin-top:22px;background:#0d131d;border:1px solid var(--line);border-radius:16px;padding:16px}.provider-switch-heading{display:flex;justify-content:space-between;gap:12px;align-items:center}.provider-switch-buttons{display:flex;gap:8px;margin-top:14px}.provider-switch-button{flex:1;border:1px solid var(--line);border-radius:9px;background:#182235;color:var(--muted);padding:11px 14px;font-weight:800;cursor:pointer}.provider-switch-button.active{border-color:var(--blue);background:#1d2b46;color:var(--text)}.provider-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:14px 0}.provider-fact{background:#0d131d;border:1px solid var(--line);border-radius:8px;padding:10px}.provider-fact span{display:block;color:var(--muted);font:9px ui-monospace,monospace;letter-spacing:.1em}.provider-fact strong{display:block;margin-top:6px;color:var(--text);font:11px ui-monospace,monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}@media(max-width:760px){.provider-facts{grid-template-columns:1fr}}")
                                 (h "section" {:class "provider-switch"}
                                   (str
                                     (h "div" {:class "provider-switch-heading"}
                                       (str (h "span" {:class "rail-section-label"} "GIT PROVIDER")
                                            (h "span" {:class "muted"} "원격 화면을 provider별로 분리")))
                                     (h "div" {:class "provider-switch-buttons"}
                                       (str (h "button" {:class (if (= @remote-provider "github") "provider-switch-button active" "provider-switch-button") :on-click (fn [] (open-provider-page "github"))} "GitHub")
                                            (h "button" {:class (if (= @remote-provider "forgejo") "provider-switch-button active" "provider-switch-button") :on-click (fn [] (open-provider-page "forgejo"))} "Forgejo (fg)")
                                            (h "button" {:class (if (= @remote-provider "gitlab") "provider-switch-button active" "provider-switch-button") :on-click (fn [] (open-provider-page "gitlab"))} "GitLab")
                                            (h "button" {:class (if (= @remote-provider "other") "provider-switch-button active" "provider-switch-button") :on-click (fn [] (open-provider-page "other"))} "기타"))))))
                                 (if (= @remote-provider "forgejo")
                                   (render-provider-panel "forgejo" "Forgejo (fg)" "fg.dclub.kr" "forgejo-dclub:owner/repo.git 또는 https://fg.dclub.kr/owner/repo.git")
                                   (if (= @remote-provider "gitlab")
                                     (render-provider-panel "gitlab" "GitLab" "gitlab.com" "https://gitlab.com/group/repo.git 또는 git@gitlab.com:group/repo.git")
                                     (if (= @remote-provider "other")
                                       (render-provider-panel "other" "기타 Provider" "unknown" "지원 adapter 없음 · 읽기 전용")
                                       (render-provider-panel "github" "GitHub" "github.com" "owner/repo 또는 https://github.com/owner/repo.git")))))
        render-compare (fn []
                        (let [server-files (or (get @file-compare "server_files") [])
                              github-files (or (get @file-compare "github_files") [])]
                          (h "section" {:class "compare-shell"}
                            (str (h "div" {:class "compare-toolbar"}
                                     (str (h "div" {:class "compare-title"} (str "서버 ↔ " (provider-label) " 파일 비교"))
                                          (h "span" {:class "compare-ref"} (str "원격 " (or (get @file-compare "upstream") "—")))
                                          (h "button" {:class "button ghost" :on-click open-compare} "새로고침")))
                                 (h "div" {:class "compare-grid"}
                                   (str (compare-column "1 · 서버 작업 폴더" server-files "server-column" "server")
                                        (compare-column (str "2 · " (provider-label) " 원격") github-files "github-column" "github")))
                                 ""))))
        render-conflicts (fn []
                           (if (= (length @conflict-files) 0)
                             ""
                             (h "section" {:class "conflict-banner"}
                               (str (h "div" {:class "conflict-heading"}
                                        (str (h "strong" {} "충돌 해결 필요")
                                             (h "span" {} (str (length @conflict-files) "개 파일이 충돌 중"))))
                                    (h "p" {:class "conflict-copy"} "Pull 결과를 반영하려면 아래 파일의 충돌을 직접 해결한 뒤 다시 Stage하세요.")
                                    (h "div" {:class "conflict-files"}
                                     (arr-join (map (fn [path]
                                                       (h "button" {:class "conflict-file" :on-click (fn [] (open-file "server" path))}
                                                         (str "⚠ " path))) @conflict-files) ""))))))
        render-branches (fn []
                          (h "div" {:class "branch-panel"}
                            (str (h "div" {:class "branch-panel-heading"}
                                     (str (h "strong" {} "Branch")
                                          (h "span" {} (str (length (or (get @data "branches") [])) "개"))))
                                 (h "div" {:class "branch-list"}
                                   (arr-join (map (fn [name]
                                                    (h "button" {:class (if (= name (get @data "branch")) "branch-item active" "branch-item")
                                                                  :on-click (fn [] (if (= name (get @data "branch")) nil (switch-branch name)))}
                                                      (str (if (= name (get @data "branch")) "● " "○ ") name)))
                                                 (or (get @data "branches") [])) ""))
                                 (h "div" {:class "branch-create"}
                                   (str (h "input" {:type "text" :placeholder "feature/my-branch" :value @branch-name :on-input (fn [e] (reset! branch-name (.-value (.-target e))))})
                                        (h "button" {:class "button primary" :on-click create-branch} "생성"))))))
        render-commits (fn []
                         (let [commits (or (get @data "commits") [])]
                           (if (= (length commits) 0)
                             (h "div" {:class "empty"} "커밋이 없습니다.")
                             (arr-join (map commit-row commits) ""))))
        render-airc (fn []
                      (let [documents (or (get @data "airc_documents") [])
                            selected (first (filter (fn [document] (= (get document "path") @airc-selected)) documents))]
                        (h "section" {:class "panel airc-panel"}
                          (str (h "style" {} ".airc-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:14px}.airc-files{display:flex;flex-direction:column;gap:7px}.airc-file{appearance:none;text-align:left;border:1px solid var(--line);border-radius:9px;background:#0d131d;color:var(--muted);padding:10px;cursor:pointer;font:11px ui-monospace,monospace}.airc-file.active{border-color:var(--blue);color:var(--text);background:#142039}.airc-viewer{min-width:0}.airc-viewer pre{max-height:680px;overflow:auto;margin:0;padding:16px;background:#0a0f17;border:1px solid var(--line);border-radius:10px;color:#c6d1e1;font:11px/1.55 ui-monospace,SFMono-Regular,monospace;white-space:pre-wrap}@media(max-width:760px){.airc-layout{grid-template-columns:1fr}}")
                               (h "div" {:class "panel-heading"}
                                 (str (h "h2" {} "AIRC 프로젝트 문서")
                                      (h "span" {:class "muted"} "현재 저장소 원문")))
                               (h "p" {:class "muted"} "프로젝트 계승 문서와 정본 사양을 읽기 전용으로 표시합니다.")
                               (h "div" {:class "airc-layout"}
                                 (h "div" {:class "airc-files"}
                                   (arr-join
                                     (map (fn [document]
                                            (let [path (get document "path")
                                                  available (= (get document "available") true)]
                                              (h "button" {:class (if (= @airc-selected path) "airc-file active" "airc-file")
                                                            :on-click (fn [] (reset! airc-selected path))}
                                                (str (if available "● " "○ ") path))))
                                           documents)
                                     ""))
                                 (h "div" {:class "airc-viewer"}
                                   (if (= selected nil)
                                     (h "div" {:class "empty"} "AIRC 문서가 없습니다.")
                                     (h "pre" {} (if (= (get selected "available") true) (get selected "content") "파일이 없습니다."))))))))) ]
    (when (not @loaded) (do (reset! loaded true) (fetch! "/api" reload)))
    (h "main" {:class "app-shell"}
      (str
        (h "aside" {:class "desktop-rail"}
          (str (h "div" {:class "rail-brand"} (h "span" {:class "brand-dot"} "●") "fl-git")
               (h "div" {:class "rail-kicker"} "SERVER REPOSITORIES")
               (h "div" {:class "rail-repo-toolbar"}
                 (str (h "span" {:class "rail-section-label"} (str "저장소 " (length @repositories) "개"))
                      (h "button" {:class "rail-refresh" :title "서버 저장소 새로고침" :on-click browse-repositories} "↻")))
               (if (= (length @repositories) 0)
                 (h "div" {:class "rail-empty"} "새로고침을 눌러 저장소를 불러오세요.")
                 (h "div" {:class "rail-repositories"}
                   (arr-join
                     (map (fn [path]
                            (h "button" {:class (if (= path (get @data "root")) "rail-repo active" "rail-repo")
                                          :title path
                                          :on-click (fn [] (open-repository path))}
                              (str (h "span" {:class "rail-repo-dot"} (if (= path (get @data "root")) "●" "○"))
                                   (h "span" {:class "rail-repo-path"} path))))
                           @repositories)
                     "")))
               (h "div" {:class "rail-current"}
                 (str (h "div" {:class "rail-section-label"} "CURRENT")
                      (h "strong" {} (or (get @data "root") "선택된 저장소 없음"))
                      (h "span" {:class (if (= (get (get @data "remote_info") "configured") true) "rail-github connected" "rail-github")}
                        (if (= (get (get @data "remote_info") "configured") true)
                          (str "● " (get (get @data "remote_info") "provider") " · " (or (get (get @data "remote_info") "full_name") (get (get @data "remote_info") "repository") "연결됨"))
                          "○ Remote 미연결"))))
               (h "nav" {:class "rail-nav"}
                 (str (h "style" {} ".rail-nav-item{appearance:none;width:100%;border:0;background:transparent;text-align:left;cursor:pointer;font:inherit}.rail-nav-group{margin-bottom:18px}.rail-nav-label{display:block;color:var(--muted);font:10px ui-monospace,monospace;letter-spacing:.14em;padding:0 10px 7px}")
                      (h "div" {:class "rail-nav-group"}
                        (str (h "span" {:class "rail-nav-label"} "WORKSPACE")
                             (rail-tab "overview" "Workspace")
                             (rail-tab "changes" "Changes")
                             (rail-tab "compare" "Diff")
                             (rail-tab "context" "AI Context")
                             (rail-tab "airc" "AIRC Docs")))
                      (h "div" {:class "rail-nav-group"}
                        (str (h "span" {:class "rail-nav-label"} "REPOSITORY")
                             (rail-tab "project" "New Project")
                             (rail-tab "remote" "Remote & Commits")))
                      (h "div" {:class "rail-nav-group"}
                        (str (h "span" {:class "rail-nav-label"} "GIT PROVIDERS")
                             (rail-tab "github" "GitHub")
                             (rail-tab "forgejo" "Forgejo (fg)")
                             (rail-tab "gitlab" "GitLab")
                             (rail-tab "other" "기타 Provider")))))
               (h "div" {:class "rail-footer"}
                 (str (h "span" {:class "online-dot"} "●") " DESKTOP MODE"))))
        (h "header" {:class "topbar"}
          (str (h "div" {:class "brand"} (h "span" {:class "brand-dot"} "●") "fl-git")
               (h "div" {:class "connection"} (h "span" {:class "online-dot"} "●") "LOCAL REPOSITORY")))
        (if (> (length @error) 0) (h "div" {:class "toast error"} @error) "")
        (if (> (length @notice) 0) (h "div" {:class "toast"} @notice) "")
        (render-file-view)
        (render-compare-view)
        (h "section" {:class "shell-meta"}
          (str (h "div" {:class "shell-meta-item root-meta"}
                   (str (h "span" {:class "shell-meta-label"} "ROOT")
                        (h "strong" {} (or (get @data "root") "—"))))
               (h "div" {:class "shell-meta-item"}
                 (str (h "span" {:class "shell-meta-label"} "BRANCH")
                      (h "strong" {} (or (get @data "branch") "—"))))
               (h "div" {:class "shell-meta-item"}
                 (str (h "span" {:class "shell-meta-label"} "UPSTREAM")
                      (h "strong" {} (or (get (get @data "sync") "upstream") "—"))))
               (h "div" {:class "shell-meta-item compact-meta"}
                 (str (h "span" {:class "shell-meta-label"} "SYNC")
                      (h "strong" {} (str "↑" (or (get (get @data "sync") "ahead") "—") "  ↓" (or (get (get @data "sync") "behind") "—")))))))
        (render-conflicts)
        (if (= @tab "overview")
          (str
            (h "section" {:class "hero"}
              (str (h "div" {:class "eyebrow"} "GIT WORKSPACE / WEB CONTROL")
                   (h "h1" {} "코드의 흐름을 한 화면에서.")
                   (h "p" {:class "hero-copy"} "터미널 명령을 기억하지 않아도 됩니다. 현재 저장소를 확인하고, 변경을 고르고, 커밋까지 클릭으로 처리하세요.")))
            (h "section" {:class "repo-bar"}
              (str (h "div" {:class "repo-picker"}
                        (str (h "span" {:class "muted"} "관리할 저장소 폴더")
                             (h "div" {:class "picker-row"}
                               (h "input" {:class "repo-input" :type "text" :value @repo-input :placeholder "/home/kim/kim/projects/my-repo" :on-input (fn [e] (reset! repo-input (.-value (.-target e))))})
                               (h "button" {:class "button primary picker-button" :on-click select-repo} "저장소 열기")
                               (h "button" {:class "button ghost picker-button" :on-click browse-folders} "폴더 선택")
                               (h "button" {:class "button ghost picker-button" :on-click browse-repositories} "서버 저장소"))))
                        (if (= (length @folders) 0)
                          ""
                          (h "div" {:class "folder-list"}
                            (arr-join (map (fn [folder] (h "button" {:class "folder-item" :on-click (fn [] (do (reset! repo-input folder) (reset! folders [])))} (str "📁 " folder))) @folders) "")))
                        (if (= (length @repositories) 0)
                          ""
                          (str (h "div" {:class "repo-list-heading"} (str "서버 Git 저장소 · " (length @repositories) "개"))
                               (h "div" {:class "folder-list repo-list"}
                                 (arr-join (map (fn [path] (h "button" {:class "folder-item repo-item" :title path :on-click (fn [] (open-repository path))} (str "◆ " path))) @repositories) ""))))
                        (h "div" {:class "selected-folder"} (str "선택 경로: " (or @repo-input "—"))))
                   (h "div" {:class "branch-pill"} (str "⎇ " (or (get @data "branch") "—")))))
            (h "section" {:class "stats-grid"}
              (str (status-card "BRANCH" (get @data "branch") "blue")
                   (status-card "REMOTE" (if (> (length (or (get @data "remote") "")) 0) "CONNECTED" "LOCAL ONLY") "green")
                   (status-card "CHANGES" (if (= (str-trim (or (get @data "status") "")) "") "0" "OPEN") "orange")))
            (h "section" {:class "source-grid"}
              (str (h "div" {:class "source-card server-source"}
                       (str (h "div" {:class "source-label"} "SERVER")
                            (h "strong" {} (or (get @data "root") "—"))
                            (h "div" {:class "source-meta"} (str "branch " (or (get @data "branch") "—")))))
                   (h "div" {:class "source-card remote-source"}
                     (str (h "div" {:class "source-label"} "REMOTE")
                          (h "strong" {} (if (= (get (get @data "remote_info") "configured") true) (or (get (get @data "remote_info") "full_name") (get (get @data "remote_info") "repository")) "연결 정보 없음"))
                          (h "div" {:class "source-meta"}
                            (str "provider " (or (get (get @data "remote_info") "provider") "none")
                                 " · host " (or (get (get @data "remote_info") "host") "—")
                                 " · auth " (or (get (get @data "remote_info") "auth") "—")
                                 " · branch " (or (get (get @data "remote_info") "branch") "—")
                                 " · ↑" (or (get (get @data "sync") "ahead") "—")
                                 " ↓" (or (get (get @data "sync") "behind") "—"))))))))
            (h "section" {:class "provider-directory"}
              (str (h "style" {} ".provider-directory{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}.provider-directory-card{display:block;width:100%;text-align:left;background:#111925;border:1px solid var(--line);border-radius:14px;color:var(--text);padding:16px;cursor:pointer}.provider-directory-card:hover{border-color:var(--blue);background:#17243a}.provider-directory-card strong{display:block;font-size:14px}.provider-directory-card span{display:block;margin-top:7px;color:var(--muted);font:11px ui-monospace,monospace}@media(max-width:1000px){.provider-directory{grid-template-columns:1fr}}")
                   (h "button" {:class "provider-directory-card" :on-click (fn [] (open-provider-page "github"))}
                     (str (h "strong" {} "GitHub") (h "span" {} "github.com · GitHub 저장소 관리 화면 열기 →")))
                   (h "button" {:class "provider-directory-card" :on-click (fn [] (open-provider-page "forgejo"))}
                     (str (h "strong" {} "Forgejo (fg)") (h "span" {} "fg.dclub.kr · 우리 Forgejo 저장소 관리 화면 열기 →")))
                   (h "button" {:class "provider-directory-card" :on-click (fn [] (open-provider-page "gitlab"))}
                     (str (h "strong" {} "GitLab") (h "span" {} "gitlab.com · glab adapter · 목록·쓰기 게이트 →")))
                   (h "button" {:class "provider-directory-card" :on-click (fn [] (open-provider-page "other"))}
                     (str (h "strong" {} "기타 Provider") (h "span" {} "unknown · 읽기 전용 요약 →"))))
                 (h "section" {:class "panel create-panel"}
                   (str (h "div" {:class "panel-heading"} (h "h2" {} "새 저장소 만들기"))
                        (h "p" {:class "muted"} "현재 폴더에 새 로컬 Git 저장소를 생성합니다.")
                        (h "div" {:class "picker-row"}
                          (h "input" {:class "repo-input" :type "text" :value @new-repo-name :placeholder "예: my-new-repo" :on-input (fn [e] (reset! new-repo-name (.-value (.-target e))))})
                          (h "button" {:class "button primary picker-button" :on-click create-repo} "저장소 생성")))))
          "")
        (h "aside" {:class (if (= @right-open true) "desktop-detail" "desktop-detail collapsed")}
          (if (= @right-open true)
            (str (h "div" {:class "detail-heading"}
                     (str (h "span" {} "DETAIL")
                          (h "button" {:class "detail-toggle" :on-click (fn [] (reset! right-open false))} "접기")))
                 (h "div" {:class "detail-placeholder"}
                   (str (h "strong" {} "선택 항목 상세")
                        (h "p" {} "변경 파일을 선택하면 Diff와 파일 내용을 이 영역에 표시합니다."))))
            (h "button" {:class "detail-expand" :on-click (fn [] (reset! right-open true))} "‹")))
        (if (= @tab "airc")
          (render-airc)
          (if (= @tab "context")
          (h "section" {:class "panel context-panel"}
            (str (h "style" {} ".context-readiness{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.context-readiness-item{border:1px solid var(--line);border-radius:999px;padding:6px 9px;color:var(--muted);font:10px ui-monospace,monospace}.context-card-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:16px}.context-card{display:grid;grid-template-columns:auto 32px 1fr;gap:9px;align-items:start;background:#0d131d;border:1px solid var(--line);border-radius:10px;padding:12px;min-width:0}.context-card.selected{border-color:var(--blue);background:#142039}.context-card input{margin-top:3px;accent-color:var(--blue)}.context-card-number{color:var(--blue);font:11px ui-monospace,monospace;font-weight:800}.context-card-body{min-width:0}.context-card-heading{display:flex;justify-content:space-between;gap:8px;align-items:center}.context-card-heading strong{font-size:12px}.context-card-heading code{color:var(--muted);font:10px ui-monospace,monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.context-card-content{max-height:130px;overflow:auto;margin:8px 0 0;color:#c6d1e1;font:11px/1.55 ui-monospace,SFMono-Regular,monospace;white-space:pre-wrap}.context-response-heading{margin-top:20px;color:var(--blue);font-size:11px;font-weight:800;letter-spacing:.08em}@media(max-width:1000px){.context-card-list{grid-template-columns:1fr}}")
                 (h "div" {:class "panel-heading"}
                     (str (h "h2" {} "AI Context 카드")
                          (h "span" {:class "muted"} (str (length @context-selected) "개 선택"))))
                 (h "p" {:class "muted"} "카드를 선택하면 선택한 정보만 API 응답으로 전달합니다. 전체 상태는 POST /api action=ai-context, 저장소 검색은 POST /api action=ai-search로 제공합니다.")
                 (h "div" {:class "context-readiness"}
                   (str (h "span" {:class "context-readiness-item"}
                              (str "AIRC " (if (= (get (get @data "continuity") "available") true) "연결됨" "없음")))
                        (h "span" {:class "context-readiness-item"}
                              (str "변경 위험도 " (or (get (get @data "change_risk") "level") "—")))
                        (h "span" {:class "context-readiness-item"}
                              (str "현재 작업 " (or (get (get @data "continuity") "hot") "—")))))
                 (h "div" {:class "context-card-list"}
                   (arr-join (map render-context-card (or (get @data "context_cards") [])) ""))
                 (h "div" {:class "action-row"}
                   (str (h "button" {:class "button primary" :on-click send-context} "선택 카드 전달")
                        (h "button" {:class "button ghost" :on-click (fn [] (do (reset! context-selected []) (reset! context-response nil)))} "선택 해제")))
                 (if (= @context-response nil)
                   ""
                   (str (h "div" {:class "context-response-heading"} "API 응답 · AI 전달용 Markdown")
                        (h "pre" {:class "context-output"} (or (get @context-response "markdown") ""))))))
          (if (= @tab "project")
            (render-project-wizard)
            (if (= @tab "github")
              (render-provider-panel "github" "GitHub" "github.com" "owner/repo 또는 https://github.com/owner/repo.git")
              (if (= @tab "forgejo")
                (render-provider-panel "forgejo" "Forgejo (fg)" "fg.dclub.kr" "forgejo-dclub:owner/repo.git 또는 https://fg.dclub.kr/owner/repo.git")
                (if (= @tab "gitlab")
                  (render-provider-panel "gitlab" "GitLab" "gitlab.com" "https://gitlab.com/group/repo.git 또는 git@gitlab.com:group/repo.git")
                  (if (= @tab "other")
                  (render-provider-panel "other" "기타 Provider" "unknown" "지원 adapter 없음 · 읽기 전용")
                  (if (= @tab "remote")
                    (render-connect-panel)
                    (if (= @tab "compare")
                      (if (= @file-compare nil)
                        (h "section" {:class "panel compare-loading"} "파일 비교 정보를 불러오는 중…")
                        (render-compare))
                      (if (= @tab "changes")
                        (h "section" {:class "columns"}
                          (str (h "div" {:class "panel"}
                                   (str (h "div" {:class "panel-heading"} (h "h2" {} "변경 파일"))
                                        (h "div" {:class "change-summary"} (str "선택 " (length @selected-files) "개 · 전체 " (length (or (get @data "files") [])) "개"))
                                        (h "div" {:class "change-list"}
                                          (str (change-group "Modified" "modified")
                                               (change-group "Added" "added")
                                               (change-group "Deleted" "deleted")
                                               (change-group "Untracked" "untracked")))
                                        (h "div" {:class "action-row"}
                                          (str (h "button" {:class "button secondary" :on-click (fn [] (selected-action "stage-files"))} "선택 Stage")
                                               (h "button" {:class "button ghost" :on-click (fn [] (selected-action "unstage-files"))} "선택 Unstage")
                                               (h "button" {:class "button dark" :on-click (fn [] (do-action "add-all"))} "전체 Stage")))
                                        (h "div" {:class "commit-box selected-commit-box"}
                                          (str (h "label" {} (str "선택 파일 커밋 · " (length @selected-files) "개"))
                                               (h "input" {:type "text" :placeholder "예: fix: update selected files" :value @commit-message :on-input (fn [e] (reset! commit-message (.-value (.-target e))))})
                                               (h "button" {:class "button primary" :on-click commit-selected} "선택 파일 커밋")))))
                               (h "div" {:class "panel diff-panel"}
                                 (str (h "div" {:class "panel-heading"} (h "h2" {} "Diff 미리보기"))
                                      (h "pre" {:class "diff-output"} (or (get @data "diff") "변경 내용이 없습니다."))))))
                        (h "section" {:class "columns"}
                          (str (h "div" {:class "panel"}
                                   (str (h "div" {:class "panel-heading"} (h "h2" {} "빠른 작업"))
                                        (h "p" {:class "muted"} "원격 작업은 서버에서 확인 후 실행됩니다.")
                                        (h "div" {:class "action-grid"}
                                          (str (h "button" {:class "button secondary" :on-click (fn [] (do-action "fetch"))} "Fetch")
                                               (h "button" {:class "button secondary" :on-click (fn [] (do-action "pull"))} "Pull")
                                               (h "button" {:class "button primary" :on-click (fn [] (do-action "push"))} "Push")))
                                        (h "div" {:class "commit-box"}
                                          (str (h "label" {} "로컬 커밋")
                                               (h "input" {:type "text" :placeholder "예: feat: update landing page" :value @commit-message :on-input (fn [e] (reset! commit-message (.-value (.-target e))))})
                                               (h "button" {:class "button primary" :on-click commit-push} "Commit & Push")))
                                        (render-branches)))
                               (h "div" {:class "panel"}
                                 (str (h "div" {:class "panel-heading"} (h "h2" {} "최근 커밋"))
                                      (h "div" {:class "commit-list"} (render-commits))
                                      (if (= @commit-detail nil)
                                        ""
                                        (h "div" {:class "commit-detail"}
                                          (str (h "div" {:class "commit-detail-heading"} "커밋 상세 · 클릭한 커밋의 변경 내용")
                                               (h "pre" {:class "commit-detail-output"} (get @commit-detail "detail")))))))))))))))
)))))))

(defn render [req]
  (server_header
    (server_html
      (h "html" {:lang "ko"}
        (str
          (h "head" {}
                 (str (h! "meta" {:charset "utf-8"})
                      (h! "meta" {:name "viewport" :content "width=device-width,initial-scale=1"})
                 (h! "link" {:rel "icon" :href "data:,"})
                 (h "title" {} "fl-git · Git Workspace")
                 """
<style>
:root{color-scheme:dark;--bg:#0a0d12;--surface:#111722;--line:#273244;--text:#f4f7fb;--muted:#8d9aae;--blue:#7c9cff;--green:#61d8a2;--orange:#f7a45b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.layout_nav{display:none}.layout_main{max-width:none!important;padding:0!important}.app-shell{min-height:100vh;max-width:1240px;margin:0 auto;padding:28px 42px 64px}.topbar{display:flex;justify-content:space-between;align-items:center;padding-bottom:34px;border-bottom:1px solid var(--line)}.brand{font-weight:800;font-size:20px;letter-spacing:-.04em}.brand-dot{color:var(--blue);font-size:13px;margin-right:8px}.connection{font-size:10px;letter-spacing:.18em;color:var(--muted)}.online-dot{color:var(--green);font-size:12px;margin-right:8px}.hero{padding:64px 0 38px;max-width:780px}.eyebrow{color:var(--blue);font-size:11px;font-weight:800;letter-spacing:.2em;margin-bottom:18px}.hero h1{font-size:clamp(38px,6vw,74px);line-height:.98;letter-spacing:-.075em;margin:0 0 24px}.hero-copy{color:var(--muted);font-size:17px;line-height:1.75;max-width:650px}.repo-bar{display:flex;align-items:center;justify-content:space-between;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px 22px;margin-bottom:16px}.repo-bar strong{display:block;margin-top:5px;font-family:ui-monospace,monospace;font-size:14px;word-break:break-all}.muted,.stat-label{color:var(--muted);font-size:12px}.branch-pill{background:#202b42;color:var(--blue);padding:9px 13px;border-radius:999px;font:12px ui-monospace,monospace}.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stat-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px 20px}.stat-label{display:block;letter-spacing:.13em;font-size:10px}.stat-card strong{display:block;margin-top:10px;font-size:19px}.tone-blue{color:var(--blue)}.tone-green{color:var(-