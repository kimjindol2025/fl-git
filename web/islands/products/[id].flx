(island CartButton []
  (let [count (atom 0)
        add (fn []
              (let [slot (.getElementById document "cart-island-slot")
                    id (.getAttribute slot "data-product-id")]
                (fetch-post! "/api/cart/add" {"id" id "quantity" 1}
                  (fn [res]
                    (reset! count (get res "count"))))))]
    (h "section" {}
      (h "p" {} (str "장바구니 개수: " @count))
      (h "button" {"id" "cart-add" :on-click add} "담기"))))
