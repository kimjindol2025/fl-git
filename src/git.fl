;; Git 업무 계층 — 모든 명령은 결과와 exit를 보존한다.
(load "./provider-adapter.fl")
(load "./provider-context.fl")
(load "./provider-write.fl")
(load "./provider-gate.fl")

(defn git-shell-quote [value]
  (str "'" (str-replace-all (str value) "'" "'\\''") "'"))

(defn git-run [command]
  (shell-exec-result command))

(defn git-print [result]
  (let [out (or (get result "stdout") "")
        err (or (get result "stderr") "")
        code (or (get result "exit") -1)]
    (if (> (length out) 0) (print out) nil)
    (if (> (length err) 0) (print err) nil)
    (if (= code 0)
      0
      (do (println (str "fl-git: 명령 실패 (exit " code ")")) code))))

(defn git-capture [command]
  (let [result (git-run command)]
    (if (= (or (get result "exit") -1) 0)
      (or (get result "stdout") "")
      (str "[실패 exit " (or (get result "exit") -1) "]\n"
           (or (get result "stderr") "")))))

(defn git-status [] (git-print (git-run "git status --short --branch")))
(defn git-diff [] (git-print (git-run "git diff --stat && git diff --color=always")))
(defn git-log [] (git-print (git-run "git --no-pager log --graph --decorate --oneline -20")))
(defn git-branch [] (git-print (git-run "git branch --all --verbose --no-abbrev")))
(defn git-stash [] (git-print (git-run "git stash list")))
(defn git-fetch [] (git-print (git-run "git fetch --all --prune")))
(defn git-pull [confirmation]
  (if (= confirmation "--yes")
    (git-print (git-run "git pull"))
    (do (println "pull은 원격 변경을 통합합니다. 실행하려면: fl-git pull --yes") 2)))
(defn git-push [confirmation]
  (if (= confirmation "--yes")
    (git-print (git-run "git push"))
    (do (println "push는 원격 저장소를 변경합니다. 실행하려면: fl-git push --yes") 2)))

(defn git-add [paths]
  (let [target (if (> (length paths) 0)
                 (str-join (map git-shell-quote paths) " ")
                 ".")]
    (git-print (git-run (str "git add -- " target)))))

(defn git-unstage [paths]
  (let [target (if (> (length paths) 0)
                 (str-join (map git-shell-quote paths) " ")
                 ".")]
    (git-print (git-run (str "git reset -- " target)))))

(defn git-commit [message]
  (if (= (str-trim (str message)) "")
    (do (println "사용법: fl-git commit \"커밋 메시지\"") 2)
    (git-print (git-run (str "git commit -m " (git-shell-quote message))))))

(defn git-branch-create [name]
  (if (= (str-trim (str name)) "")
    (do (println "사용법: fl-git branch-create <이름>") 2)
    (git-print (git-run (str "git switch -c " (git-shell-quote name))))))

(defn git-branch-delete [name confirmation]
  (if (not (= confirmation "--yes"))
    (do (println "branch 삭제는 로컬 branch를 제거합니다. 실행하려면: fl-git branch-delete <이름> --yes") 2)
    (if (= (str-trim (str name)) "")
      (do (println "사용법: fl-git branch-delete <이름> --yes") 2)
      (git-print (git-run (str "git branch -d " (git-shell-quote name)))))))

(defn git-upstream []
  (let [result (git-run "git rev-parse --abbrev-ref --symbolic-full-name @{upstream}")]
    (if (= (or (get result "exit") -1) 0)
      (str-trim (or (get result "stdout") ""))
      "")))

(defn git-rev-parse [ref]
  (let [result (git-run (str "git rev-parse " (git-shell-quote ref)))]
    (if (= (or (get result "exit") -1) 0)
      (str-trim (or (get result "stdout") ""))
      "")))

(defn git-sync-info []
  (let [upstream (git-upstream)
        local-head (git-rev-parse "HEAD")
        remote-head (if (= upstream "") "" (git-rev-parse upstream))
        counts (git-run "git rev-list --left-right --count HEAD...@{upstream}")
        parts (if (= (or (get counts "exit") -1) 0)
                (regex_split (str-trim (or (get counts "stdout") "")) "[ \\t]+")
                [])
        ahead (if (> (length parts) 0) (str (get parts 0)) "")
        behind (if (> (length parts) 1) (str (get parts 1)) "")]
    (provider-sync-build local-head remote-head upstream ahead behind)))

(defn git-recent-commits []
  (let [result (git-run "git --no-pager log --date=short --pretty=format:'%H~%ad~%an~%s' -12")]
    (if (= (or (get result "exit") -1) 0)
      (provider-recent-commits-from-delimited (or (get result "stdout") ""))
      [])))

(defn git-airc-packet [path source-label]
  (let [raw (str-trim (git-capture (str "if test -f " path "; then cat -- " path "; else printf '{}'; fi")))
        document (if (= raw "") {} (json-parse raw))
        identity (or (get document "identity") {})
        nodes (or (get document "nodes") {})
        hot (or (get document "hot") "")
        hot-node (or (get nodes hot) {})
        handoff (or (get document "handoff") {})
        locks (or (get document "lock") [])]
    {"available" (> (length (or (get identity "what") "")) 0)
     "source" source-label
     "identity" identity
     "hot" hot
     "hot_node" hot-node
     "locks" locks
     "handoff" handoff}))

(defn git-context-card [number key title content]
  {"number" number "key" key "title" title "content" (str (or content ""))})

(defn git-reference-cards [continuity spec remote-info remotes sync]
  [(git-context-card "01" "continuity:identity" "계승 참조 · 정체성"
     (if (= (get continuity "available") true)
       (str (get (get continuity "identity") "what") "\n이유: " (get (get continuity "identity") "why"))
       "PROJECT-CONTINUITY.airc 없음"))
   (git-context-card "02" "continuity:hot" "계승 참조 · Hot"
     (if (= (get continuity "available") true)
       (str "hot=" (get continuity "hot") "\n" (get (get continuity "hot_node") "v"))
       "PROJECT-CONTINUITY.airc 없음"))
   (git-context-card "03" "spec:identity" "프로젝트 SPEC · 정체성"
     (if (= (get spec "available") true)
       (str (get (get spec "identity") "what") "\n이유: " (get (get spec "identity") "why"))
       "SPEC.airc 없음"))
   (git-context-card "04" "spec:hot" "프로젝트 SPEC · Hot"
     (if (= (get spec "available") true)
       (str "hot=" (get spec "hot") "\n" (get (get spec "hot_node") "v"))
       "SPEC.airc 없음"))
   (git-context-card "05" "provider:remotes" "Provider remotes (분리)"
     (str-join
       (map (fn [item]
              (str (get item "provider") " · "
                   (or (get item "full_name") (get item "repository") "—")
                   " · " (or (get item "remote") "")))
            (or remotes []))
       "\n"))
   (git-context-card "06" "repo:sync" "HEAD Sync"
     (str "match=" (get sync "match")
          " local=" (get sync "local_head")
          " remote=" (get sync "remote_head")
          " upstream=" (get sync "upstream")))
   (git-context-card "07" "remote:status" "Remote Provider"
     (str "provider=" (get remote-info "provider")
          " host=" (get remote-info "host")
          " repository=" (provider-full-name remote-info)))])

(defn git-ai-context-packet []
  (let [root (str-trim (git-capture "git rev-parse --show-toplevel"))
        branch (str-trim (git-capture "git branch --show-current"))
        remote (str-trim (git-capture "git remote -v"))
        upstream (git-upstream)
        remotes (provider-models-from-remote-v remote branch upstream)
        remote-info (provider-primary-model remote branch upstream)
        status (str-trim (git-capture "git status --short --branch"))
        sync (git-sync-info)
        recent-commits (git-recent-commits)
        recent-log (str-trim (git-capture "git --no-pager log -5 --oneline"))
        continuity (git-airc-packet "PROJECT-CONTINUITY.airc" "PROJECT-CONTINUITY.airc")
        spec (git-airc-packet "SPEC.airc" "SPEC.airc")
        cards (git-reference-cards continuity spec remote-info remotes sync)
        fields (provider-context-fields remote-info remotes sync recent-commits)]
    (obj-merge {"root" root
                "branch" branch
                "remote" remote
                "status" status
                "recent_log" recent-log
                "continuity" continuity
                "spec" spec
                "cards" cards
                "available_keys" (map (fn [card] (get card "key")) cards)}
               fields)))

(defn git-context []
  (let [packet (git-ai-context-packet)
        primary (get packet "remote_info")
        sync (get packet "sync")
        cards (or (get packet "cards") [])]
    (println "# fl-git 프로젝트 문맥")
    (println "")
    (println (str "- 브랜치: " (get packet "branch")))
    (println (str "- 저장소 루트: " (get packet "root")))
    (println (str "- provider: " (get primary "provider")))
    (println (str "- host: " (get primary "host")))
    (println (str "- repository: " (provider-full-name primary)))
    (println (str "- upstream: " (get sync "upstream")))
    (println (str "- local_head: " (get sync "local_head")))
    (println (str "- remote_head: " (get sync "remote_head")))
    (println (str "- head_match: " (get sync "match")))
    (println (str "- spec.hot: " (get (get packet "spec") "hot")))
    (println (str "- continuity.hot: " (get (get packet "continuity") "hot")))
    (println "")
    (println "## 참조 카드")
    (doall (map (fn [card]
                  (do (println (str "### " (get card "number") " · " (get card "title") " [" (get card "key") "]"))
                      (println (get card "content"))
                      (println "")))
                cards))
    (println "## 원격 (provider 분리)")
    (print (get packet "remote"))
    (println "## 상태")
    (print (get packet "status"))
    (println "## 최근 커밋")
    (print (get packet "recent_log"))
    0))

(defn git-context-json []
  (println (json-stringify (git-ai-context-packet)))
  0)

(defn git-provider-model []
  (let [branch (str-trim (git-capture "git branch --show-current"))
        remote (str-trim (git-capture "git remote -v"))
        upstream (git-upstream)
        remotes (provider-models-from-remote-v remote branch upstream)
        remote-info (provider-primary-model remote branch upstream)]
    (println (json-stringify {"remote_info" remote-info "remotes" remotes}))
    0))

(defn git-provider-status [provider]
  (let [kind (str-to-lower (str-trim (str provider)))
        payload (if (= kind "")
                  (provider-auth-status-all)
                  {"ok" true "providers" [(provider-auth-probe kind)]})
        blocked (filter (fn [item] (= (get item "code") "AUTH_BLOCKED"))
                        (or (get payload "providers") []))
        unknown (filter (fn [item] (= (get item "code") "UNKNOWN"))
                        (or (get payload "providers") []))]
    (println (json-stringify payload))
    (cond
      (> (length unknown) 0) (do (println "PROVIDER_STATUS=UNKNOWN") 2)
      (> (length blocked) 0) (do (println "PROVIDER_STATUS=AUTH_BLOCKED") 2)
      true (do (println "PROVIDER_STATUS=PASS") 0))))

(defn git-provider-repos [provider]
  (let [kind (str-to-lower (str-trim (str provider)))]
    (if (= kind "")
      (do (println "사용법: fl-git provider repos <github|forgejo|gitlab>")
          (println "PROVIDER_REPOS=UNKNOWN")
          2)
      (let [payload (provider-repos-list kind)
            code (or (get payload "code") "UNKNOWN")]
        (println (json-stringify payload))
        (cond
          (= code "PROVIDER_REPOS_OK") (do (println "PROVIDER_REPOS=PASS") 0)
          (= code "AUTH_BLOCKED") (do (println "PROVIDER_REPOS=AUTH_BLOCKED") 2)
          true (do (println "PROVIDER_REPOS=UNKNOWN") 2))))))

(defn git-provider-args-has-yes? [items]
  (> (length (filter (fn [item] (= (str item) "--yes")) (or items []))) 0))

(defn git-provider-args-without-yes [items]
  (filter (fn [item] (not (= (str item) "--yes"))) (or items [])))

(defn git-provider-current-model []
  (let [branch (str-trim (git-capture "git branch --show-current"))
        remote (str-trim (git-capture "git remote -v"))
        upstream (git-upstream)]
    (provider-primary-model remote branch upstream)))

(defn git-provider-print-gate [gate]
  (println (json-stringify gate))
  (let [display (or (get gate "display") {})]
    (println (str "provider: " (or (get display "provider") "")))
    (println (str "repository: " (or (get display "repository") "")))
    (println (str "branch: " (or (get display "branch") "")))
    (if (= (get gate "ok") true)
      nil
      (println (or (get gate "error") "")))))

(defn git-provider-write-op [op expected confirmed]
  (let [model (git-provider-current-model)
        target (provider-write-target-from-model model op)
        gate (provider-write-gate target expected confirmed)]
    (git-provider-print-gate gate)
    (if (not (= (get gate "ok") true))
      (do (println (str "REMOTE_WRITE=" (get gate "code"))) 2)
      (let [result (cond
                     (= op "fetch") (git-run "git fetch --all --prune")
                     (= op "pull") (git-run "git pull")
                     (= op "push") (git-run "git push")
                     true {"exit" 1 "stderr" (str "unknown write op: " op)})
            code (or (get result "exit") -1)
            payload (provider-write-result gate (= code 0)
                                           (if (= code 0) (str op " 완료") (str op " 실패"))
                                           (or (get result "stderr") (get result "stdout") ""))]
        (println (json-stringify payload))
        (git-print result)
        (if (= code 0)
          (do (println "REMOTE_WRITE=PASS") 0)
          (do (println "REMOTE_WRITE=FAIL") code))))))

(defn git-provider-connect [url expected confirmed]
  (let [ref (str-trim (str url))
        branch (str-trim (git-capture "git branch --show-current"))
        target (provider-write-target-from-url ref branch "connect")
        gate (provider-write-gate target expected confirmed)]
    (git-provider-print-gate gate)
    (if (= ref "")
      (do (println "사용법: fl-git provider connect <url> [github|forgejo|gitlab] [--yes]")
          (println "REMOTE_WRITE=UNKNOWN")
          2)
      (if (not (= (get gate "ok") true))
        (do (println (str "REMOTE_WRITE=" (get gate "code"))) 2)
        (let [origin (git-run "git remote get-url origin")]
          (if (= (or (get origin "exit") -1) 0)
            (do (println (json-stringify (provider-write-result gate false
                                          "이미 origin이 연결되어 있습니다."
                                          (str-trim (or (get origin "stdout") "")))))
                (println "REMOTE_WRITE=FAIL")
                2)
            (let [linked (git-run (str "git remote add origin " (git-shell-quote ref)))
                  code (or (get linked "exit") -1)
                  payload (provider-write-result gate (= code 0)
                                                 (if (= code 0)
                                                   (str "Remote 연결 완료: " (get target "provider") "; Push는 실행하지 않았습니다.")
                                                   "Remote 연결 실패")
                                                 (or (get linked "stderr") (get linked "stdout") ""))]
              (println (json-stringify payload))
              (git-print linked)
              (if (= code 0)
                (do (println "REMOTE_WRITE=PASS") 0)
                (do (println "REMOTE_WRITE=FAIL") code)))))))))

(defn git-provider-gate []
  (let [report (provider-gate-report)]
    (provider-gate-print report)
    (if (provider-gate-ok? report)
      0
      2)))

(defn git-provider [provider-args]
  (let [action (or (get provider-args 0) "help")
        rest-args (rest (or provider-args []))
        yes? (git-provider-args-has-yes? rest-args)
        clean (git-provider-args-without-yes rest-args)
        argument (or (get clean 0) "")]
    (cond
      (= action "model") (git-provider-model)
      (= action "status") (git-provider-status argument)
      (= action "repos") (git-provider-repos argument)
      (= action "gate") (git-provider-gate)
      (= action "fetch") (git-provider-write-op "fetch" argument yes?)
      (= action "pull") (git-provider-write-op "pull" argument yes?)
      (= action "push") (git-provider-write-op "push" argument yes?)
      (= action "connect") (git-provider-connect argument (or (get clean 1) "") yes?)
      (= action "help") (do (println "사용법:")
                            (println "  fl-git provider model")
                            (println "  fl-git provider status [github|forgejo|gitlab]")
                            (println "  fl-git provider repos <github|forgejo|gitlab>")
                            (println "  fl-git provider gate")
                            (println "  fl-git provider fetch|pull|push [github|forgejo|gitlab] [--yes]")
                            (println "  fl-git provider connect <url> [github|forgejo|gitlab] [--yes]")
                            (println "쓰기 작업은 provider → repository → branch 표시 후 --yes 확인이 필요합니다.")
                            (println "gate는 네트워크 없이 fixture PASS/DENY 코드를 출력한다.")
                            0)
      true (do (println "사용법: fl-git provider <model|status|repos|gate|fetch|pull|push|connect> …")
               2))))

(defn git-github [action argument]
  (cond
    (= action "repo") (git-print (git-run "gh repo view"))
    (= action "pr") (git-print (git-run "gh pr list"))
    (= action "status") (git-print (git-run "gh auth status"))
    (= action "pr-create")
      (if (= (str-trim (str argument)) "")
        (do (println "사용법: fl-git github pr-create \"제목\"") 2)
        (git-print (git-run (str "gh pr create --title " (git-shell-quote argument)))))
  true (do (println "사용법: fl-git github <repo|pr|status|pr-create> [제목]") 2)))
